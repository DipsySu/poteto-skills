+++ b/tests/test_persistence_boundary.py
@@ -0,0 +1,21 @@
+"""Persistence has one owner, todo/store.py. Fails on the direct writes of 570c1e9 and dbd4400."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+from todo.store import Store
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+class PersistenceBoundaryTests(unittest.TestCase):
+    def test_store_exposes_no_file_handle(self):
+        with tempfile.TemporaryDirectory() as data:
+            public = sorted(name for name in vars(Store(data)) if not name.startswith("_"))
+        self.assertEqual(public, [], "Store owns its file: persist through Store.add or Store.transition, never a path")
+
+    def test_persistence_lint_passes(self):
+        # scripts/lint.sh caught both past mistakes but nothing ran it; the default test command does now.
+        result = subprocess.run([str(ROOT / "scripts" / "lint.sh")], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
