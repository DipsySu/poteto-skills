#!/usr/bin/env python3
"""Normalize review feedback into one list where every item names its source.

Inputs:
  --repo REPO           git history: fix commits, reverts, and the commits they revert
  --pr-comments JSON    PR review comments in `gh api` shape (body/path/line/user/html_url);
                        concatenated pages from `gh api --paginate` work too. Repeatable.
  --chat MD             chat or meeting notes in markdown; each bullet or paragraph is one item. Repeatable.

Output (--out, default stdout): {"version", "repo", "generated_at", "inputs", "counts", "items": [...]}
Each item: {id, source (commit|review|chat|code-comment), ref (sha, URL, or file:line), text, paths, line,
author, date, url, kind (commits: fix|revert|reverted), diff_added/diff_removed (commits)}.

Uses the item readers from the sibling `correct` skill (correct/scripts/mine_mistakes.py),
so /correct and /feedback-to-architecture read evidence the same way.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import sys
from collections import Counter
from pathlib import Path


def load_mine_mistakes():
    sys.dont_write_bytecode = True  # importing the correct skill must not leave __pycache__ behind
    here = Path(__file__)
    for base in (here.resolve().parent, here.parent):
        cand = base.parent.parent / "correct" / "scripts"
        if (cand / "mine_mistakes.py").is_file():
            sys.path.insert(0, str(cand))
            import mine_mistakes  # noqa: PLC0415
            return mine_mistakes
    sys.exit("collect_feedback: needs the `correct` skill installed next to this one "
             "(skills/correct/scripts/mine_mistakes.py). Run install.sh from poteto-skills.")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="collect_feedback.py",
        description="Normalize PR review comments, commit-history signals, and chat notes into one feedback.json "
                    "where every item has a source and a ref.",
        epilog="examples:\n"
               "  gh api repos/OWNER/REPO/pulls/comments --paginate > review-comments.json   # read-only\n"
               "  collect_feedback.py --repo . --pr-comments review-comments.json --chat chat-feedback.md --out feedback.json\n"
               "  collect_feedback.py --repo . --since 2026-07-01 --out feedback.json\n"
               "next: plan.py feedback.json --out-dir refactor/",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("--repo", required=True, type=Path, help="repository (git history is read from here)")
    ap.add_argument("--pr-comments", action="append", type=Path, default=[], metavar="JSON",
                    help="PR review comments, gh api JSON shape (repeatable)")
    ap.add_argument("--chat", action="append", type=Path, default=[], metavar="MD",
                    help="chat/meeting notes in markdown (repeatable)")
    ap.add_argument("--since", help="only commits after this date (YYYY-MM-DD or git --since syntax)")
    ap.add_argument("--max-commits", type=int, default=2000, help="newest N commits to read (default 2000)")
    ap.add_argument("--no-git", action="store_true", help="skip commit history")
    ap.add_argument("--code-comments", action="store_true", help="also include HACK/WORKAROUND/FIXME/XXX comments")
    ap.add_argument("--out", type=Path, help="write feedback.json here (default: stdout)")
    args = ap.parse_args(argv)

    mm = load_mine_mistakes()
    repo = args.repo.resolve()
    if not repo.is_dir():
        print(f"collect_feedback: {repo} is not a directory", file=sys.stderr)
        return 2
    items: list[dict] = []
    git_used = False
    if not args.no_git:
        if mm.is_git_repo(repo):
            items += mm.git_items(repo, args.since, args.max_commits)
            git_used = True
            if args.code_comments:
                items += mm.code_comment_items(repo)
        else:
            print(f"collect_feedback: {repo} is not a git repo; skipping commit history", file=sys.stderr)
    for f in args.pr_comments:
        if not f.is_file():
            print(f"collect_feedback: --pr-comments {f} not found", file=sys.stderr)
            return 2
        got = mm.load_feedback(f, source="review")
        for it in got:
            if it["source"] == "chat":  # a markdown file passed as review comments
                it["source"] = "review"
        items += got
    for f in args.chat:
        if not f.is_file():
            print(f"collect_feedback: --chat {f} not found", file=sys.stderr)
            return 2
        items += mm.markdown_items(f.read_text(encoding="utf-8", errors="replace"), f.name, "chat")

    seen, out_items, dropped = set(), [], 0
    for it in items:
        if not it.get("source") or not it.get("ref"):
            dropped += 1
            continue
        if it["id"] in seen:
            continue
        seen.add(it["id"])
        out_items.append(it)
    if dropped:
        print(f"collect_feedback: dropped {dropped} item(s) without a source ref", file=sys.stderr)

    doc = {
        "version": 1,
        "tool": "collect_feedback",
        "repo": str(repo),
        "generated_at": dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat(),
        "inputs": {"git": git_used, "since": args.since, "pr_comments": [str(p) for p in args.pr_comments],
                   "chat": [str(p) for p in args.chat]},
        "counts": dict(Counter(it["source"] for it in out_items)),
        "items": out_items,
    }
    text = json.dumps(doc, indent=2, default=str) + "\n"
    if args.out:
        args.out.parent.mkdir(parents=True, exist_ok=True)
        args.out.write_text(text, encoding="utf-8")
        counts = ", ".join(f"{v} {k}" for k, v in sorted(doc["counts"].items())) or "no items"
        print(f"collect_feedback: wrote {args.out} ({counts})", file=sys.stderr)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Turn feedback.json into REFACTOR_PLAN.md and patlint rules.

  plan.py feedback.json --out-dir DIR [--min-count 2] [--threshold 0.3] [--no-prove]

Clusters feedback items into themes (the same clustering /correct uses), keeps
themes seen at least --min-count times, and for each theme writes: evidence,
the pyramid level chosen (architecture > types > lint > test > docs) and why
not higher, a draft target design, steps, and proof commands.

For themes where the evidence names a bad pattern and the fix (from review
wording like "don't X, use Y" and from fix-commit diffs: removed lines = bad,
added lines = good), it writes a patlint rule to DIR/lint-rules.json. Unless
--no-prove, it replays every rule against the repo's own history: a rule is
`proven` when it reports more hits at the mistake revision than at the fixed
revision (fix commit: sha^ vs sha; reverted commit: sha vs sha^).

Outputs: DIR/REFACTOR_PLAN.md, DIR/lint-rules.json, DIR/plan.json.
Needs the sibling `correct` skill (mine_mistakes.py, patlint.py).
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import shlex
import subprocess
import sys
from collections import Counter
from pathlib import Path


def correct_scripts() -> Path:
    here = Path(__file__)
    for base in (here.resolve().parent, here.parent):
        cand = base.parent.parent / "correct" / "scripts"
        if (cand / "mine_mistakes.py").is_file() and (cand / "patlint.py").is_file():
            return cand
    sys.exit("plan: needs the `correct` skill installed next to this one "
             "(skills/correct/scripts/{mine_mistakes,patlint}.py). Run install.sh from poteto-skills.")


sys.dont_write_bytecode = True  # importing the correct skill must not leave __pycache__ behind
CORRECT = correct_scripts()
sys.path.insert(0, str(CORRECT))
import mine_mistakes as mm  # noqa: E402
import patlint  # noqa: E402

TOKEN = r"`?([A-Za-z_][\w./-]*(?:\(\))?)`?"
CODE_TOKEN = re.compile(r"^(?:[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)+(?:\(\))?|[A-Za-z_]\w*\(\)|[\w-]+\.(?:json|ya?ml|toml|csv|db|sqlite|txt|ini|cfg))$")
DATAFILE = re.compile(r"\.(json|ya?ml|toml|csv|db|sqlite|txt|ini|cfg)$", re.I)
SOURCE_EXT = re.compile(r"\.(py|js|jsx|ts|tsx|mjs|cjs|go|rs|rb|java|kt|swift|cs|php|c|cc|cpp|h)$")
GOOD_PATS = [
    re.compile(r"\b(?:use|call|via|through|prefer|switch to|route (?:it )?through|go(?:es)? through|must use|"
               r"should use|always use)\s+(?:the\s+|a\s+)?" + TOKEN, re.I),
    re.compile(TOKEN + r"\s+instead\b(?!\s+of)", re.I),
]
BAD_PATS = [
    re.compile(r"\b(?:don'?t|do not|never|avoid|stop|no more|shouldn'?t|should not)\s+(?:use\s+|call\s+|using\s+|"
               r"calling\s+)?(?:the\s+)?" + TOKEN, re.I),
    re.compile(TOKEN + r"\s+(?:file\s+)?(?:directly|by hand)\b", re.I),
]
INSTEAD_OF = re.compile(TOKEN + r"\s+instead of\s+(?:using\s+|calling\s+)?" + TOKEN, re.I)
USE_BEFORE = re.compile(r"\b(?:use|call|prefer|switch to)\s+(?:the\s+)?$", re.I)

ARCH_SIGNALS = re.compile(
    r"\b(directly|bypass\w*|instead of|go(?:es)? through|route[sd]? through|only (?:place|module|way|writer)|"
    r"single source|source of truth|owner\w*|duplicat\w*|copy[- ]?past\w*|two ways|old way|legacy|deprecated|"
    r"internal|private|hand[- ]?sync\w*|by hand)\b", re.I)
TYPE_SIGNALS = re.compile(
    r"\b(status|state|transition\w*|enum|none|null|nil|optional|invalid|illegal|typo|string literal|magic string|"
    r"stringly|types?|typed|schema|validat\w*|unrepresentable)\b", re.I)
TEST_SIGNALS = re.compile(
    r"\b(regression|crash\w*|broke|broken|returns?|edge case|off[- ]by[- ]one|500|exception|traceback|flaky|race|"
    r"wrong (?:result|output|value))\b", re.I)
TEST_GLOBS = ["**/tests/**", "**/test/**", "**/test_*.py", "**/*_test.py", "**/*_test.go", "**/*.test.*", "**/*.spec.*"]


def norm(tok: str) -> str:
    return tok.strip().rstrip(".,;:").removesuffix("()").lower()


def clean(tok: str) -> str:
    return tok.strip().rstrip(".,;:")


def vote_tokens(items: list[dict]) -> tuple[list[str], list[str], dict]:
    """Return (bad, good, detail) code tokens for a theme, by majority vote."""
    good, bad = Counter(), Counter()
    surface: dict[str, Counter] = {}

    def add(counter: Counter, tok: str, w: int) -> None:
        tok = clean(tok)
        if not CODE_TOKEN.match(tok):
            return
        key = norm(tok)
        counter[key] += w
        surface.setdefault(key, Counter())[tok] += 1

    texts = [it.get("text") or "" for it in items]
    for text in texts:
        for pat in GOOD_PATS:
            for m in pat.finditer(text):
                add(good, m.group(1), 1)
        for pat in BAD_PATS:
            for m in pat.finditer(text):
                add(bad, m.group(1), 1)
        for m in INSTEAD_OF.finditer(text):
            x, y = m.group(1), m.group(2)
            if USE_BEFORE.search(text[: m.start()]):
                add(good, x, 1)
                add(bad, y, 1)
            else:
                add(bad, x, 1)
                add(good, y, 1)
    mentioned = " ".join(texts).lower()
    diff_seen = Counter(norm(t) for it in items for t in set(it.get("diff_ids") or []))
    for it in items:
        if it.get("source") != "commit":
            continue
        added = {clean(t) for t in it.get("diff_added") or []}
        removed = {clean(t) for t in it.get("diff_removed") or []}
        only_added, only_removed = added - removed, removed - added
        kind = it.get("kind")
        bad_side, good_side = (only_added, only_removed) if kind == "reverted" else (only_removed, only_added)
        for t in bad_side:
            if norm(t) in mentioned or diff_seen[norm(t)] >= 2:
                add(bad, t, 2)
        for t in good_side:
            if norm(t) in mentioned or diff_seen[norm(t)] >= 2:
                add(good, t, 2)
    keys = set(good) | set(bad)
    margin = {k: bad[k] - good[k] for k in keys}
    bad_toks = sorted((k for k in keys if margin[k] > 0), key=lambda k: (-margin[k], k))
    good_toks = sorted((k for k in keys if margin[k] < 0), key=lambda k: (margin[k], k))

    def best(k: str) -> str:
        return surface[k].most_common(1)[0][0]

    detail = {best(k): {"bad": bad[k], "good": good[k]} for k in sorted(keys)}
    return [best(k) for k in bad_toks], [best(k) for k in good_toks], detail


def choose_level(items: list[dict], bad: list[str], good: list[str]) -> tuple[str, str, str]:
    """(level, why, why_not_higher)."""
    text = " ".join(it.get("text") or "" for it in items)
    arch = len(ARCH_SIGNALS.findall(text))
    typ = len(TYPE_SIGNALS.findall(text))
    test = len(TEST_SIGNALS.findall(text))
    if good and arch >= 2:
        return ("architecture",
                f"the evidence describes bypassing an owner ({arch} owner/bypass signals) and names the supported way `{good[0]}`",
                "already the highest level; keep the lint as a ratchet while call sites migrate")
    if typ >= 2:
        return ("types",
                f"the evidence is about values or states that should not be writable ({typ} state/type signals)",
                "no single owner or bypass is named, so moving code alone would not stop the bad state being constructed")
    if bad and good:
        return ("lint",
                f"a concrete bad pattern (`{bad[0]}`) and its fix (`{good[0]}`) are named, but no ownership or state change is implied",
                "no owner/bypass or state signal in the evidence; a lint whose message names the fix is the cheapest check that fails")
    if test or bad:
        return ("test",
                "the evidence describes behavior that broke, with no code pattern a regex can catch",
                "no owner, type, or lintable pattern is named; a behavior test through the public entry point is the highest check that fits")
    return ("docs",
            "no code token, owner, or state signal: this reads as a judgment call",
            "nothing in the evidence can be checked mechanically yet; write one AGENTS.md line with a failure example and re-run /correct when it repeats")


def slug(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", s.lower().removesuffix("()")).strip("-")[:40] or "rule"


def owner_module(good: str) -> str | None:
    core = good.removesuffix("()")
    if DATAFILE.search(core):
        return None
    if "." in core:
        return core.split(".")[0]
    return None


def derive_rule(n: int, title: str, items: list[dict], bad: list[str], good: list[str]):
    bad = [b for b in bad if b.removesuffix("()") not in {g.removesuffix("()") for g in good}][:3]
    if not bad:
        return None, "no bad code pattern named in the evidence"
    if not good:
        return None, "the evidence never names the fix; choose the owner API (/architect) before adding a lint"
    paths = [p for it in items for p in (it.get("paths") or [])]
    exts = Counter(m.group(1) for p in paths for m in [SOURCE_EXT.search(p)] if m)
    include = [f"**/*.{e}" for e, _ in exts.most_common(2)] or ["**/*"]
    exclude = list(TEST_GLOBS)
    owner = owner_module(good[0])
    owner_globs = [f"**/{owner}.{e}" for e, _ in exts.most_common(2)] if owner else []
    exclude = owner_globs + exclude
    parts = ["\\b" + re.escape(b.removesuffix("()")) + "\\b" for b in bad]
    regex = parts[0] if len(parts) == 1 else "(?:" + "|".join(parts) + ")"
    rid = f"no-{slug(bad[0])}" + (f"-outside-{slug(owner)}" if owner else "")
    bad_txt = ", ".join(f"`{b}`" for b in bad)
    owner_txt = f" ({owner_globs[0].removeprefix('**/')} owns this)" if owner_globs else ""
    message = f"Use `{good[0]}` instead of {bad_txt}{owner_txt}. Theme T{n}: {title}."
    rule = {"id": rid, "regex": regex, "include": include, "exclude": exclude, "message": message}
    return rule, None


def mistake_revs(it: dict) -> tuple[str, str] | None:
    sha, kind = (it.get("ref") or "")[:12], it.get("kind")
    if it.get("source") != "commit" or not sha:
        return None
    if kind == "reverted":
        return sha, sha + "^"
    return sha + "^", sha  # fix and revert commits: the mistake is in the parent


def count_hits(patlint_py: Path, rules_file: Path, repo: Path, rule_id: str, rev: str | None, paths: list[str]):
    cmd = [str(patlint_py), "--rules", str(rules_file), "--root", str(repo)]
    if rev:
        cmd += ["--rev", rev]
    cmd += paths
    res = subprocess.run([sys.executable, *cmd, "--json"], capture_output=True, text=True, cwd=str(repo))
    shown = shlex.join(["python3", *cmd])
    if res.returncode not in (0, 1):
        return None, shown, res.stderr.strip().splitlines()[-1:] or ["error"]
    data = json.loads(res.stdout)
    hits = [v for v in data["violations"] + data["expired"] + data["invalid_exceptions"] if v["rule"] == rule_id]
    return len(hits), shown, [f"{v['path']}:{v['line']}" for v in hits[:5]]


def prove(rule: dict, items: list[dict], rules_file: Path, repo: Path) -> dict:
    patlint_py = CORRECT / "patlint.py"
    inc = [patlint.glob_to_regex(g) for g in rule["include"]]
    proof = {"replays": [], "proven": False, "head_hits": None, "head_cmd": None}
    for it in items:
        revs = mistake_revs(it)
        if not revs:
            continue
        paths = [p for p in it.get("paths") or [] if any(g.match(p) for g in inc)]
        if not paths:
            continue
        bad_rev, good_rev = revs
        before, cmd, where = count_hits(patlint_py, rules_file, repo, rule["id"], bad_rev, paths)
        after, _, _ = count_hits(patlint_py, rules_file, repo, rule["id"], good_rev, paths)
        ok = before is not None and before > (after or 0)
        proof["replays"].append({"commit": it["ref"][:10], "kind": it.get("kind"), "mistake_rev": bad_rev,
                                 "fixed_rev": good_rev, "hits_at_mistake": before, "hits_at_fixed": after,
                                 "where": where, "cmd": cmd, "distinguishes": ok})
        proof["proven"] = proof["proven"] or ok
    n, cmd, where = count_hits(patlint_py, rules_file, repo, rule["id"], None, [str(repo)])
    proof["head_hits"], proof["head_cmd"], proof["head_where"] = n, cmd, where
    return proof


TARGETS = {
    "architecture": "Make `{owner}` the single owner: callers use `{good}`, nothing else touches what {bad} touched. "
                    "Hide or delete the second path (move the internals behind `{owner}`, delete copies an agent could imitate), "
                    "so a change that looks right from one file is right for the repo. Keep `{rule}` as a ratchet until no call site is left.",
    "types": "Model the values in this theme ({sig}) as a type the bad state cannot be written in: an enum or newtype plus "
             "one transition function owned by one module, validated once at the boundary. Callers stop passing raw strings.",
    "lint": "Add patlint rule `{rule}` whose message names `{good}`. Adopt a ratchet baseline if the pattern is already common.",
    "test": "Write one behavior test through the public entry point that reproduces the past failure ({refs}). "
            "It must fail on the mistake revision and pass on the fix.",
    "docs": "Judgment call: add one line to AGENTS.md with a concrete failure example from {refs}. Re-run /correct when it repeats.",
}
STEPS = {
    "architecture": ["Run /architect on the owner boundary: sketch the owner API ({good}) and the module layout, two candidates.",
                     "Route every call site through the owner; list them with the lint: `{lint_cmd}`.",
                     "Delete the old path and any helper an agent could copy.",
                     "Keep the lint with a baseline while migrating; drop the AGENTS.md rule once the lint makes the mistake unmergeable."],
    "types": ["Sketch the type (enum/newtype + transition table) with /architect.",
              "Convert the boundary (CLI/HTTP/storage parsing) to construct the type once; internal code takes the type.",
              "Make illegal transitions raise in one function; delete scattered string comparisons.",
              "Add a test that the illegal transition from the evidence is rejected."],
    "lint": ["Review the generated rule (regex, include/exclude) against the evidence.",
             "Run it on HEAD: `{lint_cmd}`; adopt a baseline if hits exist: add `--baseline .patlint-baseline.json --update-baseline`.",
             "Wire the same command into CI and the AGENTS.md rule table (`rule_table.py add`)."],
    "test": ["Write the failing test first against the mistake revision.",
             "Fix, then keep the test in the default test command."],
    "docs": ["Add the rule with an example to AGENTS.md (`rule_table.py add AGENTS.md --rule ... --enforced-by docs`).",
             "Expect `rule_table.py check` to flag it until something enforces it."],
}


def evidence_line(it: dict) -> str:
    return mm.describe_item(it)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="plan.py",
        description="Cluster feedback.json into themes and write REFACTOR_PLAN.md (evidence, pyramid level, target "
                    "design, steps, proof) plus lint-rules.json (patlint format) for lintable themes.",
        epilog="examples:\n"
               "  plan.py feedback.json --out-dir refactor/\n"
               "  plan.py feedback.json --out-dir refactor/ --no-prove --min-count 3\n"
               "then prove a rule by hand on a past mistake:\n"
               "  python3 <skills>/correct/scripts/patlint.py --rules refactor/lint-rules.json --rev SHA^ path/to/file.py",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("feedback", type=Path, help="feedback.json from collect_feedback.py")
    ap.add_argument("--out-dir", required=True, type=Path, help="where to write REFACTOR_PLAN.md, lint-rules.json, plan.json")
    ap.add_argument("--min-count", type=int, default=2, help="minimum occurrences for a theme (default 2)")
    ap.add_argument("--threshold", type=float, default=0.3, help="cosine similarity to join a theme (default 0.3)")
    ap.add_argument("--repo", type=Path, help="repo for proofs (default: the repo recorded in feedback.json)")
    ap.add_argument("--no-prove", action="store_true", help="skip replaying rules against git history")
    args = ap.parse_args(argv)

    if not args.feedback.is_file():
        print(f"plan: {args.feedback} not found; make it with collect_feedback.py", file=sys.stderr)
        return 2
    doc = json.loads(args.feedback.read_text(encoding="utf-8"))
    items = mm.review_items_from_json(json.dumps(doc), args.feedback.name)
    repo = (args.repo or Path(doc.get("repo") or ".")).resolve()
    can_prove = not args.no_prove and mm.is_git_repo(repo)
    out = args.out_dir
    out.mkdir(parents=True, exist_ok=True)
    rules_file = out / "lint-rules.json"

    classes, unclassified = mm.cluster_items(items, args.threshold, args.min_count)
    themes, rules = [], []
    for n, c in enumerate(classes, 1):
        members = c["evidence"]
        title = " / ".join(c["signature"][:3]) or f"theme {n}"
        bad, good, votes = vote_tokens(members)
        level, why, why_not = choose_level(members, bad, good)
        rule, no_rule = derive_rule(n, title, members, bad, good)
        if rule:
            used = {r["id"] for r in rules}
            if rule["id"] in used:
                rule["id"] = f"{rule['id']}-t{n}"
            rules.append(rule)
        refs = ", ".join(m["ref"][:10] if m["source"] == "commit" else m["ref"] for m in members[:3])
        themes.append({"id": f"T{n}", "title": title, "count": c["count"], "sources": c["sources"],
                       "signature": c["signature"], "level": level, "why": why, "why_not_higher": why_not,
                       "bad": bad, "good": good, "votes": votes, "rule": rule, "no_rule_reason": no_rule,
                       "refs": refs, "evidence": members, "proof": None})

    rules_doc = {"rules": rules, "generated_by": "feedback-to-architecture/scripts/plan.py",
                 "source": str(args.feedback)}
    rules_file.write_text(json.dumps(rules_doc, indent=2) + "\n", encoding="utf-8")
    if rules:
        try:
            patlint.load_rules(rules_file)
        except patlint.RulesError as e:
            print(f"plan: generated rules failed patlint validation:\n{e}", file=sys.stderr)
            return 1
        if can_prove:
            for t in themes:
                if t["rule"]:
                    t["proof"] = prove(t["rule"], t["evidence"], rules_file, repo)

    patlint_cmd = f"python3 {CORRECT / 'patlint.py'} --rules {rules_file} --root {repo} {repo}"
    lines = [
        "# Refactor plan: make repeated feedback impossible",
        "",
        f"Generated {dt.date.today().isoformat()} by `plan.py` from `{args.feedback}` "
        f"({len(items)} items: " + ", ".join(f"{v} {k}" for k, v in sorted(Counter(i['source'] for i in items).items())) + ")."
        f" Repo: `{repo}`.",
        "",
        "Each theme is a cluster of feedback seen at least "
        f"{args.min_count} times. Its level is the highest that can work: architecture > types > lint whose message "
        "names the fix > test > docs. Target designs are drafts; refine them with /architect before implementing.",
        "",
        "## Summary",
        "",
        "| Theme | Items | Level | Lint rule | Proof on history |",
        "|---|---|---|---|---|",
    ]
    for t in themes:
        proof = "-"
        if t["proof"]:
            reps = t["proof"]["replays"]
            proof = (("proven on " + ", ".join(r["mistake_rev"] for r in reps if r["distinguishes"]))
                     if t["proof"]["proven"] else ("not proven" if reps else "no commit to replay"))
        rule_cell = f"`{t['rule']['id']}`" if t["rule"] else "none"
        lines.append(f"| {t['id']} {t['title']} | {t['count']} | {t['level']} | {rule_cell} | {proof} |")
    if not themes:
        lines.append(f"| - | - | - | - | no theme reached {args.min_count} occurrences |")
    for t in themes:
        r = t["rule"]
        fill = {"owner": (owner_module(t["good"][0]) if t["good"] else None) or (t["good"][0] if t["good"] else "the owner module"),
                "good": t["good"][0] if t["good"] else "the supported API",
                "bad": ", ".join(f"`{b}`" for b in t["bad"][:3]) or "the bypass",
                "rule": r["id"] if r else "a lint", "sig": ", ".join(t["signature"][:5]), "refs": t["refs"],
                "lint_cmd": patlint_cmd}
        lines += ["", f"## {t['id']}: {t['title']}", "",
                  f"Occurrences: {t['count']} ({', '.join(f'{k}×{v}' for k, v in sorted(t['sources'].items()))}). "
                  f"Signature: {', '.join(t['signature'][:6])}.", "", "### Evidence", ""]
        lines += [f"- {evidence_line(m)}" for m in t["evidence"]]
        lines += ["", "### Level", "",
                  f"**{t['level']}**: {t['why']}.", f"Why not higher: {t['why_not_higher']}."]
        if t["bad"] or t["good"]:
            lines.append(f"Named in evidence: bad {', '.join(f'`{b}`' for b in t['bad'][:3]) or '-'}; "
                         f"fix {', '.join(f'`{g}`' for g in t['good'][:3]) or '-'}.")
        lines += ["", "### Target design (draft)", "", TARGETS[t["level"]].format(**fill), "", "### Steps", ""]
        lines += [f"{i}. {s.format(**fill)}" for i, s in enumerate(STEPS[t["level"]], 1)]
        lines += ["", "### Proof", ""]
        if r:
            lines.append(f"Rule `{r['id']}` in `{rules_file}`: regex `{r['regex']}`, include {r['include']}, "
                         f"message: {r['message']}")
            p = t["proof"]
            if p:
                for rp in p["replays"]:
                    mark = "fires on the mistake and not on the fix" if rp["distinguishes"] else "does NOT distinguish mistake from fix"
                    lines.append(f"- {rp['kind']} {rp['commit']}: {rp['hits_at_mistake']} hit(s) at `{rp['mistake_rev']}`, "
                                 f"{rp['hits_at_fixed']} at `{rp['fixed_rev']}`: {mark}. Rerun: `{rp['cmd']}`")
                if not p["replays"]:
                    lines.append("- No commit in this theme touches a file the rule includes; prove it on a scratch "
                                 "copy of the mistake from the review comment.")
                lines.append(f"- HEAD: {p['head_hits']} hit(s) now"
                             + (f" ({', '.join(p['head_where'])})" if p.get("head_where") else "")
                             + f". Rerun: `{p['head_cmd']}`. After the refactor this must be 0, "
                               "or held by a ratchet baseline.")
            else:
                lines.append(f"- Not replayed (--no-prove or no git repo). Replay with patlint `--rev SHA^` on a fix commit's files.")
        else:
            lines.append(f"No lint rule: {t['no_rule_reason']}.")
            if t["level"] in ("types", "test"):
                lines.append("Prove the change with a test that fails on the mistake revision and passes after it.")
        lines.append("Record the enforcement: `rule_table.py add AGENTS.md --rule \"...\" --enforced-by \"...\"` "
                     "(from the correct skill).")
    if unclassified:
        lines += ["", "## Seen once (not a theme yet)", ""]
        lines += [f"- {evidence_line(m)}" for m in unclassified[:30]]
        if len(unclassified) > 30:
            lines.append(f"- … {len(unclassified) - 30} more in plan.json")
    (out / "REFACTOR_PLAN.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    plan_doc = {"version": 1, "feedback": str(args.feedback), "repo": str(repo), "themes": themes,
                "unclassified": unclassified, "rules_file": str(rules_file), "proved": can_prove}
    (out / "plan.json").write_text(json.dumps(plan_doc, indent=2, default=str) + "\n", encoding="utf-8")

    summary = {"out_dir": str(out), "themes": len(themes), "rules": [r["id"] for r in rules],
               "proven": [t["rule"]["id"] for t in themes if t["rule"] and t["proof"] and t["proof"]["proven"]],
               "levels": {t["id"]: t["level"] for t in themes},
               "files": [str(out / "REFACTOR_PLAN.md"), str(rules_file), str(out / "plan.json")]}
    print(json.dumps(summary, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Explicit-state bounded model checker for small Python models (stdlib only).

MODEL.py defines:
  init()                     -> the initial state (or inits() -> iterable of initial states)
  actions(state)             -> [(action_name, next_state), ...]  every enabled step
  invariants = {name: fn}    fn(state) -> bool, must hold in every reachable state
optional:
  terminal(state) -> bool    states allowed to have no next step (for --deadlock)
  describe(state) -> str     how a state prints in a trace
  mutants = {name: fn}       broken variants of actions(); --mutants requires each to break an invariant
  DEPTH, MAX_STATES          defaults for --depth / --max-states

States must be hashable or built from dicts, lists, sets, tuples, namedtuples, or dataclasses.
The checker explores breadth-first up to --depth steps, so the counterexample it prints is a
shortest one. Exit 0 = every invariant holds within the bound (and every mutant was killed),
1 = violation, deadlock, or surviving mutant, 2 = model or usage error.
"""
from __future__ import annotations

import argparse
import dataclasses
import importlib.util
import json
import sys
import time
from collections import deque
from pathlib import Path


class ModelError(Exception):
    pass


def freeze(x):
    """A hashable key for a state."""
    try:
        hash(x)
        return x
    except TypeError:
        pass
    if dataclasses.is_dataclass(x) and not isinstance(x, type):
        return (type(x).__name__, freeze(dataclasses.asdict(x)))
    if isinstance(x, dict):
        return ("dict", tuple(sorted(((freeze(k), freeze(v)) for k, v in x.items()), key=repr)))
    if isinstance(x, (set, frozenset)):
        return ("set", tuple(sorted((freeze(v) for v in x), key=repr)))
    if isinstance(x, (list, tuple)):
        return (type(x).__name__, tuple(freeze(v) for v in x))
    return repr(x)


def jsonable(x):
    if hasattr(x, "_asdict"):
        return {k: jsonable(v) for k, v in x._asdict().items()}
    if dataclasses.is_dataclass(x) and not isinstance(x, type):
        return {k: jsonable(v) for k, v in dataclasses.asdict(x).items()}
    if isinstance(x, dict):
        return {str(k): jsonable(v) for k, v in x.items()}
    if isinstance(x, (set, frozenset)):
        return sorted((jsonable(v) for v in x), key=repr)
    if isinstance(x, (list, tuple)):
        return [jsonable(v) for v in x]
    if x is None or isinstance(x, (bool, int, float, str)):
        return x
    return repr(x)


def load_model(path: Path):
    if not path.is_file():
        raise ModelError(f"model {path} not found")
    sys.dont_write_bytecode = True  # don't leave __pycache__ next to the user's model
    sys.path.insert(0, str(path.resolve().parent))
    spec = importlib.util.spec_from_file_location(f"bounded_model_{path.stem}", path)
    mod = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(mod)
    except Exception as e:  # noqa: BLE001 - report any import-time failure of the model
        raise ModelError(f"importing {path} failed: {type(e).__name__}: {e}")
    if not callable(getattr(mod, "inits", None)) and not callable(getattr(mod, "init", None)):
        raise ModelError("MODEL.py must define init() (or inits())")
    if not callable(getattr(mod, "actions", None)):
        raise ModelError("MODEL.py must define actions(state) -> [(name, next_state), ...]")
    inv = getattr(mod, "invariants", None)
    if not isinstance(inv, dict) or not inv or not all(callable(f) for f in inv.values()):
        raise ModelError("MODEL.py must define invariants = {name: fn(state) -> bool} with at least one entry")
    return mod


def initial_states(mod) -> list:
    if callable(getattr(mod, "inits", None)):
        return list(mod.inits())
    return [mod.init()]


def explore(mod, actions_fn, invariants: dict, depth: int, max_states: int, deadlock: bool) -> dict:
    describe = getattr(mod, "describe", None)
    terminal = getattr(mod, "terminal", None)
    states: dict = {}
    parent: dict = {}  # key -> (parent_key, action, depth)
    queue: deque = deque()
    out = {"result": "pass", "states": 0, "transitions": 0, "max_depth": 0, "hit_depth_bound": False,
           "hit_state_bound": False, "violation": None}

    def trace(k) -> list[dict]:
        steps = []
        while k is not None:
            pk, act, d = parent[k]
            s = states[k]
            steps.append({"step": d, "action": act, "state": jsonable(s),
                          "describe": describe(s) if callable(describe) else None})
            k = pk
        return list(reversed(steps))

    def bad(k, kind: str, name: str, detail: str | None = None) -> dict:
        out["result"] = "error" if kind == "error" else "violation"
        out["violation"] = {"kind": kind, "name": name, "detail": detail, "trace": trace(k)}
        out["states"] = len(states)
        return out

    def check(k, s):
        for name, fn in invariants.items():
            try:
                ok = fn(s)
            except Exception as e:  # noqa: BLE001 - an invariant that crashes is a model bug; show where
                return bad(k, "error", name, f"invariant raised {type(e).__name__}: {e}")
            if not ok:
                return bad(k, "invariant", name)
        return None

    for s in initial_states(mod):
        k = freeze(s)
        if k in states:
            continue
        states[k] = s
        parent[k] = (None, "init", 0)
        if (r := check(k, s)) is not None:
            return r
        queue.append(k)
    while queue:
        k = queue.popleft()
        s = states[k]
        d = parent[k][2]
        if d >= depth:
            out["hit_depth_bound"] = True
            continue
        try:
            succ = list(actions_fn(s))
        except Exception as e:  # noqa: BLE001
            return bad(k, "error", "actions", f"actions() raised {type(e).__name__}: {e}")
        if not succ and deadlock and not (callable(terminal) and terminal(s)):
            return bad(k, "deadlock", "deadlock", "no action is enabled and terminal(state) is not true")
        for item in succ:
            if not (isinstance(item, tuple) and len(item) == 2):
                return bad(k, "error", "actions", f"actions() must yield (name, next_state) pairs, got {item!r:.80}")
            name, ns = item
            out["transitions"] += 1
            nk = freeze(ns)
            if nk in states:
                continue
            states[nk] = ns
            parent[nk] = (k, str(name), d + 1)
            out["max_depth"] = max(out["max_depth"], d + 1)
            if (r := check(nk, ns)) is not None:
                return r
            if len(states) >= max_states:
                out["hit_state_bound"] = True
                queue.clear()
                break
            queue.append(nk)
    out["states"] = len(states)
    out["exhaustive"] = not out["hit_depth_bound"] and not out["hit_state_bound"]
    return out


def print_trace(v: dict) -> None:
    for st in v["trace"]:
        shown = st["describe"] if st["describe"] is not None else json.dumps(st["state"])
        print(f"  {st['step']:>3}  {st['action']:<36} {shown}")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="bounded_check.py",
        description="Breadth-first explicit-state model checker for a Python model (init, actions, invariants). "
                    "Prints a shortest counterexample trace on violation.",
        epilog="examples:\n"
               "  bounded_check.py references/example_model.py\n"
               "  bounded_check.py model.py --depth 30 --deadlock\n"
               "  bounded_check.py model.py --mutants                 # every broken variant must be caught\n"
               "  bounded_check.py model.py --expect-violation no_lost_todo   # exit 0 only if it fails\n\n"
               "MODEL.py: init() or inits(); actions(state) -> [(name, next_state)]; invariants = {name: fn};\n"
               "optional terminal(state), describe(state), mutants = {name: actions_fn}, DEPTH, MAX_STATES.\n"
               "exit: 0 holds within the bound, 1 violation/deadlock/surviving mutant, 2 model or usage error",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("model", type=Path, help="the MODEL.py file")
    ap.add_argument("--depth", type=int, help="max steps from an initial state (default: MODEL.DEPTH or 25)")
    ap.add_argument("--max-states", type=int, help="stop after this many distinct states (default: MODEL.MAX_STATES or 200000)")
    ap.add_argument("--invariant", action="append", default=[], metavar="NAME", help="check only these invariants (repeatable)")
    ap.add_argument("--deadlock", action="store_true", help="also fail on states with no enabled action (unless terminal)")
    ap.add_argument("--mutants", action="store_true", help="also run every MODEL.mutants entry; each must violate an invariant")
    ap.add_argument("--expect-violation", metavar="NAME", help="succeed only if invariant NAME is violated (able-to-fail proof)")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args(argv)

    try:
        mod = load_model(args.model)
        invariants = dict(mod.invariants)
        if args.invariant:
            unknown = [n for n in args.invariant if n not in invariants]
            if unknown:
                raise ModelError(f"unknown invariant(s): {', '.join(unknown)}; known: {', '.join(invariants)}")
            invariants = {n: invariants[n] for n in args.invariant}
        if args.expect_violation and args.expect_violation not in invariants:
            raise ModelError(f"--expect-violation {args.expect_violation}: no such invariant; known: {', '.join(invariants)}")
        depth = args.depth or getattr(mod, "DEPTH", 25)
        max_states = args.max_states or getattr(mod, "MAX_STATES", 200_000)
        t0 = time.time()
        main_res = explore(mod, mod.actions, invariants, depth, max_states, args.deadlock)
        main_res["seconds"] = round(time.time() - t0, 3)
        mutant_res = {}
        if args.mutants:
            muts = getattr(mod, "mutants", None)
            if not isinstance(muts, dict) or not muts:
                raise ModelError("--mutants needs MODEL.mutants = {name: broken_actions_fn}")
            for name, fn in muts.items():
                r = explore(mod, fn, invariants, depth, max_states, args.deadlock)
                mutant_res[name] = {"killed": r["result"] == "violation", "by": (r["violation"] or {}).get("name"),
                                    "steps": len((r["violation"] or {}).get("trace", [])) - 1 if r["violation"] else None,
                                    "result": r}
    except ModelError as e:
        print(f"bounded_check: {e}", file=sys.stderr)
        return 2

    if args.expect_violation:
        v = main_res["violation"]
        ok = bool(v) and v["name"] == args.expect_violation and v["kind"] == "invariant"
    else:
        ok = main_res["result"] == "pass" and all(m["killed"] for m in mutant_res.values())
    if main_res["result"] == "error":
        code = 2
    else:
        code = 0 if ok else 1

    if args.json:
        print(json.dumps({"model": str(args.model), "depth": depth, "max_states": max_states,
                          "invariants": list(invariants), "ok": ok, **main_res,
                          "mutants": {k: {kk: vv for kk, vv in m.items() if kk != "result"} | {
                              "trace": (m["result"]["violation"] or {}).get("trace")} for k, m in mutant_res.items()},
                          "expect_violation": args.expect_violation}, indent=2))
        return code

    print(f"bounded_check: {args.model} (depth <= {depth}, {len(invariants)} invariant(s): {', '.join(invariants)})")
    if main_res["result"] == "pass":
        if main_res.get("exhaustive"):
            scope = "state space exhausted: complete for this model"
        elif main_res["hit_state_bound"]:
            scope = f"PARTIAL: state cap {max_states} hit at depth {main_res['max_depth']}; raise --max-states or shrink the model"
        else:
            scope = f"bound reached: holds up to depth {depth}, not beyond"
        print(f"PASS: invariants hold on {main_res['states']} states ({main_res['transitions']} transitions, "
              f"max depth {main_res['max_depth']}); {scope}")
    else:
        v = main_res["violation"]
        label = {"invariant": f'invariant "{v["name"]}" violated', "deadlock": "deadlock",
                 "error": f'model error in {v["name"]}'}[v["kind"]]
        print(f"{'FAIL' if v['kind'] != 'error' else 'ERROR'}: {label} after {len(v['trace']) - 1} step(s)"
              + (f": {v['detail']}" if v.get("detail") else ""))
        print_trace(v)
        print(f"explored {main_res['states']} states")
    if mutant_res:
        print("mutants (each broken variant must be caught, or the check proves nothing):")
        for name, m in mutant_res.items():
            if m["killed"]:
                print(f"  {name:<24} killed by {m['by']} after {m['steps']} step(s)")
            else:
                print(f"  {name:<24} SURVIVED: no invariant catches this broken variant; strengthen the property or the model")
        for name, m in mutant_res.items():
            if m["killed"]:
                print(f"counterexample for mutant {name}:")
                print_trace(m["result"]["violation"])
    if args.expect_violation:
        print(f"expect-violation {args.expect_violation}: {'met' if ok else 'NOT met'}")
    return code


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env bash
# Report whether TLA+ model checking can run here: java on PATH plus a tla2tools.jar.
# Also lists other verifiers it finds (apalache, kani, cbmc, z3, dafny, lean, coq).
# Exit 0 when java and tla2tools.jar are both present, 1 otherwise. Never downloads anything.
set -uo pipefail

usage() {
  cat <<'EOF'
usage: tla_available.sh [--json] [--quiet]

Reports whether TLA+ (TLC) can run on this machine: java on PATH and a tla2tools.jar.
Looks for the jar in $TLA2TOOLS_JAR, $TLA_HOME, ./, ~/.tla, ~/tla, ~/.local/share/tla,
/usr/share/java, /usr/local/lib, /opt/tla*, and a `tlc` wrapper on PATH.

  --json    machine-readable report
  --quiet   no output; exit status only

exit: 0 java + tla2tools.jar present, 1 missing (fall back to bounded_check.py), 2 usage error
EOF
}

json=0 quiet=0
for arg in "$@"; do
  case "$arg" in
    --json) json=1 ;;
    --quiet|-q) quiet=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

java_path="$(command -v java 2>/dev/null || true)"
java_version=""
if [[ -n "$java_path" ]]; then
  java_version="$("$java_path" -version 2>&1 | head -n 1 | tr -d '"')"
fi

jar=""
candidates=(
  "${TLA2TOOLS_JAR:-}"
  "${TLA_HOME:+$TLA_HOME/tla2tools.jar}"
  "./tla2tools.jar"
  "$HOME/.tla/tla2tools.jar"
  "$HOME/tla/tla2tools.jar"
  "$HOME/.local/share/tla/tla2tools.jar"
  "/usr/share/java/tla2tools.jar"
  "/usr/local/lib/tla2tools.jar"
)
for d in /opt/tla* /opt/TLA*; do
  [[ -d "$d" ]] && candidates+=("$d/tla2tools.jar" "$d/toolbox/tla2tools.jar")
done
for c in "${candidates[@]}"; do
  if [[ -n "$c" && -f "$c" ]]; then jar="$c"; break; fi
done
tlc_wrapper="$(command -v tlc 2>/dev/null || command -v tlc2 2>/dev/null || true)"

others=()
for tool in apalache-mc cargo-kani kani cbmc z3 dafny lean coqc; do
  p="$(command -v "$tool" 2>/dev/null || true)"
  [[ -n "$p" ]] && others+=("$tool=$p")
done

available=0
if [[ -n "$java_path" && ( -n "$jar" || -n "$tlc_wrapper" ) ]]; then available=1; fi
run_cmd=""
if [[ -n "$jar" ]]; then
  run_cmd="java -XX:+UseParallelGC -cp $jar tlc2.TLC -workers auto -deadlock Spec.tla"
elif [[ -n "$tlc_wrapper" ]]; then
  run_cmd="$tlc_wrapper -workers auto -deadlock Spec.tla"
fi
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "$quiet" == 1 ]]; then
  [[ "$available" == 1 ]]; exit $?
fi
if [[ "$json" == 1 ]]; then
  python3 - "$available" "$java_path" "$java_version" "$jar" "$tlc_wrapper" "$run_cmd" "$here" "${others[@]}" <<'PY'
import json, sys
available, java, version, jar, wrapper, run, here, *others = sys.argv[1:]
print(json.dumps({
    "available": available == "1",
    "java": java or None, "java_version": version or None,
    "tla2tools_jar": jar or None, "tlc_wrapper": wrapper or None,
    "run": run or None,
    "fallback": f"python3 {here}/bounded_check.py MODEL.py",
    "get_tla2tools": "https://github.com/tlaplus/tlaplus/releases (tla2tools.jar), plus a JDK 11+",
    "other_verifiers": dict(o.split("=", 1) for o in others),
}, indent=2))
PY
else
  echo "java:          ${java_path:-missing}${java_version:+ ($java_version)}"
  echo "tla2tools.jar: ${jar:-missing}${tlc_wrapper:+ (tlc wrapper: $tlc_wrapper)}"
  if [[ "$available" == 1 ]]; then
    echo "TLA+ available. Run: $run_cmd"
  else
    echo "TLA+ not available. Install a JDK 11+ and tla2tools.jar (https://github.com/tlaplus/tlaplus/releases),"
    echo "or check a Python model of the same design with: python3 $here/bounded_check.py MODEL.py"
  fi
  if [[ ${#others[@]} -gt 0 ]]; then echo "other verifiers: ${others[*]}"; else echo "other verifiers: none found"; fi
fi
[[ "$available" == 1 ]]
#!/usr/bin/env python3
"""Check a design sketch before any code is written.

  sketch_check.py SKETCH.md [--json]
  sketch_check.py --template        # print the sketch template

Fails (exit 1) unless the sketch has:
  * at least two candidates (`## Candidate A: ...`, `## Option 2 ...`), each with a sketch:
    a code block declaring types/signatures, or a module map of file paths
  * structurally distinct candidates: no pair declares nearly the same symbols and modules
    (Jaccard >= 0.8) or carries an identical code block
  * a red-flags screen (a heading with "red flag") that rates every candidate, as a table
    column or a labeled bullet, with at least two flags
  * a synthesis decision (a heading with "synthesis" or "decision") that names the chosen
    candidate and gives a reason (because / since / over / instead of / trade-off ...)
Warns when there is no caller-first usage section or a candidate's code has no stub bodies.
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from itertools import combinations
from pathlib import Path

CAND_RE = re.compile(r"^(#{2,4})\s+(?:Candidate|Option|Design|Alternative|Sketch)\s+([A-Z]|\d+|[IVX]+)\b[\s:.)\-—–]*(.*)$", re.I)
HEAD_RE = re.compile(r"^(#{1,6})\s+(.*)$")
DECL_RES = [
    re.compile(r"^\s*(?:export\s+)?(?:abstract\s+)?(?:data\s+)?class\s+([A-Za-z_]\w*)", re.M),
    re.compile(r"^\s*(?:async\s+)?def\s+([A-Za-z_]\w*)", re.M),
    re.compile(r"^\s*(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_]\w*)", re.M),
    re.compile(r"^\s*(?:export\s+)?(?:interface|type|enum|struct|trait|protocol|record|module)\s+([A-Za-z_]\w*)", re.M),
    re.compile(r"^\s*(?:pub\s+)?(?:async\s+)?fn\s+([A-Za-z_]\w*)", re.M),
    re.compile(r"^\s*func\s+(?:\([^)]*\)\s*)?([A-Za-z_]\w*)", re.M),
    re.compile(r"^\s*(?:export\s+)?const\s+([A-Za-z_]\w*)\s*=\s*(?:\(|async|function)", re.M),
    re.compile(r"^\s*([A-Z][A-Za-z0-9_]*)\s*=\s*(?:Literal|Enum|NewType|TypedDict|Union)\b", re.M),
]
MODULE_RE = re.compile(r"(?<![\w/.-])((?:[\w.-]+/)+[\w.-]+\.(?:py|ts|tsx|js|go|rs|rb|java|kt|swift|cs)|[\w-]+\.(?:py|ts|tsx|js|go|rs|rb))\b")
STUB_RE = re.compile(r"NotImplementedError|not implemented|todo!\(\)|unimplemented!\(\)|^\s*\.\.\.\s*$|:\s*\.\.\.\s*$|^\s*pass\s*$|"
                     r"panic\(\"not implemented|throw new Error\(['\"]not implemented", re.I | re.M)
REASON_RE = re.compile(r"\b(because|since|so that|trade-?offs?|over|rather than|instead of|wins?|cheaper|simpler|deeper|"
                       r"fewer|smaller|removes?|eliminates?)\b", re.I)
FENCE_RE = re.compile(r"^```[^\n]*\n(.*?)^```", re.S | re.M)


def sections(text: str) -> list[dict]:
    """Split markdown into heading sections (ignores headings inside fences)."""
    lines = text.splitlines()
    out, fence = [], False
    for n, line in enumerate(lines):
        if line.lstrip().startswith("```"):
            fence = not fence
            continue
        if fence:
            continue
        m = HEAD_RE.match(line)
        if m:
            out.append({"level": len(m.group(1)), "title": m.group(2).strip(), "start": n})
    for i, s in enumerate(out):
        end = len(lines)
        for t in out[i + 1:]:
            if t["level"] <= s["level"]:
                end = t["start"]
                break
        s["body"] = "\n".join(lines[s["start"] + 1:end])
        s["line"] = s["start"] + 1
    return out


def label_mentioned(label: str, text: str) -> bool:
    lab = re.escape(label)
    pats = [rf"\b(?i:candidate|option|design|alternative|sketch)\s+{lab}\b", rf"\|\s*\**{lab}\**\s*\|",
            rf"\*\*{lab}\*\*", rf"^\s*[-*+]\s*\**{lab}\**\s*[:—–-]", rf"\({lab}\)", rf"^\s*{lab}\s*[:—–]"]
    return any(re.search(p, text, re.M) for p in pats)


def analyze(text: str) -> dict:
    secs = sections(text)
    cands = []
    for s in secs:
        m = CAND_RE.match("#" * s["level"] + " " + s["title"])
        if m:
            code = "\n".join(FENCE_RE.findall(s["body"]))
            decls = set()
            for rx in DECL_RES:
                decls.update(x.lower() for x in rx.findall(code))
            modules = {x.lower() for x in MODULE_RE.findall(s["body"])}
            cands.append({"label": m.group(2).upper(), "title": m.group(3).strip(), "line": s["line"],
                          "decls": sorted(decls), "modules": sorted(modules), "code": code.strip(),
                          "stubs": bool(STUB_RE.search(code)), "has_shape": bool(re.search(r"\bshape\b", s["body"], re.I))})
    checks, warnings = [], []

    def add(name, ok, detail=""):
        checks.append({"check": name, "ok": ok, "detail": detail})

    add("at least two candidates", len(cands) >= 2,
        f"found {len(cands)}: " + ", ".join(c["label"] for c in cands) if cands else
        "add `## Candidate A: <shape>` and `## Candidate B: <shape>` sections")
    for c in cands:
        has = bool(c["decls"] or c["modules"])
        add(f"candidate {c['label']} has a sketch", has,
            f"{len(c['decls'])} declarations, {len(c['modules'])} modules" if has else
            "add a code block with types/signatures (stub bodies) or a module map with file paths")
        if c["code"] and not c["stubs"]:
            warnings.append(f"candidate {c['label']}: code has no stub bodies (raise NotImplementedError / ... / todo!()); "
                            "sketch signatures, not implementations")
    pairs = []
    for a, b in combinations(cands, 2):
        sa, sb = set(a["decls"]) | set(a["modules"]), set(b["decls"]) | set(b["modules"])
        jac = len(sa & sb) / len(sa | sb) if (sa | sb) else 1.0
        same_code = bool(a["code"]) and a["code"] == b["code"]
        ok = jac < 0.8 and not same_code
        pairs.append({"pair": f"{a['label']}/{b['label']}", "jaccard": round(jac, 2), "identical_code": same_code})
        add(f"{a['label']} and {b['label']} structurally distinct", ok,
            f"symbol/module overlap {jac:.2f}" + (", identical code" if same_code else "") +
            ("" if ok else ": design whole-shape alternatives (ownership, module boundaries, data flow), not point fixes"))

    red = next((s for s in secs if re.search(r"red[- ]?flag", s["title"], re.I)), None)
    if red is None:
        add("red-flags screen", False, "add `## Red-flags screen` rating every candidate (see references/design-red-flags.md)")
    else:
        unrated = [c["label"] for c in cands if not label_mentioned(c["label"], red["body"])]
        rows = len(re.findall(r"^\s*\|(?!\s*-)(?:[^|\n]*\|){2,}", red["body"], re.M)) - 1
        bullets = len(re.findall(r"^\s*[-*+]\s+\S", red["body"], re.M))
        enough = rows >= 2 or bullets >= 2
        add("red-flags screen", not unrated and enough,
            ("unrated: " + ", ".join(unrated) + ". " if unrated else "") +
            ("" if enough else "screen at least two flags (table rows or bullets)"))
    syn = next((s for s in secs if re.search(r"synthesis|decision", s["title"], re.I)), None)
    if syn is None:
        add("synthesis decision", False, "add `## Synthesis decision`: the chosen candidate, what it borrows, what was rejected and why")
    else:
        body = syn["body"].strip()
        named = [c["label"] for c in cands if label_mentioned(c["label"], body)]
        reason = bool(REASON_RE.search(body))
        words = len(body.split())
        ok = bool(named) and reason and words >= 12
        detail = []
        if not named:
            detail.append("name the chosen candidate (e.g. 'Candidate B')")
        if not reason:
            detail.append("give the reason (because / over / instead of / trade-off)")
        if words < 12:
            detail.append(f"only {words} words")
        add("synthesis decision", ok, "; ".join(detail) if detail else "chooses " + ", ".join(named))
    if not any(re.search(r"usage|caller|call site", s["title"], re.I) for s in secs):
        warnings.append("no caller-first usage section (`## Usage`): write the call sites first, derive the types from them")
    return {"candidates": [{k: v for k, v in c.items() if k != "code"} for c in cands], "pairs": pairs,
            "checks": checks, "warnings": warnings, "ok": all(c["ok"] for c in checks)}


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="sketch_check.py",
        description="Check a design sketch: >= 2 structurally distinct candidates with type/signature sketches, a "
                    "red-flags screen rating each candidate, and a synthesis decision with a reason. Exit 1 on failure.",
        epilog="examples:\n  sketch_check.py --template > SKETCH.md\n  sketch_check.py SKETCH.md\n  sketch_check.py SKETCH.md --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("sketch", nargs="?", type=Path, help="the sketch markdown file")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--template", action="store_true", help="print references/sketch-template.md and exit")
    args = ap.parse_args(argv)
    if args.template:
        tpl = Path(__file__).resolve().parent.parent / "references" / "sketch-template.md"
        sys.stdout.write(tpl.read_text(encoding="utf-8"))
        return 0
    if args.sketch is None:
        ap.error("SKETCH.md is required (or pass --template)")
    if not args.sketch.is_file():
        print(f"sketch_check: {args.sketch} not found; start from `sketch_check.py --template`", file=sys.stderr)
        return 2
    res = analyze(args.sketch.read_text(encoding="utf-8", errors="replace"))
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        for c in res["checks"]:
            print(f"{'PASS' if c['ok'] else 'FAIL'}  {c['check']}" + (f": {c['detail']}" if c["detail"] else ""))
        for w in res["warnings"]:
            print(f"warn  {w}")
        print(f"sketch_check: {'PASS' if res['ok'] else 'FAIL'} {args.sketch}")
    return 0 if res["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Write (or check) a pre-work brief for a task.

  brief.py "task" [--repo DIR] [--out BRIEF.md] [--force] [--json]
  brief.py --check BRIEF.md

The brief has four parts: the task in your own words, how a top expert would approach it
(raw sources, method, prior art), whether the task is over- or under-specified, and one
outside check that the result is right. When run inside a git repo it lists files that
match the task's keywords as candidate raw sources, so the expert section starts from
real files, not memory.

--check exits 1 while any TODO remains or the outside check has no runnable command or URL.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

STOP = set("""a an and any are as at be but by can do does for from has have how i if in into is it its make
me my not of on or our please should so some than that the their them then there these this those to too
up use using want we what when where which while who why will with would you your add fix new get set
change update improve make sure also just like need needs task work""".split())


def keywords(task: str) -> list[str]:
    words = re.findall(r"[A-Za-z_][A-Za-z0-9_-]{2,}", task)
    out = []
    for w in words:
        lw = w.lower()
        if lw not in STOP and lw not in out:
            out.append(lw)
    return out[:8]


def candidate_files(repo: Path, kws: list[str], limit: int = 8) -> list[tuple[str, int]]:
    if not kws:
        return []
    cmd = ["git", "-C", str(repo), "grep", "-c", "-I", "-i", "-w"]
    for k in kws:
        cmd += ["-e", k]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if res.returncode not in (0, 1):
        return []
    counts = Counter()
    for line in res.stdout.splitlines():
        path, _, n = line.rpartition(":")
        if path and n.isdigit():
            counts[path] += int(n)
    names = Counter()
    for k in kws:  # file names that contain a keyword count double
        for path in counts:
            if k in path.lower():
                names[path] += 1
    ranked = sorted(counts, key=lambda p: (-(counts[p] + 5 * names[p]), p))
    return [(p, counts[p]) for p in ranked[:limit]]


def render(task: str, repo: Path | None) -> tuple[str, dict]:
    kws = keywords(task)
    cands = candidate_files(repo, kws) if repo else []
    src = ", ".join(f"`{p}` ({n} hits)" for p, n in cands) if cands else "none found by keyword; name them yourself"
    today = dt.date.today().isoformat()
    text = f"""# Brief: {task}

Written {today}. Fill in every blank below, then run `brief.py --check` on this file. Keep it short: the point is better work, not a bigger plan.

## In my own words

- What the user is really after: TODO
- The problem behind the request: TODO
- Not the goal (effort that would be wasted): TODO

## How a top expert would approach it

- Raw sources they would read first: TODO
  - Candidates from the repo for {', '.join(kws) or 'the task'}: {src}
- Their method, step by step: TODO
- Prior art or a known-good reference to compare against: TODO

## Specification check

- Over-specified (constraints that don't serve the goal; loosen them): TODO
- Under-specified (decisions that are the user's to make; leave them open or ask): TODO
- Choices I'll make myself, and why they're mine to make: TODO

## Outside check

One check outside my own judgment that shows the result is right: a command, a reference output, a dataset, or a named person.

- Check: TODO
- Command or link: `TODO`
- Pass condition: TODO
"""
    return text, {"task": task, "keywords": kws, "candidate_sources": [{"path": p, "hits": n} for p, n in cands]}


def check(path: Path) -> list[str]:
    text = path.read_text(encoding="utf-8", errors="replace")
    errs = []
    todos = [n for n, line in enumerate(text.splitlines(), 1) if re.search(r"\bTODO\b", line)]
    if todos:
        errs.append(f"TODO left on line(s) {', '.join(map(str, todos[:10]))}")
    for head in ("In my own words", "How a top expert would approach it", "Specification check", "Outside check"):
        if not re.search(rf"^##\s+{re.escape(head)}\s*$", text, re.M):
            errs.append(f"missing section `## {head}`")
    m = re.search(r"^##\s+Outside check\s*$(.*?)(?=^##\s|\Z)", text, re.M | re.S)
    if m:
        body = m.group(1)
        runnable = re.search(r"`[^`\n]*[A-Za-z][^`\n]*`", body) or re.search(r"https?://\S+", body)
        if not runnable:
            errs.append("the outside check needs a runnable command in backticks or a URL to compare against")
        if not re.search(r"pass condition:\s*\S", body, re.I):
            errs.append("state the pass condition for the outside check")
    return errs


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="brief.py",
        description="Write a pre-work brief (in your own words, expert approach, over/under-specification, outside "
                    "check), or --check a filled one.",
        epilog="examples:\n"
               "  brief.py \"add json output to the export command\" --out BRIEF.md\n"
               "  brief.py --check BRIEF.md",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("task", nargs="?", help="the task, in the user's words")
    ap.add_argument("--repo", type=Path, default=Path("."), help="repo to search for raw sources (default: .)")
    ap.add_argument("--out", type=Path, help="write the brief here instead of stdout")
    ap.add_argument("--force", action="store_true", help="overwrite --out if it exists")
    ap.add_argument("--json", action="store_true", help="print the brief and its metadata as JSON")
    ap.add_argument("--check", type=Path, metavar="BRIEF.md", help="check a filled brief; exit 1 if incomplete")
    args = ap.parse_args(argv)

    if args.check:
        if not args.check.is_file():
            print(f"brief: {args.check} not found", file=sys.stderr)
            return 2
        errs = check(args.check)
        for e in errs:
            print(f"FAIL  {e}")
        print(f"brief: {'PASS' if not errs else 'FAIL'} {args.check}")
        return 0 if not errs else 1
    if not args.task:
        ap.error("give the task in quotes, or --check BRIEF.md")
    repo = args.repo if (args.repo / ".git").exists() or subprocess.run(
        ["git", "-C", str(args.repo), "rev-parse", "--git-dir"], capture_output=True).returncode == 0 else None
    text, meta = render(args.task, repo)
    if args.out:
        if args.out.exists() and not args.force:
            print(f"brief: {args.out} exists; pass --force to overwrite", file=sys.stderr)
            return 1
        args.out.write_text(text, encoding="utf-8")
        meta["out"] = str(args.out)
    if args.json:
        print(json.dumps({**meta, "brief": text}, indent=2))
    elif args.out:
        print(f"brief: wrote {args.out} ({len(meta['candidate_sources'])} candidate sources)")
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())

