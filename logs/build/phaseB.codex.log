                  f"Signature: {', '.join(t['signature'][:6])}.", "", "### Evidence", ""]
        lines += [f"- {evidence_line(m)}" for m in t["evidence"]]
        lines += ["", "### Level", "",
                  f"**{t['level']}**: {t['why']}.", f"Why not higher: {t['why_not_higher']}."]
        if t["bad"] or t["good"]:
            lines.append(f"Named in evidence: bad {', '.join(f'`{b}`' for b in t['bad'][:3]) or '-'}; "
                         f"fix {', '.join(f'`{g}`' for g in t['good'][:3]) or '-'}.")
        lines += ["", "### Target design (draft)", "", TARGETS[t["level"]].format(**fill), "", "### Steps", ""]
        lines += [f"{i}. {s.format(**fill)}" for i, s in enumerate(STEPS[t["level"]], 1)]
        lines += ["", "### Proof", ""]
        if r:
            lines.append(f"Rule `{r['id']}` in `{rules_file}`: regex `{r['regex']}`, include {r['include']}, "
                         f"message: {r['message']}")
            p = t["proof"]
            if p:
                for rp in p["replays"]:
                    mark = "fires on the mistake and not on the fix" if rp["distinguishes"] else "does NOT distinguish mistake from fix"
                    lines.append(f"- {rp['kind']} {rp['commit']}: {rp['hits_at_mistake']} hit(s) at `{rp['mistake_rev']}`, "
                                 f"{rp['hits_at_fixed']} at `{rp['fixed_rev']}`: {mark}. Rerun: `{rp['cmd']}`")
                if not p["replays"]:
                    lines.append("- No commit in this theme touches a file the rule includes; prove it on a scratch "
                                 "copy of the mistake from the review comment.")
                lines.append(f"- HEAD: {p['head_hits']} hit(s) now"
                             + (f" ({', '.join(p['head_where'])})" if p.get("head_where") else "")
                             + f". Rerun: `{p['head_cmd']}`. After the refactor this must be 0, "
                               "or held by a ratchet baseline.")
            else:
                lines.append(f"- Not replayed (--no-prove or no git repo). Replay with patlint `--rev SHA^` on a fix commit's files.")
        else:
            lines.append(f"No lint rule: {t['no_rule_reason']}.")
            if t["level"] in ("types", "test"):
        if args.invariant:
            unknown = [n for n in args.invariant if n not in invariants]
            if unknown:
                raise ModelError(f"unknown invariant(s): {', '.join(unknown)}; known: {', '.join(invariants)}")
            invariants = {n: invariants[n] for n in args.invariant}
        if args.expect_violation and args.expect_violation not in invariants:
            raise ModelError(f"--expect-violation {args.expect_violation}: no such invariant; known: {', '.join(invariants)}")
        depth = args.depth or getattr(mod, "DEPTH", 25)
        max_states = args.max_states or getattr(mod, "MAX_STATES", 200_000)
        t0 = time.time()
        main_res = explore(mod, mod.actions, invariants, depth, max_states, args.deadlock)
        main_res["seconds"] = round(time.time() - t0, 3)
        mutant_res = {}
        if args.mutants:
            muts = getattr(mod, "mutants", None)
            if not isinstance(muts, dict) or not muts:
                raise ModelError("--mutants needs MODEL.mutants = {name: broken_actions_fn}")
            for name, fn in muts.items():
                r = explore(mod, fn, invariants, depth, max_states, args.deadlock)
                mutant_res[name] = {"killed": r["result"] == "violation", "by": (r["violation"] or {}).get("name"),
                                    "steps": len((r["violation"] or {}).get("trace", [])) - 1 if r["violation"] else None,
                                    "result": r}
    except ModelError as e:
        print(f"bounded_check: {e}", file=sys.stderr)
        return 2

    if args.expect_violation:
        v = main_res["violation"]
        ok = bool(v) and v["name"] == args.expect_violation and v["kind"] == "invariant"
    else:
        ok = main_res["result"] == "pass" and all(m["killed"] for m in mutant_res.values())
    if main_res["result"] == "error":
        code = 2
    else:
        code = 0 if ok else 1

    if args.json:
        print(json.dumps({"model": str(args.model), "depth": depth, "max_states": max_states,
                          "invariants": list(invariants), "ok": ok, **main_res,
                          "mutants": {k: {kk: vv for kk, vv in m.items() if kk != "result"} | {
                              "trace": (m["result"]["violation"] or {}).get("trace")} for k, m in mutant_res.items()},
                          "expect_violation": args.expect_violation}, indent=2))
        return code

    print(f"bounded_check: {args.model} (depth <= {depth}, {len(invariants)} invariant(s): {', '.join(invariants)})")
    if main_res["result"] == "pass":
#!/usr/bin/env bash
# The curator's cron entry: upstream diff -> proposals -> (weekly) apply on a local branch.
# Never pushes. Commits only after scripts/verify.sh passes.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: curate.sh [--propose | --apply] [--offline] [--no-fetch] [--date YYYY-MM-DD] [--repo DIR]

  --propose   (default) run upstream_diff.sh, then write proposals/DATE.md:
              online: headless `claude -p --model opus --effort max` with references/curator-prompt.md
              (web research; every proposal needs a fetched source URL, a pyramid level, a change)
              --offline: proposals derived from the upstream diff only, no LLM
              The file must pass check_proposals.py (online runs also re-fetch every URL).
  --apply     weekly: make the change on local branch curator/DATE in a separate git worktree
              (your checkout is untouched), append a CHANGELOG entry, run scripts/verify.sh, and
              commit only if it passes. Never pushes.
              online: claude implements the best proposals; --offline: sync changed upstream files
              into research/upstream/ (a deterministic, sourced change)
  --offline   skip every LLM step (tests use this)
  --no-fetch  don't fetch upstream; diff against the cached clone
  --date D    run date (default: today)
  --repo DIR  poteto-skills checkout (default: derived from this script)

logs: logs/curator/DATE.log plus DATE.upstream.json, DATE.claude-*.json, DATE.verify.log
env:  POTETO_CACHE (clone and worktrees, default ~/.cache/poteto-skills), POTETO_UPSTREAM_URL,
      CURATOR_MODEL (opus), CURATOR_EFFORT (max), CURATOR_TIMEOUT (3600 s),
      CURATOR_VERIFY_CMD (bash scripts/verify.sh --run-examples)
cron: 17 6 * * *  /path/to/poteto-skills/skills/curator/scripts/curate.sh --propose
      47 6 * * 1  /path/to/poteto-skills/skills/curator/scripts/curate.sh --apply
EOF
}

mode=propose offline=0 nofetch=0 date_="$(date +%F)" repo="${POTETO_SKILLS_REPO:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --propose) mode=propose; shift ;;
    --apply) mode=apply; shift ;;
    --offline) offline=1; shift ;;
    --no-fetch) nofetch=1; shift ;;
    --date) date_="${2:?--date needs YYYY-MM-DD}"; shift 2 ;;
    --repo) repo="${2:?--repo needs a directory}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
[[ "$date_" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "curate: --date must be YYYY-MM-DD" >&2; exit 2; }

script_real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
script_dir="$(dirname "$script_real")"
skill_dir="$(dirname "$script_dir")"
[[ -n "$repo" ]] || repo="$(cd "$skill_dir/../.." && pwd)"
[[ -d "$repo/research/upstream" && -d "$repo/skills" ]] || { echo "curate: $repo is not a poteto-skills checkout; pass --repo" >&2; exit 2; }
repo="$(cd "$repo" && pwd)"
cache="${POTETO_CACHE:-$HOME/.cache/poteto-skills}"
log_dir="$repo/logs/curator"
mkdir -p "$log_dir"
exec > >(tee -a "$log_dir/$date_.log") 2>&1

say() { echo "[curate $(date +%H:%M:%S)] $*"; }
die() { say "ERROR: $*"; exit 1; }

say "mode=$mode offline=$offline no_fetch=$nofetch repo=$repo cache=$cache"
up_json="$log_dir/$date_.upstream.json"
proposals="$repo/proposals/$date_.md"
timeout_cmd=()
command -v timeout >/dev/null 2>&1 && timeout_cmd=(timeout "${CURATOR_TIMEOUT:-3600}")


exec
