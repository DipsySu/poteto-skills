#!/usr/bin/env python3
"""Mine a repo for mistake classes that happened at least twice.

Evidence sources:
  * git log: reverts (and the commits they revert) and fix commits, with their
    messages and touched files
  * --feedback FILE...: review comments in `gh api` JSON shape
    (list of {id, body, path, line, user.login, html_url, created_at}), the
    normalized feedback.json written by collect_feedback.py, or markdown notes
    (each bullet or paragraph is one item)
  * code comments that explain workarounds (HACK, WORKAROUND, FIXME, XXX)
  * AGENTS.md / CLAUDE.md rules: matched against each class; a matching rule that
    nothing enforces marks the class as a repeat

Items are grouped into classes by keyword/path signature (TF-IDF over words,
dotted identifiers, code spans, and file names; deterministic leader clustering
with refinement). Classes with fewer than --min-count occurrences are dropped
(a revert and the commit it reverts count as one occurrence).

This module is also imported by feedback-to-architecture (collect_feedback.py,
plan.py): keep the item schema stable.

Item schema: {id, source, kind, ref, text, paths, line, author, date, url}
  source: commit | review | chat | code-comment
  kind (commits only): fix | revert | reverted
"""
from __future__ import annotations

import argparse
import json
import math
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

sys.dont_write_bytecode = True  # importing siblings must not leave __pycache__ in the skill dir
HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))
import rule_table  # noqa: E402  (sibling script)

FIX_RE = re.compile(
    r"\b(fix(?:es|ed|ing|up)?|bug ?fix|hotfix|regression|broke(?:n)?|oops|typo|forgot|"
    r"wrong|incorrect|repair|correct(?:ed|s)?|again|mistake)\b", re.I)
CONVENTIONAL_FIX = re.compile(r"^(fix|bugfix|hotfix)(\([^)]*\))?!?:", re.I)
REVERT_SUBJECT = re.compile(r'^Revert\s+"', re.I)
REVERTS_SHA = re.compile(r"This reverts commit ([0-9a-f]{7,40})", re.I)
TRAILER = re.compile(r"^\s*(Co-Authored-By|Signed-off-by|Reviewed-by|Change-Id|Acked-by|Tested-by)\s*:", re.I)
WORKAROUND_RE = r"\b(HACK|WORKAROUND|FIXME|XXX)\b"

STOP = set("""
a about above after against all also am an and any are as at be because been before being below between both but by
can cannot could did do does doing down during each else ever every few for from further get gets got had has have having
he her here hers him his how however i if in into is it its itself just let lets like make makes made me more most much must my
never no nor not now of off on once only or other our ours out over own per please same she should so some such than that the
their theirs them then there these they this those through to too under until up us very via was we were what when where which
while who whom why will with within without would yet you your yours
don doesn isn won didn shouldn wouldn couldn aren wasn weren hasn haven dont doesnt isnt cant wont didnt shouldnt
fix fixes fixed fixing fixup bug bugs bugfix hotfix issue issues pr prs commit commits revert reverts reverted reverting
merge merged update updated updates updating change changes changed changing use used uses using instead again still
always really actually thing things stuff etc ok okay thanks thank lgtm nit nits wip tmp
this that one two new add adds added adding remove removed line lines code file files
""".split())

CODE_SPAN = re.compile(r"`([^`\n]{1,120})`")
FILE_LIKE = re.compile(
    r"(?<![\w/.-])((?:[\w.-]+/)*[\w-]+\.(?:py|pyi|js|jsx|ts|tsx|mjs|cjs|go|rs|rb|java|kt|swift|c|h|cc|cpp|hpp|cs|php|"
    r"json|ya?ml|toml|ini|cfg|md|sh|sql|html|css|scss|lock|txt|csv))\b")
DOTTED = re.compile(r"(?<![\w.])([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)+)(\(\))?")
CALL = re.compile(r"(?<![\w.])([A-Za-z_][A-Za-z0-9_]{2,})\(\)")
WORD = re.compile(r"[a-z][a-z0-9_]{2,}")
STRONG_PREFIXES = ("file:", "id:", "code:")

SOURCE_ORDER = {"commit": 0, "review": 1, "chat": 2, "code-comment": 3}


# ---------------------------------------------------------------- tokenizing

def stem(w: str) -> str:
    if len(w) > 4 and w.endswith("ies"):
        w = w[:-3] + "y"
    elif len(w) > 5 and w.endswith("ing"):
        w = w[:-3]
    elif len(w) > 4 and w.endswith("ed") and not w.endswith("eed"):
        w = w[:-2]
    elif len(w) > 4 and w.endswith("es") and w[:-2].endswith(("s", "x", "z", "ch", "sh")):
        w = w[:-2]
    elif len(w) > 3 and w.endswith("s") and not w.endswith(("ss", "us", "is")):
        w = w[:-1]
    elif len(w) > 5 and w.endswith("ly"):
        w = w[:-2]
    if len(w) > 4 and w.endswith("e"):
        w = w[:-1]
    return w


def code_keys(blob: str, note) -> None:
    """file: and id: keys from code (diff lines, identifiers). No plain words."""
    consumed = []
    for m in FILE_LIKE.finditer(blob):
        name = m.group(1)
        note("file:" + name.rsplit("/", 1)[-1].lower(), name.rsplit("/", 1)[-1])
        consumed.append(m.span())
    for m in DOTTED.finditer(blob):
        if any(a <= m.start() < b for a, b in consumed):
            continue
        ident = m.group(1)
        note("id:" + ident.lower(), ident + (m.group(2) or ""))


def tokens(text: str, paths: list[str] | None = None, surfaces: dict | None = None) -> set[str]:
    """Signature keys for one item: stemmed words, file:, id:, code: keys."""
    keys: set[str] = set()

    def note(key: str, surface: str) -> None:
        keys.add(key)
        if surfaces is not None:
            surfaces.setdefault(key, Counter())[surface] += 1

    text = text or ""
    code_keys(text, note)
    for m in CALL.finditer(text):
        note("id:" + m.group(1).lower(), m.group(1) + "()")
    for span in CODE_SPAN.findall(text):
        s = span.strip().rstrip("()").strip()
        if s and " " not in s and len(s) <= 40:
            note("code:" + s.lower(), span.strip())
    for raw in WORD.findall(text.lower()):
        if raw in STOP or raw.isdigit():
            continue
        st = stem(raw)
        if len(st) < 3 or st in STOP:
            continue
        note(st, raw)
    for p in (paths or [])[:8]:
        base = p.rsplit("/", 1)[-1]
        if base:
            note("file:" + base.lower(), base)
    return keys


def display_key(key: str, surfaces: dict) -> str:
    c = surfaces.get(key)
    if c:
        return c.most_common(1)[0][0]
    return key.split(":", 1)[-1]


# ---------------------------------------------------------------- collection

def run_git(repo: Path, *args: str) -> str:
    res = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, errors="replace")
    if res.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} failed: {res.stderr.strip()}")
    return res.stdout


def is_git_repo(repo: Path) -> bool:
    try:
        run_git(repo, "rev-parse", "--git-dir")
        return True
    except (RuntimeError, OSError):
        return False


def clean_message(body: str) -> str:
    keep = [ln for ln in body.splitlines() if not TRAILER.match(ln) and not REVERTS_SHA.search(ln)]
    return "\n".join(keep).strip()


def diff_identifiers(repo: Path, sha: str, limit: int = 25) -> tuple[list[str], list[str]]:
    """Dotted identifiers and file names on the added and removed lines of a commit."""
    try:
        out = run_git(repo, "show", "--format=", "--unified=0", "--no-color", "--no-ext-diff", sha)
    except RuntimeError:
        return [], []
    added: list[str] = []
    removed: list[str] = []
    changed = [x for x in out.splitlines() if x[:1] in "+-" and not x.startswith(("+++", "---"))]
    for ln in changed[:400]:
        bucket = added if ln[0] == "+" else removed
        if len(bucket) >= limit:
            continue

        def note(key: str, surface: str, bucket=bucket) -> None:
            if surface not in bucket:
                bucket.append(surface)

        code_keys(ln[1:], note)
    return added[:limit], removed[:limit]


def git_items(repo: Path, since: str | None = None, max_commits: int = 2000) -> list[dict]:
    """Fix commits, reverts, and reverted commits as items."""
    fmt = "%x1e%H%x1f%an%x1f%ad%x1f%s%x1f%b%x1d"
    args = ["log", "--no-merges", "--name-only", f"--format={fmt}", "--date=short", f"-n{max_commits}"]
    if since:
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", since.strip()):
            since = since.strip() + " 00:00:00"  # bare dates mean midnight, not "now" on that day
        args.append(f"--since={since}")
    out = run_git(repo, *args)
    commits = []
    for rec in out.split("\x1e"):
        if not rec.strip():
            continue
        head, _, files = rec.partition("\x1d")
        parts = head.split("\x1f")
        if len(parts) < 5:
            continue
        sha, author, date, subject, body = parts[0], parts[1], parts[2], parts[3], parts[4]
        paths = [f.strip() for f in files.splitlines() if f.strip()]
        commits.append({"sha": sha, "author": author, "date": date, "subject": subject, "body": body, "paths": paths})

    reverted: dict[str, str] = {}
    for c in commits:
        m = REVERTS_SHA.search(c["body"])
        if REVERT_SUBJECT.match(c["subject"]) or m:
            c["kind"] = "revert"
            if m:
                c["reverts"] = m.group(1)
                reverted[m.group(1)] = c["sha"]
        elif CONVENTIONAL_FIX.match(c["subject"]) or FIX_RE.search(c["subject"]) or FIX_RE.search(clean_message(c["body"])):
            c["kind"] = "fix"
    for c in commits:
        for short, by in reverted.items():
            if c["sha"].startswith(short) and c.get("kind") != "revert":
                c["kind"] = "reverted"
                c["reverted_by"] = by
    items = []
    for c in commits:
        kind = c.get("kind")
        if not kind:
            continue
        text = c["subject"]
        body = clean_message(c["body"])
        if body:
            text += "\n" + body
        added, removed = diff_identifiers(repo, c["sha"])
        item = {"id": f"commit:{c['sha'][:10]}", "source": "commit", "kind": kind, "ref": c["sha"],
                "text": text, "paths": c["paths"], "line": None, "author": c["author"], "date": c["date"], "url": None,
                "diff_ids": added + [x for x in removed if x not in added],
                "diff_added": added, "diff_removed": removed}
        if c.get("reverts"):
            item["reverts"] = c["reverts"]
        if c.get("reverted_by"):
            item["reverted_by"] = c["reverted_by"]
        items.append(item)
    return items


def code_comment_items(repo: Path, limit: int = 200) -> list[dict]:
    try:
        out = run_git(repo, "grep", "-n", "-I", "-E", WORKAROUND_RE)
    except RuntimeError:  # git grep exits 1 when nothing matches
        return []
    items = []
    for ln in out.splitlines()[:limit]:
        path, _, rest = ln.partition(":")
        lineno, _, text = rest.partition(":")
        text = re.sub(r"^\s*(#+|//+|/\*+|\*+|--|<!--)\s*", "", text).strip()
        if not text:
            continue
        items.append({"id": f"code:{path}:{lineno}", "source": "code-comment", "kind": None, "ref": f"{path}:{lineno}",
                      "text": text, "paths": [path], "line": int(lineno) if lineno.isdigit() else None,
                      "author": None, "date": None, "url": None})
    return items


def _json_values(raw: str) -> list:
    """Parse one JSON document, concatenated documents (`gh api --paginate`), or JSON lines."""
    dec = json.JSONDecoder()
    vals, i = [], 0
    raw = raw.strip()
    while i < len(raw):
        while i < len(raw) and raw[i] in " \t\r\n,":
            i += 1
        if i >= len(raw):
            break
        val, i = dec.raw_decode(raw, i)
        vals.append(val)
    return vals


def _flatten_comment_objects(val) -> list[dict]:
    if isinstance(val, list):
        out = []
        for v in val:
            out.extend(_flatten_comment_objects(v))
        return out
    if isinstance(val, dict):
        if "body" in val or "text" in val:
            return [val]
        out = []
        for key in ("items", "comments", "review_comments", "reviews", "nodes", "data"):
            if key in val:
                out.extend(_flatten_comment_objects(val[key]))
        return out
    return []


def _login(obj) -> str | None:
    if isinstance(obj, dict):
        return obj.get("login") or obj.get("name")
    return obj if isinstance(obj, str) else None


def review_items_from_json(raw: str, origin: str) -> list[dict]:
    items = []
    for n, obj in enumerate(_flatten_comment_objects(_json_values(raw))):
        if "source" in obj and "ref" in obj and "text" in obj:  # already normalized (collect_feedback.py)
            item = {k: obj.get(k) for k in ("id", "source", "kind", "ref", "text", "paths", "line", "author", "date",
                                            "url", "reverts", "reverted_by", "diff_ids", "diff_added", "diff_removed")
                    if obj.get(k) is not None or k in ("kind", "line", "author", "date", "url")}
            item["paths"] = item.get("paths") or []
            item["id"] = item.get("id") or f"{item['source']}:{n}"
            items.append(item)
            continue
        body = (obj.get("body") or obj.get("text") or "").strip()
        if not body:
            continue
        cid = obj.get("id") or obj.get("node_id") or n
        url = obj.get("html_url") or obj.get("url")
        path = obj.get("path")
        line = obj.get("line") or obj.get("original_line") or obj.get("position")
        date = (obj.get("created_at") or obj.get("createdAt") or obj.get("submitted_at") or "")[:10] or None
        items.append({"id": f"review:{cid}", "source": "review", "kind": None,
                      "ref": url or f"{origin}#{cid}", "text": body, "paths": [path] if path else [],
                      "line": line if isinstance(line, int) else None,
                      "author": _login(obj.get("user")) or _login(obj.get("author")), "date": date, "url": url})
    return items


def markdown_items(text: str, origin: str, source: str = "chat") -> list[dict]:
    """One item per bullet (with continuation lines) or paragraph. Headings are context, not items."""
    items: list[dict] = []
    block: list[str] = []
    start = 0
    in_fence = False

    def flush():
        nonlocal block
        body = " ".join(s.strip() for s in block).strip()
        if len(body.split()) >= 3:
            items.append({"id": f"{source}:{origin}:{start}", "source": source, "kind": None,
                          "ref": f"{origin}:{start}", "text": body, "paths": [], "line": start,
                          "author": None, "date": None, "url": None})
        block = []

    for n, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        if stripped.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            if block:
                block.append(stripped)
            continue
        if not stripped or stripped.startswith("#") or re.fullmatch(r"[-*_]{3,}", stripped):
            flush()
            continue
        stripped = re.sub(r"^>\s?", "", stripped)
        bullet = re.match(r"^([-*+]|\d+[.)])\s+(.*)$", stripped)
        if bullet:
            flush()
            start = n
            block = [bullet.group(2)]
        else:
            if not block:
                start = n
            block.append(stripped)
    flush()
    return items


def load_feedback(path: Path, source: str | None = None) -> list[dict]:
    raw = path.read_text(encoding="utf-8", errors="replace")
    origin = path.name
    head = raw.lstrip()[:1]
    if head in ("[", "{"):
        try:
            return review_items_from_json(raw, origin)
        except json.JSONDecodeError:
            pass
    src = source or ("review" if "review" in path.name.lower() else "chat")
    return markdown_items(raw, origin, src)


def agents_rules(repo: Path, files: list[Path] | None = None) -> list[dict]:
    """Rules from agent instruction files: table rows (with enforcement) and bullets."""
    cands = files if files is not None else [repo / n for n in ("AGENTS.md", "CLAUDE.md")]
    rules = []
    for f in cands:
        if not f.is_file():
            continue
        text = f.read_text(encoding="utf-8", errors="replace")
        lines = text.splitlines()
        table_lines = set()
        res = rule_table.check(f)
        for r in res["rules"]:
            rules.append({"file": f.name, "line": r["line"], "text": r["rule"], "enforced_by": r["enforced_by"],
                          "status": r["status"]})
            table_lines.add(r["line"])
        for n, ln in enumerate(lines, 1):
            m = re.match(r"^\s*(?:[-*+]|\d+[.)])\s+(.{8,})$", ln)
            if m and n not in table_lines:
                rules.append({"file": f.name, "line": n, "text": m.group(1).strip(), "enforced_by": None, "status": "prose"})
    return rules


# ---------------------------------------------------------------- clustering

def _cos(a: dict, b: dict) -> float:
    if len(a) > len(b):
        a, b = b, a
    return sum(v * b.get(k, 0.0) for k, v in a.items())


def _normalize(v: dict) -> dict:
    n = math.sqrt(sum(x * x for x in v.values()))
    return {k: x / n for k, x in v.items()} if n else {}


def vectorize(items: list[dict]):
    """TF-IDF vectors. Keys seen only in a commit's diff (not its message) weigh less."""
    surfaces: dict = {}
    text_docs = [tokens(it.get("text") or "", it.get("paths") or [], surfaces) for it in items]
    diff_docs = []
    for it in items:
        keys: set[str] = set()

        def note(key: str, surface: str, keys=keys) -> None:
            keys.add(key)
            surfaces.setdefault(key, Counter())[surface] += 1

        code_keys(" ".join(it.get("diff_ids") or []), note)
        diff_docs.append(keys)
    docs = [t | d for t, d in zip(text_docs, diff_docs)]
    df = Counter(k for d in docs for k in d)
    n = len(items)
    idf = {k: math.log((1 + n) / (1 + c)) + 1.0 for k, c in df.items()}
    vecs = []
    for t, d in zip(text_docs, docs):
        v = {}
        for k in d:
            if df[k] < 2:
                continue  # unshared keys cannot make two items similar
            w = idf[k] * (1.5 if k.startswith(STRONG_PREFIXES) else 1.0)
            v[k] = w if k in t else 0.7 * w
        vecs.append(_normalize(v))
    return docs, vecs, df, idf, surfaces


def _occurrences(members: list[dict]) -> int:
    """Distinct occurrences: a revert and the commit it reverts are one mistake."""
    shas = {m["ref"] for m in members if m["source"] == "commit"}
    n = 0
    for m in members:
        if m["source"] == "commit" and m.get("kind") == "revert" and m.get("reverts"):
            if any(s.startswith(m["reverts"]) for s in shas):
                continue
        n += 1
    return n


def cluster_items(items: list[dict], threshold: float = 0.3, min_count: int = 2, rules: list[dict] | None = None):
    """Group items into classes. Returns (classes, unclassified)."""
    if not items:
        return [], []
    order = sorted(range(len(items)), key=lambda i: (SOURCE_ORDER.get(items[i]["source"], 9),
                                                     items[i].get("date") or "", items[i]["id"]))
    docs, vecs, df, idf, surfaces = vectorize(items)

    def best_group(v: dict, cents: list[dict], index: dict) -> tuple[int, float]:
        cand: set[int] = set()
        for k in v:
            cand |= index.get(k, set())
        best, best_sim = -1, 0.0
        for gi in sorted(cand):
            sim = _cos(v, cents[gi])
            if sim > best_sim + 1e-12:
                best, best_sim = gi, sim
        return best, best_sim

    def rebuild(groups: list[list[int]]):
        sums, cents, index = [], [], {}
        for gi, g in enumerate(groups):
            s: dict = {}
            for i in g:
                for k, x in vecs[i].items():
                    s[k] = s.get(k, 0.0) + x
                    index.setdefault(k, set()).add(gi)
            sums.append(s)
            cents.append(_normalize(s))
        return sums, cents, index

    # Leader pass: join the most similar class if similar enough, else start a new one.
    groups: list[list[int]] = []
    sums: list[dict] = []
    cents: list[dict] = []
    index: dict[str, set[int]] = {}
    for i in order:
        v = vecs[i]
        gi, sim = best_group(v, cents, index)
        if gi >= 0 and sim >= threshold:
            groups[gi].append(i)
            for k, x in v.items():
                sums[gi][k] = sums[gi].get(k, 0.0) + x
                index.setdefault(k, set()).add(gi)
            cents[gi] = _normalize(sums[gi])
        else:
            gi = len(groups)
            groups.append([i])
            sums.append(dict(v))
            cents.append(_normalize(v))
            for k in v:
                index.setdefault(k, set()).add(gi)

    # Refinement: move each item to its best centroid until assignments are stable.
    for _ in range(5):
        assign: dict[int, int | None] = {}
        for gi, g in enumerate(groups):
            for i in g:
                v = vecs[i]
                own = _cos(v, cents[gi]) if v else 0.0
                bj, bs = best_group(v, cents, index)
                if bj < 0 or bs <= own + 1e-9:
                    bj, bs = gi, own
                assign[i] = None if (bs < threshold * 0.8 and len(g) > 1) else bj
        buckets: dict[int, list[int]] = {}
        singles: list[list[int]] = []
        for i in order:
            if assign[i] is None:
                singles.append([i])
            else:
                buckets.setdefault(assign[i], []).append(i)
        new_groups = [buckets[k] for k in sorted(buckets)] + singles
        if sorted(map(tuple, new_groups)) == sorted(map(tuple, groups)):
            break
        groups = new_groups
        sums, cents, index = rebuild(groups)

    # Second chance: a multi-item group below min_count (typically a revert and the commit it
    # reverts, one occurrence with a terse message) joins the closest class if moderately similar.
    rank = {i: r for r, i in enumerate(order)}

    def occ(g: list[int]) -> int:
        return _occurrences([items[i] for i in g])

    while True:
        sums, cents, index = rebuild(groups)
        big = [gi for gi, g in enumerate(groups) if occ(g) >= min_count]
        moved = False
        for gi, g in enumerate(groups):
            if len(g) < 2 or occ(g) >= min_count or not cents[gi]:
                continue
            best, best_sim = -1, 0.0
            for gj in big:
                sim = _cos(cents[gi], cents[gj])
                if sim > best_sim + 1e-12:
                    best, best_sim = gj, sim
            if best >= 0 and best_sim >= threshold * 0.6:
                groups[best] = sorted(groups[best] + g, key=rank.get)
                groups[gi] = []
                moved = True
                break
        groups = [g for g in groups if g]
        if not moved:
            break

    classes, unclassified = [], []
    for g in groups:
        members = [items[i] for i in g]
        count = _occurrences(members)
        if count < min_count:
            unclassified.extend(members)
            continue
        key_counts = Counter(k for i in g for k in docs[i])
        shared = [k for k, c in key_counts.items() if c >= 2]
        shared.sort(key=lambda k: (-key_counts[k], -idf.get(k, 0) * (1.5 if k.startswith(STRONG_PREFIXES) else 1), k))
        centroid = _normalize({k: sum(vecs[i].get(k, 0.0) for i in g) for k in shared})
        cls = {
            "count": count,
            "items": len(members),
            "sources": dict(Counter(m["source"] for m in members)),
            "signature": [display_key(k, surfaces) for k in shared[:8]],
            "signature_keys": shared[:8],
            "evidence": sorted(members, key=lambda m: (m.get("date") or "", m["id"]), reverse=True),
            "rules": [],
            "repeat": False,
        }
        if rules:
            for r in rules:
                rk = tokens(r["text"])
                rv = _normalize({k: idf.get(k, 0.0) for k in rk if k in idf})
                strong_overlap = any(k.startswith(STRONG_PREFIXES) and k in rk for k in shared)
                if strong_overlap or _cos(rv, centroid) >= 0.25:
                    cls["rules"].append(r)
            cls["repeat"] = any(r.get("status") != "enforced" for r in cls["rules"])
        classes.append(cls)
    classes.sort(key=lambda c: (-c["count"], -len(c["sources"]), c["signature"]))
    for n, c in enumerate(classes, 1):
        c["id"] = f"C{n}"
    unclassified.sort(key=lambda m: m["id"])
    return classes, unclassified


# ---------------------------------------------------------------- reporting

def short(text: str, n: int = 100) -> str:
    one = " ".join((text or "").split())
    return one if len(one) <= n else one[: n - 1] + "…"


def describe_item(m: dict) -> str:
    if m["source"] == "commit":
        files = ", ".join(m.get("paths", [])[:3]) + (" …" if len(m.get("paths", [])) > 3 else "")
        tag = {"fix": "fix", "revert": "revert", "reverted": "reverted"}.get(m.get("kind"), "commit")
        return f"{tag:<8} {m['ref'][:10]} {m.get('date') or ''} {short(m['text'].splitlines()[0], 80)}" + (f"  [{files}]" if files else "")
    where = m.get("paths")[0] if m.get("paths") else ""
    if where and m.get("line"):
        where += f":{m['line']}"
    if where == m["ref"]:
        where = ""
    who = f" @{m['author']}" if m.get("author") else ""
    return f"{m['source']:<8} {m['ref']}{who}{' ' + where if where else ''} \"{short(m['text'], 90)}\""


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="mine_mistakes.py",
        description="Group a repo's reverts, fix commits, review comments, and workaround comments into mistake "
                    "classes (keyword/path signatures). Keeps classes seen at least --min-count times and prints the "
                    "evidence: commit shas, comment ids, file:line refs.",
        epilog="examples:\n"
               "  mine_mistakes.py .\n"
               "  mine_mistakes.py . --since 2026-07-01 --feedback review-comments.json chat-feedback.md --json\n"
               "  gh api repos/OWNER/REPO/pulls/comments --paginate > review-comments.json   # read-only fetch\n\n"
               "Classes that match an AGENTS.md/CLAUDE.md rule not enforced by a check are marked `repeat`:\n"
               "the rule exists and the mistake still happened, so fix it higher up the pyramid.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("repo", type=Path, help="repository to mine")
    ap.add_argument("--since", help="only commits after this date (git --since syntax, e.g. 2026-07-01 or '90 days ago')")
    ap.add_argument("--feedback", nargs="+", type=Path, default=[], metavar="FILE",
                    help="review-comment JSON (gh api shape) or markdown notes")
    ap.add_argument("--agents-file", nargs="+", type=Path, default=None, metavar="FILE",
                    help="agent instruction files to match rules from (default: REPO/AGENTS.md REPO/CLAUDE.md)")
    ap.add_argument("--min-count", type=int, default=2, help="minimum occurrences for a class (default 2)")
    ap.add_argument("--threshold", type=float, default=0.3, help="cosine similarity to join a class (default 0.3)")
    ap.add_argument("--max-commits", type=int, default=2000, help="newest N commits to read (default 2000)")
    ap.add_argument("--no-git", action="store_true", help="skip git history (feedback files only)")
    ap.add_argument("--no-code-comments", action="store_true", help="skip HACK/WORKAROUND/FIXME/XXX comments")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args(argv)

    repo = args.repo.resolve()
    if not repo.is_dir():
        print(f"mine_mistakes: {repo} is not a directory", file=sys.stderr)
        return 2
    items: list[dict] = []
    git_ok = not args.no_git and is_git_repo(repo)
    if not args.no_git and not git_ok:
        print(f"mine_mistakes: {repo} is not a git repo; reading feedback files only (pass --no-git to silence)",
              file=sys.stderr)
    if git_ok:
        items += git_items(repo, args.since, args.max_commits)
        if not args.no_code_comments:
            items += code_comment_items(repo)
    for f in args.feedback:
        if not f.is_file():
            print(f"mine_mistakes: feedback file {f} not found", file=sys.stderr)
            return 2
        items += load_feedback(f)
    seen, unique = set(), []
    for it in items:
        if it["id"] not in seen:
            seen.add(it["id"])
            unique.append(it)
    items = unique
    rules = agents_rules(repo, args.agents_file)
    classes, unclassified = cluster_items(items, args.threshold, args.min_count, rules)

    counts = dict(Counter(it["source"] for it in items))
    if args.json:
        print(json.dumps({"repo": str(repo), "since": args.since, "items": len(items), "counts": counts,
                          "min_count": args.min_count, "classes": classes,
                          "unclassified": unclassified, "rules_read": len(rules)}, indent=2, default=str))
        return 0

    summary = ", ".join(f"{v} {k}" for k, v in sorted(counts.items())) or "nothing"
    print(f"mine_mistakes: {len(items)} items ({summary}) from {repo}" + (f" since {args.since}" if args.since else ""))
    if not classes:
        print(f"No class reached {args.min_count} occurrences. Nothing to fix yet; rerun after more history or pass --feedback.")
    for c in classes:
        srcs = ", ".join(f"{k}×{v}" for k, v in sorted(c["sources"].items()))
        print(f"\n{c['id']}  {c['count']} occurrences [{srcs}]  signature: {', '.join(c['signature'][:6])}")
        for r in c["rules"]:
            if r.get("status") == "enforced":
                state = "rule enforced, mistake still happened (check the check)"
            else:
                state = f"REPEAT ({r.get('status')}: nothing that runs enforces it)"
            print(f"  {state}: {r['file']}:{r['line']} \"{short(r['text'], 70)}\"" +
                  (f" <- {r['enforced_by']}" if r.get("enforced_by") else ""))
        for m in c["evidence"]:
            print("  - " + describe_item(m))
    if unclassified:
        print(f"\nSeen once ({len(unclassified)}), not a class yet:")
        for m in unclassified[:15]:
            print("  - " + describe_item(m))
        if len(unclassified) > 15:
            print(f"  … {len(unclassified) - 15} more (use --json)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""patlint: a deterministic, rule-file-driven pattern lint.

Each rule has an id, a regex, include globs, and a message that names the fix
(the file, function, or type to use instead). Run the same command locally and
in CI.

Rules file (JSON):
  {"rules": [{
      "id": "no-direct-json-write",
      "regex": "\\\\bjson\\\\.dump\\\\(",
      "include": ["**/*.py"],
      "exclude": ["todo/store.py", "tests/**"],
      "message": "Write todos through `store.save()` in todo/store.py, never json.dump on the data file.",
      "ignore_case": false,
      "multiline": false
  }]}

Globs: `**/` spans directories, `*` stays inside one path segment, and a pattern
without `/` matches the file name at any depth (like .gitignore). Paths are
matched relative to --root (default: the git toplevel of the current directory).

Ratchet: with --baseline FILE, only (rule, file) counts above the baseline
fail, so an already-common pattern can't grow. --update-baseline records
current counts for new rules and lowers counts that went down; it refuses to
raise a count (exit 1).

Inline exception, on the offending line or the line above it:
  # patlint: allow no-direct-json-write reason=legacy import expires=2026-12-31 approved-by=alice
reason, expires (YYYY-MM-DD), and approved-by are required. An expired or
incomplete exception fails.

Exit codes: 0 clean, 1 violations / expired or invalid exceptions / ratchet refused, 2 bad usage or rules.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

SKIP_DIRS = {".git", ".hg", ".svn", "node_modules", "__pycache__", ".venv", "venv", ".tox", ".mypy_cache",
             ".pytest_cache", ".ruff_cache", "dist", "build", ".next", "target", "vendor", "artifacts"}
MAX_BYTES = 2_000_000
ALLOW_RE = re.compile(r"patlint:\s*allow\s+([A-Za-z0-9][\w.,-]*)(.*)$")
COMMENT_ONLY = re.compile(r"^\s*(#|//|/\*|\*|--|<!--|;|%|\{#|\"\"\"|''')")
FIELD_RE = re.compile(r"(?<![\w-])(reason|expires|approved-by)=")
FIX_HINT = re.compile(r"`[^`]+`|\b\w+\(\)|\b[A-Za-z_]\w*\.[A-Za-z_]\w*|[\w-]+/[\w./-]+")
ID_RE = re.compile(r"[A-Za-z0-9][\w.-]*")


class RulesError(Exception):
    pass


# ---------------------------------------------------------------- rules

def glob_to_regex(pat: str) -> re.Pattern:
    pat = pat.strip()
    anchored = "/" in pat.rstrip("/")
    if pat.startswith("/"):
        pat = pat[1:]
    out, i = [], 0
    while i < len(pat):
        if pat.startswith("**/", i):
            out.append("(?:.*/)?")
            i += 3
        elif pat.startswith("**", i):
            out.append(".*")
            i += 2
        elif pat[i] == "*":
            out.append("[^/]*")
            i += 1
        elif pat[i] == "?":
            out.append("[^/]")
            i += 1
        elif pat[i] == "[":
            j = pat.find("]", i + 1)
            if j == -1:
                out.append(re.escape(pat[i]))
                i += 1
            else:
                cls = pat[i + 1:j]
                if cls.startswith("!"):
                    cls = "^" + cls[1:]
                out.append("[" + cls + "]")
                i = j + 1
        else:
            out.append(re.escape(pat[i]))
            i += 1
    body = "".join(out)
    if pat.endswith("/"):
        body += ".*"
    return re.compile(("^" if anchored else "^(?:.*/)?") + body + "$")


def names_fix(message: str) -> bool:
    return len(message.strip()) >= 10 and bool(FIX_HINT.search(message))


def load_rules(path: Path) -> list[dict]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        raise RulesError(f"cannot read rules file {path}: {e}")
    raw = data.get("rules") if isinstance(data, dict) else data
    if not isinstance(raw, list):
        raise RulesError(f"{path}: expected {{\"rules\": [...]}} or a list of rules")
    rules, errors, seen = [], [], set()
    for n, r in enumerate(raw):
        where = f"{path}: rule #{n + 1}"
        if not isinstance(r, dict):
            errors.append(f"{where}: must be an object")
            continue
        rid = r.get("id")
        if not isinstance(rid, str) or not ID_RE.fullmatch(rid):
            errors.append(f"{where}: `id` must match [A-Za-z0-9][\\w.-]*")
            continue
        where = f"{path}: rule {rid}"
        if rid in seen:
            errors.append(f"{where}: duplicate id")
        seen.add(rid)
        flags = re.I if r.get("ignore_case") else 0
        if r.get("multiline"):
            flags |= re.M | re.S
        try:
            rx = re.compile(r.get("regex") or "", flags)
            if not r.get("regex"):
                raise re.error("empty regex")
        except re.error as e:
            errors.append(f"{where}: bad regex: {e}")
            continue
        inc = r.get("include", ["**"])
        exc = r.get("exclude", [])
        if isinstance(inc, str):
            inc = [inc]
        if isinstance(exc, str):
            exc = [exc]
        if not inc or not all(isinstance(g, str) and g for g in inc + exc):
            errors.append(f"{where}: include/exclude must be non-empty glob strings")
            continue
        msg = r.get("message") or ""
        if not names_fix(msg):
            errors.append(f"{where}: message must name the fix (the file, function, or type to use instead, "
                          f"e.g. 'Use `store.save()` from todo/store.py'), got: {msg!r}")
            continue
        rules.append({"id": rid, "regex": rx, "include": [glob_to_regex(g) for g in inc],
                      "exclude": [glob_to_regex(g) for g in exc], "message": msg,
                      "multiline": bool(r.get("multiline")), "include_globs": inc, "exclude_globs": exc})
    if errors:
        raise RulesError("\n".join(errors))
    if not rules:
        raise RulesError(f"{path}: no rules")
    return rules


def applies(rule: dict, rel: str) -> bool:
    return any(g.match(rel) for g in rule["include"]) and not any(g.match(rel) for g in rule["exclude"])


# ---------------------------------------------------------------- files

def git(cwd: Path, *args: str, binary: bool = False):
    res = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True)
    if res.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {res.stderr.decode(errors='replace').strip()}")
    return res.stdout if binary else res.stdout.decode(errors="replace")


def git_toplevel(cwd: Path) -> Path | None:
    try:
        out = git(cwd, "rev-parse", "--show-toplevel").strip()
        return Path(out) if out else None
    except (RuntimeError, OSError):
        return None


def rel_to(root: Path, p: Path) -> str:
    try:
        return p.resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return p.as_posix()


def walk(paths: list[Path], root: Path):
    """Yield (rel_path, reader) for files under PATHS in the working tree."""
    seen = set()
    for p in paths:
        if not p.exists():
            raise FileNotFoundError(f"path not found: {p}")
        if p.is_file():
            cand = [p]
        else:
            cand = []
            for dirpath, dirnames, filenames in os.walk(p):
                dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
                cand.extend(Path(dirpath) / f for f in sorted(filenames))
        for f in cand:
            rel = rel_to(root, f)
            if rel in seen:
                continue
            seen.add(rel)
            yield rel, (lambda f=f: f.read_bytes())


def walk_rev(paths: list[Path], root: Path, rev: str):
    """Yield (rel_path, reader) for files under PATHS as of git revision REV."""
    top = git_toplevel(root)
    if top is None:
        raise RuntimeError(f"--rev needs a git repo; {root} is not inside one")
    rels = []
    for p in paths:
        ap = p if p.is_absolute() else (Path.cwd() / p)
        try:
            rels.append(ap.resolve().relative_to(top.resolve()).as_posix() or ".")
        except ValueError:
            rels.append(p.as_posix())
    names = git(top, "ls-tree", "-r", "--name-only", rev, "--", *rels).splitlines()
    if not names:
        raise RuntimeError(f"no files match {' '.join(rels)} at {rev}")
    for name in sorted(set(names)):
        yield name, (lambda name=name: git(top, "show", f"{rev}:{name}", binary=True))


# ---------------------------------------------------------------- linting

def parse_allow(line: str):
    m = ALLOW_RE.search(line)
    if not m:
        return None
    ids = [x for x in m.group(1).split(",") if x]
    rest = m.group(2)
    fields = {}
    marks = list(FIELD_RE.finditer(rest))
    for n, fm in enumerate(marks):
        end = marks[n + 1].start() if n + 1 < len(marks) else len(rest)
        val = rest[fm.end():end].strip()
        val = re.sub(r"\s*(\*/|-->|#}|%}|\"\"\"|''')\s*$", "", val).strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            val = val[1:-1]
        fields[fm.group(1)] = val
    return {"ids": ids, **fields}


def lint_text(rel: str, text: str, rules: list[dict], today: dt.date, report: dict) -> None:
    lines = text.splitlines()
    allows = {}
    for n, ln in enumerate(lines, 1):
        if "patlint:" in ln:
            a = parse_allow(ln)
            if a:
                a["standalone"] = bool(COMMENT_ONLY.match(ln))
                allows[n] = a
    used_allows = set()

    def exception_for(rule_id: str, lineno: int):
        a = allows.get(lineno)
        if a and rule_id in a["ids"]:
            return lineno, a
        a = allows.get(lineno - 1)  # a comment-only line directly above the violation
        if a and a["standalone"] and rule_id in a["ids"]:
            return lineno - 1, a
        return None, None

    for rule in rules:
        if not applies(rule, rel):
            continue
        if rule["multiline"]:
            hits = []
            for m in rule["regex"].finditer(text):
                lineno = text.count("\n", 0, m.start()) + 1
                col = m.start() - (text.rfind("\n", 0, m.start()) + 1) + 1
                hits.append((lineno, col))
        else:
            hits = [(n, m.start() + 1) for n, ln in enumerate(lines, 1) for m in rule["regex"].finditer(ln)]
        for lineno, col in hits:
            src = lines[lineno - 1].strip() if lineno - 1 < len(lines) else ""
            v = {"rule": rule["id"], "path": rel, "line": lineno, "col": col, "message": rule["message"],
                 "text": src[:200]}
            at, a = exception_for(rule["id"], lineno)
            if a is None:
                report["violations"].append(v)
                continue
            used_allows.add(at)
            missing = [k for k in ("reason", "expires", "approved-by") if not a.get(k)]
            if missing:
                v["exception"] = f"line {at}: missing {', '.join(missing)}"
                report["invalid_exceptions"].append(v)
                continue
            try:
                exp = dt.date.fromisoformat(a["expires"])
            except ValueError:
                v["exception"] = f"line {at}: expires must be YYYY-MM-DD, got {a['expires']!r}"
                report["invalid_exceptions"].append(v)
                continue
            v.update({"reason": a["reason"], "expires": a["expires"], "approved_by": a["approved-by"]})
            if exp < today:
                v["exception"] = f"line {at}: expired {a['expires']}"
                report["expired"].append(v)
            else:
                report["allowed"].append(v)
    for at, a in allows.items():
        if at not in used_allows:
            report["stale_exceptions"].append({"path": rel, "line": at, "ids": a["ids"]})


def load_baseline(path: Path | None) -> dict:
    if path is None or not path.is_file():
        return {}
    data = json.loads(path.read_text(encoding="utf-8"))
    return {r: dict(files) for r, files in (data.get("counts") or {}).items()}


def write_baseline(path: Path, counts: dict) -> None:
    clean = {r: dict(sorted((p, n) for p, n in files.items() if n > 0)) for r, files in sorted(counts.items())}
    clean = {r: f for r, f in clean.items() if f}
    path.write_text(json.dumps({"version": 1, "tool": "patlint",
                                "note": "Ratchet baseline: counts may only go down. Update with --update-baseline.",
                                "counts": clean}, indent=2) + "\n", encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="patlint.py",
        description="Deterministic pattern lint. Each rule: id, regex, include globs, and a message that names the fix. "
                    "Supports a ratchet baseline and inline exceptions with reason, expiry, and approver.",
        epilog="examples:\n"
               "  patlint.py --rules lint-rules.json src/\n"
               "  patlint.py --rules lint-rules.json --baseline .patlint-baseline.json --update-baseline .   # adopt\n"
               "  patlint.py --rules lint-rules.json --baseline .patlint-baseline.json .                     # CI\n"
               "  patlint.py --rules lint-rules.json --rev abc123^ todo/   # prove the rule fires on a past mistake\n\n"
               "inline exception (same line or the line above):\n"
               "  # patlint: allow RULE_ID reason=why expires=2026-12-31 approved-by=human\n\n"
               "exit: 0 clean, 1 violations/expired or invalid exceptions/ratchet refused, 2 usage or rules error",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("--rules", required=True, type=Path, help="rules JSON file")
    ap.add_argument("--baseline", type=Path, help="ratchet baseline JSON (fail only above recorded counts)")
    ap.add_argument("--update-baseline", action="store_true",
                    help="write the baseline: adopt new rules at current counts, lower counts that went down")
    ap.add_argument("--root", type=Path, help="directory globs are relative to (default: git toplevel, else cwd)")
    ap.add_argument("--rev", help="lint files as of this git revision instead of the working tree")
    ap.add_argument("--today", help="date for exception expiry checks (YYYY-MM-DD, default: today)")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--verbose", action="store_true", help="also list violations that are within the baseline")
    ap.add_argument("paths", nargs="+", type=Path, metavar="PATH", help="files or directories to lint")
    args = ap.parse_args(argv)

    if args.update_baseline and not args.baseline:
        print("patlint: --update-baseline needs --baseline FILE", file=sys.stderr)
        return 2
    try:
        rules = load_rules(args.rules)
    except RulesError as e:
        print(f"patlint: {e}", file=sys.stderr)
        return 2
    try:
        today = dt.date.fromisoformat(args.today) if args.today else dt.date.today()
    except ValueError:
        print("patlint: --today must be YYYY-MM-DD", file=sys.stderr)
        return 2
    root = (args.root or git_toplevel(Path.cwd()) or Path.cwd()).resolve()
    if args.rev:
        root = git_toplevel(root) or root

    report = {"violations": [], "allowed": [], "expired": [], "invalid_exceptions": [], "stale_exceptions": []}
    scanned = []
    try:
        files = walk_rev(args.paths, root, args.rev) if args.rev else walk(args.paths, root)
        for rel, read in files:
            if not any(applies(r, rel) for r in rules):
                continue
            data = read()
            if len(data) > MAX_BYTES or b"\0" in data[:8192]:
                continue
            scanned.append(rel)
            lint_text(rel, data.decode("utf-8", errors="replace"), rules, today, report)
    except (FileNotFoundError, RuntimeError) as e:
        print(f"patlint: {e}", file=sys.stderr)
        return 2

    counts: dict[str, dict[str, int]] = {}
    for v in report["violations"] + report["expired"] + report["invalid_exceptions"]:
        counts.setdefault(v["rule"], {})
        counts[v["rule"]][v["path"]] = counts[v["rule"]].get(v["path"], 0) + 1

    ratchet = args.baseline is not None
    baseline = load_baseline(args.baseline) if ratchet else {}
    over, improved, refused = [], [], []
    if ratchet:
        scanned_set = set(scanned)
        for rid, files in counts.items():
            for path, n in files.items():
                b = baseline.get(rid, {}).get(path, 0)
                if n > b:
                    over.append({"rule": rid, "path": path, "count": n, "baseline": b})
        for rid, files in baseline.items():
            for path, b in files.items():
                n = counts.get(rid, {}).get(path, 0)
                if path in scanned_set and n < b:
                    improved.append({"rule": rid, "path": path, "count": n, "baseline": b})

    if args.update_baseline:
        new = {r: dict(f) for r, f in baseline.items()}
        rule_ids = {r["id"] for r in rules}
        scanned_set = set(scanned)
        for rid in rule_ids:
            cur = counts.get(rid, {})
            if rid not in baseline:
                new[rid] = dict(cur)  # adopting a new rule at its current count
                continue
            for path in scanned_set:
                n, b = cur.get(path, 0), baseline[rid].get(path, 0)
                if n > b:
                    refused.append({"rule": rid, "path": path, "count": n, "baseline": b})
                else:
                    new[rid][path] = n
        new = {r: f for r, f in new.items() if r in rule_ids}
        write_baseline(args.baseline, new)
        over = [o for o in over if o["rule"] in baseline]  # adopted rules are not "over"

    over_keys = {(o["rule"], o["path"]) for o in over}
    if ratchet:
        failing = [v for v in report["violations"] if (v["rule"], v["path"]) in over_keys]
    else:
        failing = report["violations"]
    hard_fail = report["expired"] + report["invalid_exceptions"]
    ok = not failing and not hard_fail and not refused

    if args.json:
        print(json.dumps({"ok": ok, "rules": [r["id"] for r in rules], "files_scanned": len(scanned),
                          "rev": args.rev, "root": str(root), "failing": failing, **report,
                          "baseline": {"path": str(args.baseline) if args.baseline else None, "over": over,
                                       "improved": improved, "refused": refused,
                                       "updated": bool(args.update_baseline)}}, indent=2))
        return 0 if ok else 1

    shown = report["violations"] if (args.verbose or not ratchet) else failing
    for v in shown:
        print(f"{v['path']}:{v['line']}:{v['col']}: {v['rule']}: {v['message']}")
        print(f"    | {v['text']}")
    for v in report["expired"]:
        print(f"{v['path']}:{v['line']}: {v['rule']}: exception {v['exception']} (approved by {v['approved_by']}). "
              f"Fix the violation or get a human to renew it.")
    for v in report["invalid_exceptions"]:
        print(f"{v['path']}:{v['line']}: {v['rule']}: invalid exception, {v['exception']}. "
              f"Format: patlint: allow {v['rule']} reason=... expires=YYYY-MM-DD approved-by=...")
    for o in over:
        print(f"ratchet: {o['rule']} in {o['path']}: {o['count']} found, baseline {o['baseline']}")
    for r in refused:
        print(f"ratchet: refused to raise {r['rule']} in {r['path']} from {r['baseline']} to {r['count']}; fix the new violations")
    for s in report["stale_exceptions"]:
        print(f"note: {s['path']}:{s['line']}: exception for {','.join(s['ids'])} matches nothing; delete it")
    for i in improved:
        print(f"note: {i['rule']} in {i['path']} went {i['baseline']} -> {i['count']}; lock it in with --update-baseline")
    if ratchet and not args.update_baseline and not args.baseline.is_file():
        print(f"note: baseline {args.baseline} does not exist, so every violation counts as new; "
              f"adopt current counts with --update-baseline")
    status = "PASS" if ok else "FAIL"
    within = len(report["violations"]) - len(failing)
    extra = f", {within} within baseline" if ratchet else ""
    print(f"patlint: {status}: {len(failing)} failing violation(s){extra}, {len(report['allowed'])} allowed, "
          f"{len(report['expired'])} expired, {len(report['invalid_exceptions'])} invalid exception(s); "
          f"{len(scanned)} file(s), {len(rules)} rule(s)" + (f" @ {args.rev}" if args.rev else "")
          + (f"; baseline written to {args.baseline}" if args.update_baseline else ""))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Check or extend the `| Rule | Enforced by |` table in an agent instruction file.

  rule_table.py check AGENTS.md [--json]
  rule_table.py add AGENTS.md --rule TEXT --enforced-by TEXT

`check` flags every row whose enforcement is prose only (docs, AGENTS.md, "code
review", empty) and every row that names an enforcer file that does not exist.
Nothing fails when an agent skips prose, so a flagged rule that gets broken again
is a repeat: fix it higher up (architecture > types > lint that names the fix >
test). Exit 0 when every row is enforced by something that runs, 1 otherwise,
2 on usage errors.

`add` appends a row to the first rule table (creating a `## Rules` section if the
file has none) and prints how the new row classifies.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

NONE_VALUES = {"", "-", "--", "—", "–", "none", "n/a", "na", "nothing", "tbd", "todo", "?", "nobody"}

# Words that name something that runs and fails. Matched case-insensitively.
CHECK_WORDS = re.compile(
    r"\b(lint(?:er|s|ed|ing)?|eslint|ruff|flake8|pylint|mypy|pyright|tsc|clippy|"
    r"typecheck(?:er|ing)?|types?|typed|enum|newtype|tests?|unittest|pytest|jest|vitest|"
    r"go test|cargo test|ci|pre-commit|git hook|hook|schema|compiler|compile[sd]?|patlint|"
    r"import-linter|codemod|assert(?:ion)?s?|runtime check|architecture|module boundary|"
    r"private module|bounded_check|tla\+|model[- ]check(?:er)?|kani|verify-[\w-]+|check_[\w]+)\b",
    re.I,
)
# Words that only describe a human or an agent remembering to do something.
PROSE_WORDS = re.compile(
    r"\b(prose|docs?|documentation|agents\.md|claude\.md|readme|wiki|guidelines?|conventions?|"
    r"code review|reviews?|reviewers?|manual(?:ly)?|honou?r system|agent rules?|this file|"
    r"comments?|memory|instructions?|skills?|reminders?|by hand)\b",
    re.I,
)
CODE_SPAN = re.compile(r"`([^`]+)`")
PATHLIKE = re.compile(r"^(?:\./)?[\w.@-]+(?:/[\w.@-]+)*\.(?:py|sh|bash|js|mjs|cjs|ts|tsx|go|rs|rb|java|kt|json|toml|ya?ml|cfg|ini)$")
TOOL_PREFIX = re.compile(r"^(python3?|node|npx|npm|pnpm|yarn|make|go|cargo|bash|sh|\./|uv|tox|nox|pytest|ruff|mypy|tsc|eslint)\b")


def split_row(line: str) -> list[str]:
    """Split a markdown table row on unescaped pipes outside code spans."""
    cells, buf, in_code, i = [], [], False, 0
    s = line.strip()
    while i < len(s):
        ch = s[i]
        if ch == "\\" and i + 1 < len(s) and s[i + 1] == "|":
            buf.append("|")
            i += 2
            continue
        if ch == "`":
            in_code = not in_code
        if ch == "|" and not in_code:
            cells.append("".join(buf).strip())
            buf = []
        else:
            buf.append(ch)
        i += 1
    cells.append("".join(buf).strip())
    if cells and cells[0] == "" and s.startswith("|"):
        cells = cells[1:]
    if cells and cells[-1] == "" and s.endswith("|"):
        cells = cells[:-1]
    return cells


def is_separator(line: str) -> bool:
    cells = split_row(line)
    return bool(cells) and all(re.fullmatch(r":?-{3,}:?", c.replace(" ", "")) for c in cells)


def find_tables(lines: list[str]) -> list[dict]:
    """Return every table whose header has a Rule column and an Enforced-by column."""
    tables = []
    i = 0
    while i < len(lines) - 1:
        line = lines[i]
        if line.lstrip().startswith("|") and is_separator(lines[i + 1]):
            header = [c.lower() for c in split_row(line)]
            rule_idx = next((k for k, c in enumerate(header) if re.match(r"^rules?\b", c)), None)
            enf_idx = next((k for k, c in enumerate(header) if "enforc" in c), None)
            j = i + 2
            rows = []
            while j < len(lines) and lines[j].lstrip().startswith("|"):
                rows.append((j + 1, split_row(lines[j])))
                j += 1
            if rule_idx is not None and enf_idx is not None:
                tables.append({"header_line": i + 1, "last_line": j, "rule_idx": rule_idx,
                               "enf_idx": enf_idx, "ncols": len(header), "rows": rows})
            i = j
            continue
        i += 1
    return tables


def git_toplevel(path: Path) -> Path | None:
    try:
        out = subprocess.run(["git", "-C", str(path), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, check=True).stdout.strip()
        return Path(out) if out else None
    except (OSError, subprocess.CalledProcessError):
        return None


def referenced_paths(text: str) -> list[str]:
    """Path-like tokens inside code spans, including script paths inside commands."""
    found = []
    for span in CODE_SPAN.findall(text):
        for tok in span.split():
            tok = tok.strip("'\"(),;")
            if PATHLIKE.match(tok) or ("/" in tok and PATHLIKE.match(tok.split("::")[0])):
                found.append(tok.split("::")[0])
    return found


def classify(enforced_by: str, bases: list[Path]) -> tuple[str, str]:
    """Return (status, reason). status is enforced | prose | none | missing-enforcer."""
    text = enforced_by.strip()
    if text.strip("`*_ ").lower() in NONE_VALUES:
        return "none", "nothing enforces this rule"
    paths = referenced_paths(text)
    missing = [p for p in paths if not any((b / p).exists() for b in bases)]
    if missing:
        return "missing-enforcer", "enforcer not found: " + ", ".join(missing)
    spans = CODE_SPAN.findall(text)
    runnable_span = any(TOOL_PREFIX.match(s.strip()) or PATHLIKE.match(s.strip()) for s in spans)
    if paths or runnable_span or CHECK_WORDS.search(text):
        return "enforced", "names a check that runs" if not paths else "runs " + ", ".join(paths)
    if PROSE_WORDS.search(text):
        return "prose", "enforced only by prose or human attention"
    return "prose", "names no check that runs (lint, type, test, CI, script)"


def check(path: Path) -> dict:
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    tables = find_tables(lines)
    bases = [path.parent.resolve()]
    top = git_toplevel(path.parent.resolve())
    if top and top not in bases:
        bases.append(top)
    rows = []
    for t in tables:
        for lineno, cells in t["rows"]:
            if len(cells) <= max(t["rule_idx"], t["enf_idx"]):
                cells = cells + [""] * (max(t["rule_idx"], t["enf_idx"]) + 1 - len(cells))
            rule = cells[t["rule_idx"]]
            enf = cells[t["enf_idx"]]
            if not rule.strip():
                continue
            status, reason = classify(enf, bases)
            rows.append({"line": lineno, "rule": rule, "enforced_by": enf, "status": status, "reason": reason})
    flagged = [r for r in rows if r["status"] != "enforced"]
    return {"file": str(path), "tables": len(tables), "rules": rows, "flagged": len(flagged),
            "ok": bool(tables) and not flagged}


def escape_cell(text: str) -> str:
    return text.replace("|", "\\|").replace("\n", " ").strip()


def add(path: Path, rule: str, enforced_by: str) -> dict:
    row = f"| {escape_cell(rule)} | {escape_cell(enforced_by)} |"
    if path.exists():
        lines = path.read_text(encoding="utf-8").splitlines()
    else:
        lines = [f"# {path.stem}", ""]
    tables = find_tables(lines)
    if tables:
        t = tables[0]
        cells = [""] * t["ncols"]
        cells[t["rule_idx"]] = escape_cell(rule)
        cells[t["enf_idx"]] = escape_cell(enforced_by)
        row = "| " + " | ".join(cells) + " |"
        lines.insert(t["last_line"], row)
    else:
        if lines and lines[-1].strip():
            lines.append("")
        lines += ["## Rules", "", "| Rule | Enforced by |", "|---|---|", row]
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    bases = [path.parent.resolve()]
    top = git_toplevel(path.parent.resolve())
    if top:
        bases.append(top)
    status, reason = classify(enforced_by, bases)
    return {"file": str(path), "row": row, "status": status, "reason": reason}


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="rule_table.py",
        description="Check or extend the `| Rule | Enforced by |` table in AGENTS.md (or CLAUDE.md). "
                    "`check` exits 1 when a rule is enforced only by prose or names an enforcer that does not exist.",
        epilog="examples:\n"
               "  rule_table.py check AGENTS.md\n"
               "  rule_table.py check AGENTS.md --json\n"
               "  rule_table.py add AGENTS.md --rule 'Write todos only through store.save()' \\\n"
               "      --enforced-by '`python3 scripts/patlint.py --rules lint-rules.json todo/`'\n\n"
               "Enforced: names a lint, type, test, CI job, hook, schema, or an existing script/test file in backticks.\n"
               "Flagged:  prose, docs, AGENTS.md, code review, empty, or a backticked path that does not exist.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check", help="flag rules enforced only by prose (exit 1 if any)")
    c.add_argument("file", type=Path, help="agent instruction file, e.g. AGENTS.md")
    c.add_argument("--json", action="store_true", help="machine-readable output")
    a = sub.add_parser("add", help="append a row to the rule table")
    a.add_argument("file", type=Path)
    a.add_argument("--rule", required=True, help="the rule, phrased as what to do")
    a.add_argument("--enforced-by", required=True, help="what fails when the rule is broken (command, test, lint id)")
    a.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    if args.cmd == "check":
        if not args.file.is_file():
            print(f"rule_table: {args.file} not found. Create it with `rule_table.py add {args.file} --rule ... --enforced-by ...`.",
                  file=sys.stderr)
            return 2
        res = check(args.file)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            if not res["tables"]:
                print(f"{args.file}: no `| Rule | Enforced by |` table. Add one: every rule paired with the check that fails when it is broken.")
            else:
                print(f"{args.file}: {len(res['rules'])} rules, {res['flagged']} flagged")
                for r in res["rules"]:
                    tag = {"enforced": "OK", "prose": "PROSE", "none": "NONE", "missing-enforcer": "MISSING"}[r["status"]]
                    print(f"  {tag:<8} line {r['line']:<4} {r['rule'][:70]}")
                    if r["status"] != "enforced":
                        print(f"           enforced by: {r['enforced_by'] or '(empty)'} -> {r['reason']}")
                if res["flagged"]:
                    print("FAIL: move each flagged rule up the pyramid (architecture > types > lint that names the fix > test), "
                          "then name that check in the Enforced by column. Drop rules whose mistake can no longer happen.")
                else:
                    print("PASS: every rule names a check that runs.")
        return 0 if res["ok"] else 1

    res = add(args.file, args.rule, args.enforced_by)
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        print(f"added to {res['file']}: {res['row']}")
        if res["status"] != "enforced":
            print(f"warning: {res['status']}: {res['reason']}. This rule will fail `rule_table.py check`.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Find drift between a verify-<app> skill's feature map and the app's source.

  drift_check.py SKILL_DIR --repo REPO [--json]

Reports, and exits 1 if any are found:
  index     features/README.md hygiene: missing (feature file not indexed), dead (link to nothing),
            duplicate, extra (links to a non-feature file)
  contract  feature files without exactly the four H2s in order
  routes    missing: HTTP routes in source that no feature file mentions
            dead:    `METHOD /path` mentions in the map that match no route in source
  commands  missing: CLI subcommands in source that no feature file mentions
            dead:    `<prog> <subcommand>` mentions in the map that the source does not define

Health routes and launch commands (serve/--port) count as covered when SKILL.md or
scripts/ mention them (Launch and Doctor use them; they are not user features).
Mentions are read from `METHOD /path` text, curl command lines, `control.sh drive ... http
METHOD PATH`, and code spans or fenced blocks that invoke the CLI.

Source routes and commands come from create-verification-skill/scripts/scan_repo.py, so
this tool needs that skill installed next to this one. A clean result is not a clean
pass: the live pass in SKILL.md is still required.
"""
from __future__ import annotations

import argparse
import json
import re
import shlex
import sys
from pathlib import Path


def sibling_scripts() -> Path:
    here = Path(__file__)
    for base in (here.resolve().parent, here.parent):
        cand = base.parent.parent / "create-verification-skill" / "scripts"
        if (cand / "scan_repo.py").is_file() and (cand / "check_verify_skill.py").is_file():
            return cand
    sys.exit("drift_check: needs the create-verification-skill skill installed next to this one "
             "(skills/create-verification-skill/scripts/scan_repo.py). Run install.sh from poteto-skills.")


sys.dont_write_bytecode = True  # importing the sibling skill must not leave __pycache__ behind
sys.path.insert(0, str(sibling_scripts()))
import check_verify_skill as cvs  # noqa: E402
import scan_repo  # noqa: E402

METHOD_PATH = re.compile(r"(?<![\w/])(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\s+(/[\w\-./<>{}:*$~%]*)")
CURL_METHOD = re.compile(r"(?:-X|--request)\s*['\"]?([A-Za-z]+)")
URL = re.compile(r"https?://[^\s'\"`]+")


def code_lines(text: str) -> list[tuple[int, str]]:
    """(line, code) for inline code spans and fenced code lines."""
    out, fence = [], False
    for n, line in enumerate(text.splitlines(), 1):
        if re.match(r"^\s*(```|~~~)", line):
            fence = not fence
            continue
        if fence:
            out.append((n, line))
            continue
        out.extend((n, m.group(1)) for m in re.finditer(r"`([^`]+)`", line))
    return out


def norm_mention(path: str) -> str:
    path = path.split("?", 1)[0].rstrip(".,;:)'\"")
    path = re.sub(r"\$\{?(\w+)\}?", r"<\1>", path)
    path = re.sub(r"\{(\w+)\}", r"<\1>", path)
    path = re.sub(r"(?<=/):(\w+)", r"<\1>", path)
    if len(path) > 1:
        path = path.rstrip("/")
    return path or "/"


def route_mentions(text: str) -> list[tuple[str, str, int]]:
    """(METHOD, path, line) found in prose, code, curl lines, and control.sh drive lines."""
    found = []
    for n, line in enumerate(text.splitlines(), 1):
        for m in METHOD_PATH.finditer(line):
            found.append((m.group(1), norm_mention(m.group(2)), n))
    for n, code in code_lines(text):
        if not re.search(r"\bcurl\b", code):
            continue
        u = URL.search(code)
        if not u:
            continue
        method = CURL_METHOD.search(code)
        meth = method.group(1).upper() if method else ("POST" if re.search(r"\s(-d|--data\S*|--json)\b", code) else "GET")
        path = re.sub(r"^https?://[^/]+", "", u.group(0)) or "/"
        found.append((meth, norm_mention(path), n))
    return found


def split_tokens(code: str) -> list[str]:
    try:
        return shlex.split(code)
    except ValueError:
        return code.split()


def prog_tokens(prog: str) -> list[str]:
    toks = split_tokens(prog)
    while toks and re.fullmatch(r"[A-Z_][A-Z0-9_]*=.*", toks[0]):
        toks = toks[1:]  # PYTHONPATH=src python3 -m pkg
    return toks


def command_mentions(text: str, progs: dict[str, dict]) -> list[tuple[str, str, int]]:
    """(prog, subcommand, line) for each CLI invocation in code spans and fences."""
    found = []
    for n, code in code_lines(text):
        toks = split_tokens(code)
        for prog, info in progs.items():
            for seq in info["seqs"]:
                k = len(seq)
                for i in range(len(toks) - k + 1):
                    if toks[i:i + k] != seq:
                        continue
                    j = i + k
                    while j < len(toks) and toks[j].startswith("-"):
                        flag = toks[j]
                        j += 1 if ("=" in flag or flag not in info["value_flags"]) else 2
                    if j < len(toks) and re.fullmatch(r"[a-z][\w:-]*", toks[j]):
                        found.append((prog, toks[j], n))
    return found


def drift(skill: Path, repo: Path) -> dict:
    inv = scan_repo.scan(repo)
    fdir = skill / "features"
    feats = cvs.feature_files(skill)
    feat_texts = {p.name: p.read_text(encoding="utf-8", errors="replace") for p in feats}
    readme = fdir / "README.md"
    readme_text = readme.read_text(encoding="utf-8", errors="replace") if readme.is_file() else ""
    infra_text = ""
    for p in [skill / "SKILL.md", *sorted((skill / "scripts").rglob("*") if (skill / "scripts").is_dir() else [])]:
        if p.is_file():
            infra_text += p.read_text(encoding="utf-8", errors="replace") + "\n"

    res = {"skill_dir": str(skill), "repo": str(repo), "index": cvs.index_report(skill), "contract": [],
           "routes": {"source": len(inv["http_routes"]), "missing": [], "dead": []},
           "commands": {"source": len(inv["cli_commands"]), "missing": [], "dead": []},
           "unanchored_features": [], "notes": []}
    if not readme.is_file():
        res["index"]["missing_readme"] = True
    for name, text in feat_texts.items():
        errs = cvs.h2_contract_errors(text)
        if errs:
            res["contract"].append({"file": f"features/{name}", "errors": errs})

    # ---- routes
    src_routes = [(r, scan_repo.route_regex(r["path"])) for r in inv["http_routes"]]

    def matches(method: str, path: str) -> list[dict]:
        return [r for r, rx in src_routes if (r["method"] in (method, "ANY") or method == "ANY") and rx.match(path)]

    feat_mentions = {name: route_mentions(t) for name, t in feat_texts.items()}
    infra_mentions = route_mentions(infra_text)
    covered = set()
    for name, ms in feat_mentions.items():
        for meth, path, _ in ms:
            for r in matches(meth, path):
                covered.add(id(r))
    for meth, path, _ in infra_mentions:
        for r in matches(meth, path):
            if r.get("health"):
                covered.add(id(r))
    for r, _ in src_routes:
        if id(r) not in covered and not (r.get("health") and r["path"] in infra_text):
            res["routes"]["missing"].append({"method": r["method"], "path": r["path"], "source": r["source"]})
    for where, text in [*((f"features/{k}", v) for k, v in feat_texts.items()), ("features/README.md", readme_text)]:
        for meth, path, line in route_mentions(text):
            if meth in ("HEAD", "OPTIONS") or not src_routes:
                continue
            if not matches(meth, path):
                res["routes"]["dead"].append({"method": meth, "path": path, "where": f"{where}:{line}"})

    # ---- commands
    progs: dict[str, dict] = {}
    for c in inv["cli_commands"]:
        if c["prog"].startswith("TODO"):
            continue
        p = progs.setdefault(c["prog"], {"subs": set(), "seqs": [], "value_flags": set()})
        p["subs"].add(c["name"])
        p["subs"].update(c.get("aliases_sub", []))
        for o in c.get("options", []) + c.get("global_options", []):
            if not o["positional"] and not isinstance(o.get("default"), bool):
                p["value_flags"].update(n for n in o["names"] if n.startswith("-"))
        for inv_ in [c["prog"], *c.get("aliases", [])]:
            seq = prog_tokens(inv_)
            if seq and seq not in p["seqs"]:
                p["seqs"].append(seq)
    launch_subs = {(c["prog"], c["name"]) for c in inv["cli_commands"] if c.get("launch")}
    feat_cmds = {name: command_mentions(t, progs) for name, t in feat_texts.items()}
    infra_cmds = command_mentions(infra_text, progs) + [
        (prog, sub, 0) for prog, info in progs.items() for sub in info["subs"]
        if (prog, sub) in launch_subs and re.search(rf"\b{re.escape(sub)}\b", infra_text)]
    mentioned = {(p, s) for ms in feat_cmds.values() for p, s, _ in ms}
    mentioned_infra = {(p, s) for p, s, _ in infra_cmds}
    for c in inv["cli_commands"]:
        key = (c["prog"], c["name"])
        if c["prog"].startswith("TODO") or c["name"] in scan_repo.SKIP_COMMANDS:
            continue
        if key in mentioned or (key in launch_subs and key in mentioned_infra):
            continue
        res["commands"]["missing"].append({"prog": c["prog"], "name": c["name"], "source": c["source"],
                                           "launch": bool(c.get("launch"))})
    for where, text in [*((f"features/{k}", v) for k, v in feat_texts.items()), ("features/README.md", readme_text)]:
        for prog, sub, line in command_mentions(text, progs):
            if sub not in progs[prog]["subs"] and sub not in ("help",):
                res["commands"]["dead"].append({"prog": prog, "name": sub, "where": f"{where}:{line}"})

    for name in feat_texts:
        if not feat_mentions[name] and not feat_cmds[name]:
            res["unanchored_features"].append(f"features/{name}")
    if not inv["http_routes"] and not inv["cli_commands"]:
        res["notes"].append("no routes or CLI commands detected in source; drift is limited to index and contract, "
                            "so the live pass carries the whole check")
    idx = res["index"]
    res["drift"] = bool(any(idx.get(k) for k in ("missing", "dead", "duplicate", "extra", "missing_readme"))
                        or res["contract"] or res["routes"]["missing"] or res["routes"]["dead"]
                        or res["commands"]["missing"] or res["commands"]["dead"])
    return res


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="drift_check.py",
        description="Compare a verify-<app> skill's feature map with the app's source: index hygiene, the four-H2 "
                    "contract, routes and CLI commands missing from the map, and map entries the source no longer "
                    "has. Exit 1 on drift.",
        epilog="examples:\n"
               "  drift_check.py .claude/skills/verify-todo --repo .\n"
               "  drift_check.py .cursor/skills/verify-shop --repo . --json\n\n"
               "A clean result does not replace the live pass: drive every feature anyway.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("skill_dir", type=Path, help="the verify-<app> skill directory")
    ap.add_argument("--repo", required=True, type=Path, help="the app's repository root")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args(argv)
    if not args.skill_dir.is_dir():
        print(f"drift_check: {args.skill_dir} is not a directory", file=sys.stderr)
        return 2
    if not args.repo.is_dir():
        print(f"drift_check: --repo {args.repo} is not a directory", file=sys.stderr)
        return 2
    res = drift(args.skill_dir.resolve(), args.repo.resolve())
    if args.json:
        print(json.dumps(res, indent=2))
        return 1 if res["drift"] else 0
    idx = res["index"]
    for k in ("missing", "dead", "duplicate", "extra"):
        for v in idx.get(k, []):
            print(f"index {k}: {v}")
    if idx.get("missing_readme"):
        print("index missing: features/README.md does not exist")
    for c in res["contract"]:
        print(f"contract: {c['file']}: {'; '.join(c['errors'])}")
    for r in res["routes"]["missing"]:
        print(f"route missing from map: {r['method']} {r['path']}  (source {r['source']})")
    for r in res["routes"]["dead"]:
        print(f"route dead in map: {r['method']} {r['path']}  ({r['where']})")
    for c in res["commands"]["missing"]:
        print(f"command missing from map: {c['prog']} {c['name']}  (source {c['source']})")
    for c in res["commands"]["dead"]:
        print(f"command dead in map: {c['prog']} {c['name']}  ({c['where']})")
    for f in res["unanchored_features"]:
        print(f"note: {f} mentions no route or command; check it in the live pass")
    for n in res["notes"]:
        print(f"note: {n}")
    print(f"drift_check: {'DRIFT' if res['drift'] else 'clean'} ({res['routes']['source']} routes, "
          f"{res['commands']['source']} commands in source) {args.skill_dir}")
    return 1 if res["drift"] else 0


if __name__ == "__main__":
    sys.exit(main())

