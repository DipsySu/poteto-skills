# ---------------------------------------------------------------- files

def list_files(repo: Path, max_files: int = 20000) -> list[str]:
    files: list[str] = []
    try:
        out = subprocess.run(["git", "-C", str(repo), "ls-files", "-co", "--exclude-standard", "-z"],
                             capture_output=True, check=True).stdout
        files = [f for f in out.decode(errors="replace").split("\0") if f]
        if not files:
            raise RuntimeError("empty")
    except (OSError, subprocess.CalledProcessError, RuntimeError):
        for dirpath, dirnames, filenames in os.walk(repo):
            dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
            rel = Path(dirpath).relative_to(repo).as_posix()
            for f in sorted(filenames):
                files.append(f if rel == "." else f"{rel}/{f}")
    files = [f for f in files if not any(p in SKIP_DIRS for p in f.split("/")[:-1]) and (repo / f).is_file()]
    return sorted(files)[:max_files]


def read(repo: Path, rel: str, limit: int = 1_000_000) -> str:
    p = repo / rel
    try:
        if p.stat().st_size > limit:
            return ""
        return p.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def line_of(text: str, pos: int) -> int:
    return text.count("\n", 0, pos) + 1


# ---------------------------------------------------------------- routes

def normalize_route(s: str, kind: str = "eq") -> str | None:
    s = s.strip()
    if kind == "regex" or re.search(r"[\^$()\[\]\\+?|]", s):
        s = re.sub(r"^(\^|\\A)", "", s)
        s = re.sub(r"(/\?)?(\$|\\Z|\\z)$", "", s)
        s = re.sub(r"\(\?P<(\w+)>[^)]*\)", r"<\1>", s)
        s = re.sub(r"\((?!\?)[^)]*\)", "<id>", s)
        s = re.sub(r"\[\^/\]\+|\\d\+|\\w\+|\[0-9\]\+|\[\\w-\]\+|\.\+|\.\*", "<id>", s)
        s = s.replace("\\/", "/").replace("\\.", ".").replace("\\-", "-")
        if re.search(r"[\^$()\[\]\\+?|]", s):
            return None
    s = re.sub(r"<(?:\w+:)?(\w+)>", r"<\1>", s)          # Flask <int:id>
    s = re.sub(r"\{(\w+)(?::[^}]*)?\}", r"<\1>", s)        # FastAPI/Go {id}
    s = re.sub(r"(?<=/):(\w+)", r"<\1>", s)                # Express :id
    if not s.startswith("/") or not re.fullmatch(r"/[\w\-./<>*~]*", s) or FS_PREFIX.match(s):
        return None
    if "." in s.rsplit("/", 1)[-1] and not s.endswith((".json", ".html", ".txt", ".ico", ".xml")):
        return None  # looks like a file path, not a route
    if len(s) > 1:
        s = s.rstrip("/") or "/"
    return s


def route_key(method: str, path: str) -> tuple[str, str]:
    return method.upper(), re.sub(r"<[^>]*>", "<>", path)


def route_regex(path: str) -> re.Pattern:
    """Match concrete or templated paths against a route; <*> spans segments, <x> one segment."""
    out, i = [], 0
    for m in re.finditer(r"<[^>]*>", path):
        out.append(re.escape(path[i:m.start()]))
        out.append(".+" if m.group(0) == "<*>" else "[^/]+")
        i = m.end()
    out.append(re.escape(path[i:]))
    return re.compile("^" + "".join(out) + "/?$")


def is_health(path: str) -> bool:
    last = [seg for seg in path.strip("/").split("/") if seg and not seg.startswith("<")]
    return bool(last) and last[-1].lower() in HEALTH_NAMES and len(last) <= 2


# ---------------------------------------------------------------- python

def _parents(tree: ast.AST) -> None:
    for node in ast.walk(tree):
        for child in ast.iter_child_nodes(node):
            child._parent = node  # type: ignore[attr-defined]


def _call_name(call: ast.Call) -> str | None:
    f = call.func
    if isinstance(f, ast.Attribute):
        return f.attr
    if isinstance(f, ast.Name):
        return f.id
    return None


def _str(node) -> str | None:
    return node.value if isinstance(node, ast.Constant) and isinstance(node.value, str) else None


def _literal(node):
    try:
        return ast.literal_eval(node)
    except Exception:  # noqa: BLE001 - any non-literal
        return None


def _methods_in(node) -> list[str]:
    out = []
    for n in ast.walk(node):
        s = _str(n)
        if s in HTTP_METHODS and isinstance(getattr(n, "_parent", None),
                                            (ast.Compare, ast.Tuple, ast.List, ast.Set, ast.MatchValue)):
            out.append(s)
    return sorted(set(out), key=HTTP_METHODS.index)


def _method_context(node) -> list[str]:
    child, cur = node, getattr(node, "_parent", None)
    while cur is not None:
        if isinstance(cur, ast.If) and not any(child is c for c in cur.orelse):
            ms = _methods_in(cur.test)
            if ms:
                return ms
        if isinstance(cur, ast.match_case):
            ms = _methods_in(cur.pattern)
            if ms:
                return ms
        if isinstance(cur, (ast.FunctionDef, ast.AsyncFunctionDef)):
            m = re.fullmatch(r"do_([A-Z]+)", cur.name)
            return [m.group(1)] if m and m.group(1) in HTTP_METHODS else []
        child, cur = cur, getattr(cur, "_parent", None)
    return []


def _usage(node) -> str | None:
    p = getattr(node, "_parent", None)
    if isinstance(p, ast.Call):
        if node is p.func:
            return None
        name = _call_name(p)
        if name == "startswith":
            return "prefix"
        if name == "endswith":
            return "suffix"
        if name in RE_FUNCS:
            return "regex"
        if name in SKIP_CALLS:
            return None
        return "eq"
    if isinstance(p, (ast.Compare, ast.Tuple, ast.List, ast.Set, ast.Dict, ast.MatchValue)):
        return "eq"
    return None


def _enclosing_boolop(node):
    cur = getattr(node, "_parent", None)
    while cur is not None and not isinstance(cur, ast.stmt):
        if isinstance(cur, ast.BoolOp) and isinstance(cur.op, ast.And):
            top = cur
            nxt = getattr(cur, "_parent", None)
            while isinstance(nxt, ast.BoolOp) and isinstance(nxt.op, ast.And):
                top, nxt = nxt, getattr(nxt, "_parent", None)
            return top
        cur = getattr(cur, "_parent", None)
    return None


def _segment_route(test: ast.AST) -> str | None:
    """`parts == ["todos"]` or `len(parts) == 3 and parts[0] == "todos" and parts[2] == "done"`."""
    segs: dict[int, str] = {}
    length = None
    conds = test.values if isinstance(test, ast.BoolOp) and isinstance(test.op, ast.And) else [test]
    for c in conds:
        if not (isinstance(c, ast.Compare) and len(c.ops) == 1 and isinstance(c.ops[0], ast.Eq)):
            continue
        left, right = c.left, c.comparators[0]
        lit = _literal(right)
        if isinstance(lit, list | tuple) and lit and all(isinstance(x, str) for x in lit) and isinstance(left, ast.Name):
            if all(re.fullmatch(r"[\w.-]+", x) for x in lit):
                return "/" + "/".join(lit)
        if isinstance(left, ast.Subscript) and isinstance(right, ast.Constant) and isinstance(right.value, str):
            idx = _literal(left.slice)
            if isinstance(idx, int) and idx >= 0 and re.fullmatch(r"[\w.-]+", right.value):
                segs[idx] = right.value
        if (isinstance(left, ast.Call) and _call_name(left) == "len" and isinstance(right, ast.Constant)
                and isinstance(right.value, int)):
            length = right.value
    if not segs or 0 not in segs:
        return None
    n = length or (max(segs) + 1)
    return "/" + "/".join(segs.get(i, "<id>") for i in range(n))


def _body_keys(fn) -> list[str]:
    """JSON body fields a handler reads: body = json.loads(...); body.get("title") / body["title"] / request.json[...]."""
    names = set()
    for n in ast.walk(fn):
        if isinstance(n, ast.Assign) and isinstance(n.value, ast.Call) and _call_name(n.value) in ("loads", "load", "get_json"):
            names.update(t.id for t in n.targets if isinstance(t, ast.Name))

    def is_body(base) -> bool:
        return (isinstance(base, ast.Name) and base.id in names) or (isinstance(base, ast.Attribute) and base.attr == "json")

    keys: list[str] = []
    for n in ast.walk(fn):
        k = None
        if isinstance(n, ast.Call) and _call_name(n) == "get" and isinstance(n.func, ast.Attribute) and is_body(n.func.value):
            k = _str(n.args[0]) if n.args else None
        elif isinstance(n, ast.Subscript) and is_body(n.value):
            k = _str(n.slice)
        if k and re.fullmatch(r"[A-Za-z_][\w-]*", k) and k not in keys:
            keys.append(k)
    return keys


def analyze_python(rel: str, text: str) -> dict:
    info = {"routes": [], "subcommands": [], "parser_options": {}, "ports": [], "env": [], "main_guard": False,
            "server": bool(SERVER_HINT.search(text)), "imports": set(), "notes": []}
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError) as e:
        info["notes"].append(f"{rel}: not parsed ({e.__class__.__name__})")
        return info
    _parents(tree)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            info["imports"].update(a.name for a in node.names)
        elif isinstance(node, ast.ImportFrom) and node.module:
            info["imports"].add(node.module)
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and re.fullmatch(r"do_[A-Z]+", node.name):
            info["server"] = True

    def add_route(method: str, path: str | None, node, how: str, body: list[str] | None = None) -> None:
        if path:
            r = {"method": method, "path": path, "source": f"{rel}:{getattr(node, 'lineno', 0)}", "how": how}
            if body and method in ("POST", "PUT", "PATCH", "ANY"):
                r["body_keys"] = body
            info["routes"].append(r)

    for node in ast.walk(tree):
        # main guard
        if isinstance(node, ast.If) and isinstance(getattr(node, "_parent", None), ast.Module):
            t = node.test
            if (isinstance(t, ast.Compare) and isinstance(t.left, ast.Name) and t.left.id == "__name__"
                    and any(_str(c) == "__main__" for c in t.comparators)):
                info["main_guard"] = True
        # decorators: Flask / FastAPI / click / typer
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            click_opts = []
            for d in node.decorator_list:
                if not isinstance(d, ast.Call):
                    continue
                name = _call_name(d)
                first = _str(d.args[0]) if d.args else None
                if name in ROUTE_DECOS and first and first.startswith("/"):
                    if name in ("route", "api_route"):
                        ms = next((_literal(k.value) for k in d.keywords if k.arg == "methods"), None) or ["GET"]
                    else:
                        ms = [name.upper()] if name.upper() in HTTP_METHODS else ["GET"]
                    for m in ms:
                        add_route(str(m).upper(), normalize_route(first), d, "decorator", _body_keys(node))
                if name in ("option", "argument") and isinstance(d.func, ast.Attribute):
                    names = [s for s in (_str(a) for a in d.args) if s]
                    dflt = next((_literal(k.value) for k in d.keywords if k.arg == "default"), None)
                    click_opts.append({"names": names, "default": dflt, "positional": bool(names) and not names[0].startswith("-")})
            for d in node.decorator_list:
                if isinstance(d, ast.Call) and _call_name(d) in ("command", "group") and isinstance(d.func, ast.Attribute):
                    if not ({"click", "typer"} & {i.split(".")[0] for i in info["imports"]}):
                        continue
                    cname = (_str(d.args[0]) if d.args else None) or next(
                        (_str(k.value) for k in d.keywords if k.arg == "name"), None) or node.name.replace("_", "-")
                    if _call_name(d) == "command":
                        info["subcommands"].append({"name": cname, "line": node.lineno, "options": click_opts,
                                                    "via": "click"})
        if not isinstance(node, ast.Call):
            continue
        name = _call_name(node)
        # Django path("todos/<int:pk>/", view)
        if name in ("path", "re_path") and rel.endswith("urls.py") and node.args:
            s = _str(node.args[0])
            if s is not None:
                add_route("ANY", normalize_route("/" + s.lstrip("^/"), "regex" if name == "re_path" else "eq"), node, "django")
        # argparse
        if name == "add_parser" and node.args and _str(node.args[0]):
            p = getattr(node, "_parent", None)
            var = p.targets[0].id if isinstance(p, ast.Assign) and isinstance(p.targets[0], ast.Name) else None
            aliases = next((_literal(k.value) for k in node.keywords if k.arg == "aliases"), None) or []
            info["subcommands"].append({"name": _str(node.args[0]), "line": node.lineno, "var": var,
                                        "aliases": list(aliases), "via": "argparse"})
        if name == "add_argument" and isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name):
            names = [s for s in (_str(a) for a in node.args) if s]
            if names:
                dflt = next((_literal(k.value) for k in node.keywords if k.arg == "default"), None)
                info["parser_options"].setdefault(node.func.value.id, []).append(
                    {"names": names, "default": dflt, "positional": not names[0].startswith("-")})
        # ports
        if name in ("HTTPServer", "ThreadingHTTPServer", "TCPServer", "ThreadingTCPServer", "make_server") and node.args:
            addr = _literal(node.args[0])
            if isinstance(addr, tuple) and len(addr) == 2 and isinstance(addr[1], int) and addr[1] > 0:
                info["ports"].append({"port": addr[1], "source": f"{rel}:{node.lineno}"})
            if name == "make_server" and len(node.args) >= 2 and isinstance(_literal(node.args[1]), int):
                info["ports"].append({"port": _literal(node.args[1]), "source": f"{rel}:{node.lineno}"})
        for k in node.keywords:
            if k.arg == "port" and isinstance(_literal(k.value), int):
                info["ports"].append({"port": _literal(k.value), "source": f"{rel}:{node.lineno}"})
        # env vars
        if name in ("getenv", "get") and node.args and _str(node.args[0]):
            f = node.func
            is_env = (name == "getenv") or (isinstance(f, ast.Attribute) and isinstance(f.value, ast.Attribute)
                                            and f.value.attr == "environ")
            if is_env and re.fullmatch(r"[A-Z][A-Z0-9_]*", _str(node.args[0])):
                dflt = _literal(node.args[1]) if len(node.args) > 1 else None
                info["env"].append({"name": _str(node.args[0]), "default": dflt, "source": f"{rel}:{node.lineno}"})
                if _str(node.args[0]) == "PORT" and str(dflt or "").isdigit():
                    info["ports"].append({"port": int(dflt), "source": f"{rel}:{node.lineno}", "env": "PORT"})
    for node in ast.walk(tree):
        if (isinstance(node, ast.Subscript) and isinstance(node.value, ast.Attribute) and node.value.attr == "environ"
                and _str(node.slice) and re.fullmatch(r"[A-Z][A-Z0-9_]*", _str(node.slice))):
            info["env"].append({"name": _str(node.slice), "default": None, "source": f"{rel}:{node.lineno}"})

    # "GET /path" strings anywhere
    for node in ast.walk(tree):
        s = _str(node)
        m = re.fullmatch(r"(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\s+(/\S*)", s or "")
        if m:
            add_route(m.group(1), normalize_route(m.group(2)), node, "method-path string")

    if info["server"]:
        # route tables: ("GET", r"^/todos/(\d+)$", handler)
        for node in ast.walk(tree):
            if isinstance(node, (ast.Tuple, ast.List)) and 2 <= len(node.elts) <= 6:
                ms = [_str(e) for e in node.elts if _str(e) in HTTP_METHODS]
                paths = []
                for e in node.elts:
                    s = _str(e)
                    if s is None and isinstance(e, ast.Call) and _call_name(e) in RE_FUNCS and e.args:
                        s = _str(e.args[0])
                    if s and s not in HTTP_METHODS:
                        paths.append(normalize_route(s, "regex" if re.search(r"[\^$()\\]", s) else "eq"))
                for m in ms[:1]:
                    for p in paths:
                        add_route(m, p, node, "route table")
        # handler code: constants inside functions
        for fn in ast.walk(tree):
            if not isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)):
                continue
            body = _body_keys(fn)
            for node in ast.walk(fn):
                if isinstance(node, ast.If):
                    seg = _segment_route(node.test)
                    if seg:
                        for m in _method_context(node.test) or ["ANY"]:
                            add_route(m, normalize_route(seg), node, "path segments", body)
                s = _str(node)
                if not s or not (s.startswith("/") or s.startswith("^/") or s.startswith("\\A/")):
                    continue
                kind = _usage(node)
                if kind is None or kind == "suffix":
                    continue
                if isinstance(getattr(node, "_parent", None), (ast.Tuple, ast.List)) and \
                        any(_str(e) in HTTP_METHODS for e in node._parent.elts):
                    continue  # route table, handled above
                methods = _method_context(node) or ["ANY"]
                if kind == "prefix":
                    suffixes = []
                    bo = _enclosing_boolop(node)
                    if bo is not None:
                        for n2 in ast.walk(bo):
                            if _str(n2) and _usage(n2) == "suffix":
                                suffixes.append(_str(n2))
                    base = s.rstrip("/")
                    paths = [base + "/<*>" + "/" + x.lstrip("/") for x in suffixes] or [base + "/<*>"]
                    for m in methods:
                        for p in paths:
                            add_route(m, normalize_route(p), node, "startswith", body)
                    continue
                for m in methods:
                    add_route(m, normalize_route(s, kind), node, kind, body)
    return info


def python_prog(rel: str, files: set[str], scripts: dict[str, str]) -> tuple[str | None, list[str]]:
    """Canonical invocation for the program a Python file belongs to, plus aliases."""
    parts = rel.split("/")
    env = ""
    if parts[0] == "src" and len(parts) > 1:
        env, parts = "PYTHONPATH=src ", parts[1:]
    prefix = "src/" if env else ""
    module = ".".join(parts)[:-3]
    aliases = [name for name, target in scripts.items() if target.split(":")[0] in (module, module.rsplit(".", 1)[0])]
    pkg_parts = parts[:-1]
    for i in range(1, len(pkg_parts) + 1):
        pkg = "/".join(pkg_parts[:i])
        if f"{prefix}{pkg}/__main__.py" in files:
            mod = ".".join(pkg_parts[:i])
            return f"{env}python3 -m {mod}", aliases + [f"python -m {mod}"]
    if parts[-1] == "__main__.py" and pkg_parts:
        mod = ".".join(pkg_parts)
        return f"{env}python3 -m {mod}", aliases + [f"python -m {mod}"]
    return None, aliases


# ---------------------------------------------------------------- node / go / make

NODE_ROUTE = re.compile(r"""\b(?:app|router|server|api|routes|r|fastify|instance)\s*\.\s*(get|post|put|patch|delete|head|options|all)\s*\(\s*(['"`])(/[^'"`]*)\2""")
NODE_CLI = re.compile(r"""\.command\(\s*(['"])([\w:-]+)""")
NODE_PORTS = [re.compile(r"\.listen\(\s*(\d{2,5})\b"), re.compile(r"\bPORT\s*(?:\|\||\?\?)\s*['\"]?(\d{2,5})")]
NODE_ENV = re.compile(r"process\.env\.([A-Z][A-Z0-9_]*)|process\.env\[['\"]([A-Z][A-Z0-9_]*)['\"]\]")
GO_HANDLE = re.compile(r"""\.(?:HandleFunc|Handle)\(\s*"([^"]+)\"""")
GO_ROUTER = re.compile(r"""\.(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|Get|Post|Put|Patch|Delete|Head|Options)\(\s*"(/[^"]*)\"""")
GO_PORTS = [re.compile(r"""ListenAndServe(?:TLS)?\(\s*"[^"]*:(\d{2,5})\""""), re.compile(r"""Addr:\s*"[^"]*:(\d{2,5})\""""),
            re.compile(r"""flag\.(?:Int|String)\(\s*"(?:port|addr)"\s*,\s*"?:?(\d{2,5})""")]
GO_FLAGS = re.compile(r"""flag\.(?:Int|String|Bool)(?:Var)?\([^"]*"([\w-]+)\"""")
GO_COBRA = re.compile(r"""Use:\s*"([\w-]+)""")
GO_ENV = re.compile(r"""os\.Getenv\("([A-Z][A-Z0-9_]*)"\)""")
MAKE_TARGET = re.compile(r"^([A-Za-z0-9][\w.-]*)\s*:(?!=)", re.M)


# ---------------------------------------------------------------- features

def singular(word: str) -> str:
    if word.endswith("ies") and len(word) > 4:
        return word[:-3] + "y"
    if word.endswith("s") and not word.endswith("ss") and len(word) > 3:
        return word[:-1]
    return word


def route_action(method: str, path: str) -> tuple[str, str]:
    segs = [s for s in path.strip("/").split("/") if s]
    static = [s for s in segs if not s.startswith("<")]
    resource = static[0] if static else "root"
    if resource in ("api",) and len(static) > 1:
        resource = static[1]
        segs = segs[segs.index(resource):]
    has_param = any(s.startswith("<") for s in segs)
    tail = segs[-1] if segs else ""
    if len(segs) >= 3 and not tail.startswith("<"):
        verb = tail.lower()
        for cls, words in VERB_CLASSES.items():
            if verb in words:
                return cls, resource
        return verb, resource
    if method == "GET":
        return ("show" if has_param else "list"), resource
    if method == "POST":
        return ("create" if not has_param else "update"), resource
    if method in ("PUT", "PATCH"):
        return "update", resource
    if method == "DELETE":
        return "delete", resource
    return method.lower(), resource


def verb_action(name: str) -> str:
    n = name.lower()
    for cls, words in VERB_CLASSES.items():
        if n in words:
            return cls
    return n


def feature_title(action: str, resource: str) -> str:
    one, many = singular(resource), resource
    titles = {"create": f"Create a {one}", "list": f"List {many}", "show": f"Show a {one}",
              "update": f"Update a {one}", "delete": f"Delete a {one}", "done": f"Mark a {one} done"}
    if action in titles:
        return titles[action]
    if action in ("archive", "archived", "open", "close", "closed", "complete", "completed", "read", "unread"):
        return f"Mark a {one} {action}"
    return f"{action.replace('-', ' ').capitalize()} a {one}"


def group_features(routes: list[dict], commands: list[dict]) -> list[dict]:
    feats: dict[tuple[str, str], dict] = {}
    for r in routes:
        if r.get("health"):
            continue
        action, resource = route_action(r["method"] if r["method"] != "ANY" else "GET", r["path"])
        f = feats.setdefault((action, resource), {"action": action, "resource": resource, "routes": [], "commands": []})
        f["routes"].append(r)
    resources = sorted({k[1] for k in feats})
    for c in commands:
        if c.get("launch") or c["name"] in SKIP_COMMANDS:
            continue
        action = verb_action(c["name"])
        prog_word = (c.get("prog") or "").split()[-1].split(".")[-1] if c.get("prog") else ""
        same_action = [k for k in feats if k[0] == action]
        if len(same_action) == 1:
            key = same_action[0]
        elif same_action:
            key = next((k for k in same_action if singular(k[1]) == singular(prog_word)), same_action[0])
        else:
            res = next((r for r in resources if singular(r) == singular(prog_word)), None) or prog_word or "app"
            key = (action, res)
            feats.setdefault(key, {"action": action, "resource": res, "routes": [], "commands": []})
        feats[key]["commands"].append(c)
    out = []
    for (action, resource), f in feats.items():
        fid = f"{action}-{resource if action == 'list' else singular(resource)}"
        fid = re.sub(r"[^a-z0-9-]+", "-", fid.lower()).strip("-")
        out.append({"id": fid, "title": feature_title(action, resource), **f})
    out.sort(key=lambda f: (f["resource"], ACTION_ORDER.get(f["action"], 5), f["id"]))
    seen = Counter()
    for f in out:
        seen[f["id"]] += 1
        if seen[f["id"]] > 1:
            f["id"] = f"{f['id']}-{seen[f['id']]}"
    return out


# ---------------------------------------------------------------- scan

def frontmatter_name(text: str) -> str | None:
    m = re.match(r"^---\s*\n(.*?)\n---", text, re.S)
    if not m:
        return None
    n = re.search(r"^name:\s*['\"]?([^'\"\n]+)", m.group(1), re.M)
    return n.group(1).strip() if n else None


def scan(repo: Path, max_files: int = 20000) -> dict:
    repo = repo.resolve()
    files = list_files(repo, max_files)
    fileset = set(files)
    res: dict = {"repo": str(repo), "languages": [], "markers": [], "build_commands": [], "test_commands": [],
                 "launch_candidates": [], "http_routes": [], "health_routes": [], "cli_commands": [], "env_vars": [],
                 "skill_dirs": [], "features": [], "notes": []}
    langs = Counter(LANG_EXT[Path(f).suffix] for f in files if Path(f).suffix in LANG_EXT)
    res["languages"] = [{"name": k, "files": v} for k, v in langs.most_common()]
    res["markers"] = [m for m in MARKERS if m in fileset]
    src_files = [f for f in files if not TEST_PATH.search(f)]

    routes: list[dict] = []
    commands: list[dict] = []
    ports: list[dict] = []
    env: list[dict] = []

    # ---- python
    scripts: dict[str, str] = {}
    if "pyproject.toml" in fileset and tomllib is not None:
        try:
            pp = tomllib.loads(read(repo, "pyproject.toml"))
            scripts.update(pp.get("project", {}).get("scripts", {}) or {})
        except (tomllib.TOMLDecodeError, AttributeError):
            res["notes"].append("pyproject.toml did not parse")
    py_infos = {}
    for rel in src_files:
        if rel.endswith(".py"):
            py_infos[rel] = analyze_python(rel, read(repo, rel))
    for rel, info in py_infos.items():
        res["notes"].extend(info["notes"])
        routes.extend(info["routes"])
        ports.extend(info["ports"])
        env.extend(info["env"])
        prog, aliases = python_prog(rel, fileset, scripts)
        if prog is None and info["main_guard"] and info["subcommands"]:
            prog = f"python3 {rel}"
        if prog is None and info["subcommands"]:
            prog = (aliases[0] if aliases else None)
        for sc in info["subcommands"]:
            opts = info["parser_options"].get(sc.get("var") or "", []) if sc.get("via") == "argparse" else sc.get("options", [])
            global_opts = []
            for var, olist in info["parser_options"].items():
                if var not in {s.get("var") for s in info["subcommands"]}:
                    global_opts.extend(o for o in olist if not o["positional"])
            commands.append({"prog": prog or "TODO(verify): how to invoke this CLI", "aliases": aliases,
                             "name": sc["name"], "options": opts, "global_options": global_opts,
                             "source": f"{rel}:{sc['line']}", "via": sc.get("via")})
            for o in opts:
                if any(n in PORT_FLAGS for n in o["names"]) and isinstance(o.get("default"), int):
                    ports.append({"port": o["default"], "source": f"{rel}:{sc['line']}", "flag": "--port"})
        if info["main_guard"] and info["server"] and not info["subcommands"]:
            p = prog or f"python3 {rel}"
            res["launch_candidates"].append({"kind": "server", "cmd": p, "source": rel, "port": None,
                                             "port_flag": None, "data_flag": None})
    # tests
    has_pytest = any(f.endswith(("pytest.ini", "conftest.py")) for f in files) or \
        "[tool.pytest" in read(repo, "pyproject.toml") or \
        any("pytest" in read(repo, f) for f in files if re.fullmatch(r"requirements[\w.-]*\.txt", Path(f).name))
    py_tests = [f for f in files if f.endswith(".py") and re.search(r"(^|/)test_[^/]*\.py$|_test\.py$", f)]
    if has_pytest:
        res["test_commands"].append({"cmd": "python3 -m pytest", "source": "pytest config"})
    elif py_tests:
        dirs = Counter(f.split("/")[0] for f in py_tests if "/" in f)
        tdir = dirs.most_common(1)[0][0] if dirs else None
        if tdir and f"{tdir}/__init__.py" not in fileset:
            res["test_commands"].append({"cmd": f"python3 -m unittest discover -s {tdir}", "source": f"{tdir}/"})
        else:
            res["test_commands"].append({"cmd": "python3 -m unittest", "source": ", ".join(py_tests[:3])})

    # ---- node
    if "package.json" in fileset:
        try:
            pkg = json.loads(read(repo, "package.json"))
        except json.JSONDecodeError:
            pkg = {}
            res["notes"].append("package.json did not parse")
        pm = "pnpm" if "pnpm-lock.yaml" in fileset else "yarn" if "yarn.lock" in fileset else "npm"
        run = (lambda s: f"{pm} {s}" if s in ("test", "start") else f"{pm} run {s}")
        sc = pkg.get("scripts") or {}
        if sc.get("test") and "no test specified" not in sc["test"]:
            res["test_commands"].append({"cmd": run("test"), "source": "package.json scripts.test"})
        if sc.get("build"):
            res["build_commands"].append({"cmd": run("build"), "source": "package.json scripts.build"})
        for s in ("start", "dev", "serve", "server"):
            if s in sc:
                res["launch_candidates"].append({"kind": "server", "cmd": run(s), "source": f"package.json scripts.{s}",
                                                 "port": None, "port_flag": None, "data_flag": None})
        bins = pkg.get("bin")
        bin_names = [pkg.get("name", "cli")] if isinstance(bins, str) else list((bins or {}).keys())
        for rel in src_files:
            if not rel.endswith((".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx")):
                continue
            text = read(repo, rel)
            for m in NODE_ROUTE.finditer(text):
                method = m.group(1).upper()
                routes.append({"method": "ANY" if method == "ALL" else method, "path": normalize_route(m.group(3)),
                               "source": f"{rel}:{line_of(text, m.start())}", "how": "node router"})
            for m in NODE_CLI.finditer(text):
                commands.append({"prog": (f"npx {bin_names[0]}" if bin_names else f"node {rel}"), "aliases": bin_names,
                                 "name": m.group(2), "options": [], "global_options": [],
                                 "source": f"{rel}:{line_of(text, m.start())}", "via": "commander/yargs"})
            for pat in NODE_PORTS:
                for m in pat.finditer(text):
                    ports.append({"port": int(m.group(1)), "source": f"{rel}:{line_of(text, m.start())}"})
            for m in NODE_ENV.finditer(text):
                env.append({"name": m.group(1) or m.group(2), "default": None,
                            "source": f"{rel}:{line_of(text, m.start())}"})

    # ---- go
    go_files = [f for f in src_files if f.endswith(".go")]
    if "go.mod" in fileset or go_files:
        res["build_commands"].append({"cmd": "go build ./...", "source": "go.mod"})
        if any(f.endswith("_test.go") for f in files):
            res["test_commands"].append({"cmd": "go test ./...", "source": "*_test.go"})
        main_dirs = set()
        for rel in go_files:
            text = read(repo, rel)
            if re.search(r"^package main\b", text, re.M):
                main_dirs.add(str(Path(rel).parent))
            for m in GO_HANDLE.finditer(text):
                raw = m.group(1)
                mm_ = re.fullmatch(r"(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\s+(\S+)", raw)
                method, path = (mm_.group(1), mm_.group(2)) if mm_ else ("ANY", raw)
                if path.endswith("/") and len(path) > 1:
                    path = path + "<*>"
                routes.append({"method": method, "path": normalize_route(path), "source": f"{rel}:{line_of(text, m.start())}",
                               "how": "net/http"})
            for m in GO_ROUTER.finditer(text):
                routes.append({"method": m.group(1).upper(), "path": normalize_route(m.group(2)),
                               "source": f"{rel}:{line_of(text, m.start())}", "how": "go router"})
            for pat in GO_PORTS:
                for m in pat.finditer(text):
                    ports.append({"port": int(m.group(1)), "source": f"{rel}:{line_of(text, m.start())}"})
            for m in GO_COBRA.finditer(text):
                commands.append({"prog": "go run .", "aliases": [], "name": m.group(1), "options": [],
                                 "global_options": [], "source": f"{rel}:{line_of(text, m.start())}", "via": "cobra"})
            for m in GO_ENV.finditer(text):
                env.append({"name": m.group(1), "default": None, "source": f"{rel}:{line_of(text, m.start())}"})
        for d in sorted(main_dirs):
            target = "." if d == "." else f"./{d}"
            flags = set()
            for rel in go_files:
                if str(Path(rel).parent) == d:
                    flags.update(GO_FLAGS.findall(read(repo, rel)))
            res["launch_candidates"].append({"kind": "server" if any(r["how"].startswith("go") or r["how"] == "net/http"
                                                                     for r in routes) else "cli",
                                             "cmd": f"go run {target}", "source": f"{d}/ (package main)", "port": None,
                                             "port_flag": "-port" if "port" in flags else ("-addr" if "addr" in flags else None),
                                             "data_flag": next((f"-{f}" for f in ("data", "data-dir", "db", "dir") if f in flags), None)})

    # ---- make
    if "Makefile" in fileset:
        targets = [t for t in MAKE_TARGET.findall(read(repo, "Makefile")) if not t.startswith(".")]
        for t in dict.fromkeys(targets):
            if t in ("test", "check", "tests"):
                res["test_commands"].append({"cmd": f"make {t}", "source": "Makefile"})
            elif t in ("build", "all", "compile"):
                res["build_commands"].append({"cmd": f"make {t}", "source": "Makefile"})
            elif t in ("run", "serve", "start", "dev", "up", "server"):
                res["launch_candidates"].append({"kind": "server", "cmd": f"make {t}", "source": "Makefile", "port": None,
                                                 "port_flag": None, "data_flag": None})
    if "Cargo.toml" in fileset:
        res["build_commands"].append({"cmd": "cargo build", "source": "Cargo.toml"})
        res["test_commands"].append({"cmd": "cargo test", "source": "Cargo.toml"})

    # ---- routes: dedupe, health
    seen = {}
    for r in routes:
        if not r.get("path"):
            continue
        k = route_key(r["method"], r["path"])
        if k not in seen:
            r["health"] = is_health(r["path"])
            seen[k] = r
    # drop ANY routes when a concrete method covers the same path
    concrete = {k[1] for k in seen if k[0] != "ANY"}
    res["http_routes"] = sorted((r for k, r in seen.items() if not (k[0] == "ANY" and k[1] in concrete)),
                                key=lambda r: (r["path"], HTTP_METHODS.index(r["method"]) if r["method"] in HTTP_METHODS else 9))
    res["health_routes"] = [r for r in res["http_routes"] if r["health"]]

    # ---- commands: dedupe, launch detection
    cseen = {}
    for c in commands:
        k = (c["prog"], c["name"])
        if k in cseen:
            continue
        sub_flags = {n for o in c["options"] for n in o["names"]}
        flags = sub_flags | {n for o in c["global_options"] for n in o["names"]}
        port_flag = next((f for f in PORT_FLAGS if f in flags), None)
        data_flag = next((f for f in DATA_FLAGS if f in flags), None)
        c["port_flag"], c["data_flag"] = port_flag, data_flag
        # a global flag goes before the subcommand: `prog --data DIR add ...`
        c["port_flag_global"] = bool(port_flag) and port_flag not in sub_flags
        c["data_flag_global"] = bool(data_flag) and data_flag not in sub_flags
        c["positionals"] = [o["names"][0] for o in c["options"] if o["positional"]]
        c["launch"] = bool(port_flag) or (c["name"] in SERVE_NAMES and bool(routes))
        cseen[k] = c
    res["cli_commands"] = sorted(cseen.values(), key=lambda c: (c["prog"], c["name"]))
    for c in res["cli_commands"]:
        if c["launch"]:
            port = next((p["port"] for p in ports if p.get("flag") and p["source"].split(":")[0] == c["source"].split(":")[0]),
                        None) or next((p["port"] for p in ports), None)
            res["launch_candidates"].insert(0, {"kind": "server", "cmd": f"{c['prog']} {c['name']}", "port": port,
                                                "prog": c["prog"], "subcommand": c["name"],
                                                "port_flag": c["port_flag"], "data_flag": c["data_flag"],
                                                "port_flag_global": c["port_flag_global"],
                                                "data_flag_global": c["data_flag_global"], "source": c["source"]})
    progs = {}
    for c in res["cli_commands"]:
        if not c["launch"]:
            progs.setdefault(c["prog"], {"kind": "cli", "cmd": c["prog"], "subcommands": [], "source": c["source"],
                                         "port": None, "port_flag": None, "data_flag": c["data_flag"],
                                         "data_flag_global": c["data_flag_global"]})
            progs[c["prog"]]["subcommands"].append(c["name"])
    res["launch_candidates"].extend(progs.values())
    for lc in res["launch_candidates"]:
        if lc["kind"] == "server" and lc.get("port") is None and ports:
            lc["port"] = ports[0]["port"]
    res["ports"] = ports[:20]
    envseen = {}
    for e in env:
        envseen.setdefault(e["name"], e)
    res["env_vars"] = sorted(envseen.values(), key=lambda e: e["name"])

    # ---- skills already in the repo
    for root in SKILL_ROOTS:
        base = repo / root
        if not base.is_dir():
            continue
        for d in sorted(p for p in base.iterdir() if (p / "SKILL.md").is_file()):
            text = (d / "SKILL.md").read_text(encoding="utf-8", errors="replace")
            verify_like = bool(re.search(r"^##\s+Launch", text, re.M) and re.search(r"^##\s+Drive", text, re.M))
            res["skill_dirs"].append({"path": d.relative_to(repo).as_posix(), "name": frontmatter_name(text),
                                      "verify_like": verify_like, "has_feature_map": (d / "features" / "README.md").is_file()})

    res["features"] = group_features(res["http_routes"], res["cli_commands"])
    return res


def print_text(r: dict) -> None:
    print(f"repo: {r['repo']}")
    print("languages: " + (", ".join(f"{l['name']} ({l['files']})" for l in r["languages"]) or "none detected"))
    print("markers: " + (", ".join(r["markers"]) or "none"))
    for key, label in (("build_commands", "build"), ("test_commands", "test")):
        print(f"{label}: " + ("; ".join(c["cmd"] for c in r[key]) or "none found"))
    print("launch candidates:")
    for lc in r["launch_candidates"] or [{"kind": "-", "cmd": "none found", "source": ""}]:
        extra = []
        if lc.get("port"):
            extra.append(f"port {lc['port']}")
        if lc.get("port_flag"):
            extra.append(f"port flag {lc['port_flag']}")
        if lc.get("data_flag"):
            extra.append(f"data flag {lc['data_flag']}")
        if lc.get("subcommands"):
            extra.append("subcommands " + ", ".join(lc["subcommands"]))
        print(f"  [{lc['kind']}] {lc['cmd']}" + (f"  ({'; '.join(extra)})" if extra else "") + f"  <- {lc.get('source', '')}")
    print(f"http routes ({len(r['http_routes'])}):")
    for rt in r["http_routes"]:
        print(f"  {rt['method']:<7} {rt['path']:<32} {'[health] ' if rt['health'] else ''}<- {rt['source']} ({rt['how']})")
    print(f"cli commands ({len(r['cli_commands'])}):")
    for c in r["cli_commands"]:
        args = " ".join(f"<{p}>" for p in c["positionals"])
        print(f"  {c['prog']} {c['name']} {args}".rstrip() + f"{'  [launch]' if c['launch'] else ''}  <- {c['source']}")
    if r["env_vars"]:
        print("env vars: " + ", ".join(e["name"] + (f"={e['default']}" if e.get("default") not in (None, "") else "")
                                       for e in r["env_vars"]))
    print("existing skills: " + (", ".join(f"{s['path']}{' (verify)' if s['verify_like'] else ''}"
                                           for s in r["skill_dirs"]) or "none"))
    print(f"proposed features ({len(r['features'])}):")
    for f in r["features"]:
        entry = [f"{x['method']} {x['path']}" for x in f["routes"]] + [f"{c['prog']} {c['name']}" for c in f["commands"]]
        print(f"  {f['id']:<22} {f['title']:<26} " + "; ".join(entry))
    for n in r["notes"]:
        print(f"note: {n}")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="scan_repo.py",
        description="Inventory a repo for a verification skill: languages, build/test commands, launch candidates "
                    "(servers and CLIs with ports), HTTP routes, CLI subcommands, env vars, existing skill dirs, "
                    "and a proposed feature grouping. Reads files only; never runs repo code.",
        epilog="examples:\n  scan_repo.py .\n  scan_repo.py ../todo-app --json > inventory.json\n\n"
               "Heuristics cover Python (AST), Node, Go, and Make. Anything missed becomes a TODO(verify)\n"
               "marker when scaffold.py writes the skill.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("repo", type=Path, help="repository root")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--max-files", type=int, default=20000, help="cap on files read (default 20000)")
    args = ap.parse_args(argv)
    if not args.repo.is_dir():
        print(f"scan_repo: {args.repo} is not a directory", file=sys.stderr)
        return 2
    r = scan(args.repo, args.max_files)
    if args.json:
        print(json.dumps(r, indent=2, default=lambda o: sorted(o) if isinstance(o, set) else str(o)))
    else:
        print_text(r)
    return 0


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Scaffold a project-local verification skill from scan_repo.py's inventory.

  scaffold.py REPO --app NAME [--skills-dir .claude/skills] [--force] [--max-features N] [--json]

Writes REPO/<skills-dir>/verify-NAME/:
  SKILL.md               frontmatter + Launch, Doctor, Drive, Evidence, Cleanup, Helpers
  features/README.md     the map index: preconditions, conventions, proof rules, feature list
  features/<id>.md       one per detected feature, four H2s in order:
                         Sub-features / How to get to it (user POV) / Driving it with control.sh / Gotchas
  scripts/control.sh     launch | doctor | drive | evidence | cleanup | status | prove
                         (pid file, kills only its own process group, evidence in artifacts/verify/<run-id>/)

Every value the scan could not establish becomes a `TODO(verify): ...` marker.
check_verify_skill.py fails until each one is replaced with a real command or fact.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import sys
from pathlib import Path

sys.dont_write_bytecode = True  # importing scan_repo must not leave __pycache__ in the skill dir
sys.path.insert(0, str(Path(__file__).resolve().parent))
import scan_repo  # noqa: E402

TODO = "TODO(verify)"


def sh(value: str) -> str:
    return shlex.quote(value)


def pick_server(inv: dict) -> dict | None:
    return next((lc for lc in inv["launch_candidates"] if lc["kind"] == "server"), None)


def pick_cli(inv: dict) -> dict | None:
    return next((lc for lc in inv["launch_candidates"] if lc["kind"] == "cli"), None)


def launch_command(lc: dict | None, inv: dict) -> tuple[str, str, int | None, list[str]]:
    """(LAUNCH_CMD, PORT_MODE, DEFAULT_PORT, todos)."""
    todos: list[str] = []
    if lc is None:
        return "", "none", None, todos
    env_names = {e["name"] for e in inv["env_vars"]}
    prog, sub = lc.get("prog"), lc.get("subcommand")
    head = f"{prog} " if prog else ""
    pre, post = [], []
    if lc.get("data_flag"):
        (pre if lc.get("data_flag_global") else post).append(f'{lc["data_flag"]} "$DATA_DIR"')
    if lc.get("port_flag"):
        (pre if lc.get("port_flag_global") else post).append(f'{lc["port_flag"]} "$PORT"')
    if prog and sub:
        cmd = " ".join([prog, *pre, sub, *post])
    else:
        cmd = " ".join([lc["cmd"], *pre, *post]).strip() if not head else lc["cmd"]
    if lc.get("port_flag"):
        mode = "flag"
    elif "PORT" in env_names:
        mode = "env"
    elif lc.get("port"):
        mode = "fixed"
    else:
        mode = "flag"
        todos.append("port")
        cmd += f" {TODO}: pass $PORT so the app listens where control.sh expects"
    if not lc.get("data_flag"):
        data_env = [n for n in sorted(env_names) if re.search(r"DATA|DB|DIR|STORE|STATE|HOME|PATH", n) and n != "PORT"]
        hint = f" (env {', '.join(data_env)}?)" if data_env else ""
        todos.append("data")
        cmd += f" {TODO}: point the app at the empty $DATA_DIR{hint}"
    return cmd, mode, lc.get("port"), todos


def cli_base(cli: dict | None, inv: dict) -> tuple[str, str]:
    """(prog with data flag placed correctly, data_flag_text after subcommand)."""
    if cli is None:
        return "", ""
    prog = cli["cmd"]
    if cli.get("data_flag"):
        if cli.get("data_flag_global"):
            return f"{prog} {cli['data_flag']} {{DATA_DIR}}", ""
        return prog, f" {cli['data_flag']} {{DATA_DIR}}"
    return prog, ""


def sample_value(name: str, fid: str) -> str:
    n = name.lower()
    if n in ("id", "todo_id", "item_id", "pk") or n.endswith("_id"):
        return f"<{name}>"
    if n in ("done", "completed", "archived", "enabled"):
        return "true"
    if n in ("count", "limit", "priority", "n"):
        return "1"
    return f"verify {fid}"


def concrete(path: str) -> str:
    return re.sub(r"<\*>|<([^>]*)>", lambda m: "<" + (m.group(1) or "id") + ">", path)


def feature_md(f: dict, inv: dict, C: str, cli_prefix: str, cli_suffix: str, list_route: dict | None,
               list_cmd: dict | None) -> str:
    title, fid = f["title"], f["id"]
    lines = [f"# {title}", "",
             f"{TODO}: one paragraph, from the user's point of view: what \"{title.lower()}\" does and what the user "
             f"sees afterwards.", "", "## Sub-features", ""]
    for r in f["routes"]:
        lines.append(f"- `{fid}-http-{r['method'].lower()}`: `{r['method']} {concrete(r['path'])}` over HTTP.")
    for c in f["commands"]:
        lines.append(f"- `{fid}-cli-{c['name']}`: `{c['prog']} {c['name']}` in a terminal.")
    lines += ["", "## How to get to it (user POV)", ""]
    for r in f["routes"]:
        lines.append(f"- HTTP API: `{r['method']} {concrete(r['path'])}` on the running server (base URL from `launch`).")
    for c in f["commands"]:
        args = " ".join(f"<{p}>" for p in c.get("positionals", []))
        lines.append(f"- Terminal: `{' '.join(x for x in (c['prog'], c['name'], args) if x)}`.")
    lines += ["", "## Driving it with control.sh", "", "Preconditions:", "",
              f"- `{C} doctor` exits 0."]
    needs_existing = f["action"] not in ("create", "list") or any("<" in r["path"] for r in f["routes"])
    if needs_existing:
        lines.append(f"- At least one {scan_repo.singular(f['resource'])} exists: run the create recipe first. "
                     f"{TODO}: the id it returns on an empty data dir.")
    else:
        lines.append("- Fresh run from `launch` (empty data dir).")
    lines.append("")
    for r in f["routes"]:
        path = concrete(r["path"])
        body = ""
        if r["method"] in ("POST", "PUT", "PATCH") and f["action"] in ("create", "update"):
            keys = r.get("body_keys") or []
            if keys:
                body = " " + sh(json.dumps({k: sample_value(k, fid) for k in keys}))
            else:
                body = f" '{TODO}: JSON body'"
        id_note = f" Replace `<...>` with the real id. " if "<" in path else " "
        lines.append(f"- **HTTP {r['method']}.** Run `{C} drive --feature {fid} http {r['method']} {path}{body}`."
                     f"{id_note}{TODO}: the expected status and body.")
    for c in f["commands"]:
        args = " ".join(sh(sample_value(p, fid)) for p in c.get("positionals", []))
        cmdline = f"{cli_prefix} {c['name']}{cli_suffix} {args}".strip()
        id_note = " Replace `<...>` with the real id." if "<" in args else ""
        lines.append(f"- **CLI {c['name']}.** Run `{C} drive --feature {fid} cli -- {cmdline}`.{id_note} "
                     f"{TODO}: the expected exit code and stdout.")
    proof = []
    if list_route:
        proof.append(f"`{C} drive --feature {fid} http GET {concrete(list_route['path'])}`")
    elif list_cmd:
        proof.append(f"`{C} drive --feature {fid} cli -- {cli_prefix} {list_cmd['name']}{cli_suffix}`".replace("  ", " "))
    proof.append(f"`{C} evidence --copy-data`")
    lines.append(f"- **Proof.** Read it back through a second view: run {' and '.join(proof)}. "
                 f"{TODO}: what the read-back and the data snapshot must show.")
    lines += ["", "## Gotchas", "",
              f"- {TODO}: traps that waste or invalidate a run here (ids, ordering, defaults, validation)."]
    if cli_prefix and "{DATA_DIR}" in (cli_prefix + cli_suffix):
        lines.append("- Every CLI call needs the run's data dir (`{DATA_DIR}`); without it the CLI touches its default "
                     "data location instead of the scratch one.")
        flag = re.search(r"(--[\w-]+) \{DATA_DIR\}", cli_prefix + cli_suffix)
        if flag and flag.group(1) in ("--db", "--database", "--db-path", "--file", "--path", "--store", "--data-path"):
            lines.append(f"- {TODO}: confirm `{flag.group(1)}` takes a directory. If it takes a file, pass "
                         f"`{{DATA_DIR}}/<file>` everywhere instead.")
    elif f["commands"]:
        lines.append(f"- {TODO}: confirm where CLI commands store data; drives must not touch real user data.")
    return "\n".join(lines) + "\n"


def readme_md(app: str, feats: list[dict], C: str, skipped: list[dict]) -> str:
    lines = [f"# {app} verification map", "",
             f"The maintained source for verifying what {app} users can do. Read this index before driving the app, "
             "then follow the matching feature file as the recipe.", "",
             "## Baseline preconditions", "",
             f"- Launch with `{C} launch`: empty data dir, its own port, JSON with run_id, base_url, data_dir.",
             f"- `{C} doctor` exits 0 before the first drive.",
             "- Never drive an instance this run did not start.",
             f"- {TODO}: seed data the journeys need, created through the app's own routes or commands (or \"none\").",
             "", "## Driving conventions", "",
             "- Run every command from the repo root, literally as written.",
             f"- HTTP: `{C} drive --feature <id> http METHOD PATH ['JSON'] [--expect STATUS]`.",
             f"- CLI: `{C} drive --feature <id> cli -- <command>`. `{{DATA_DIR}}`, `{{PORT}}`, `{{BASE_URL}}`, and "
             "`{RUN_ID}` in arguments become this run's values.",
             "- Start each recipe from the state its Preconditions name. Use stable handles: route paths, subcommand "
             "names, JSON fields.",
             "", "## Proof and skip reporting", "",
             "- Each drive records the action and its result in `artifacts/verify/<run-id>/`.",
             f"- A mutation needs a read-only second view (a GET or a list command), then `{C} evidence --copy-data` "
             "for the stored side effect.",
             "- Record the feature id with every artifact (`--feature`).",
             "- Report an unreachable path with the attempted command and the unmet precondition. Never report it as "
             "verified through a different path.",
             "", "## Feature entry contract", "",
             "Each feature file has an H1, one paragraph of user-visible behavior, then exactly these H2s in order: "
             "`Sub-features`, `How to get to it (user POV)`, `Driving it with control.sh`, `Gotchas`. Keep "
             "implementation details out: user paths, stable handles, required state, commands, observable proof.",
             "", "## Features", ""]
    for f in feats:
        entry = [f"`{r['method']} {concrete(r['path'])}`" for r in f["routes"]] + \
                [f"`{c['prog']} {c['name']}`" for c in f["commands"]]
        lines.append(f"- [{f['title']}](./{f['id']}.md): " + ", ".join(entry) + ".")
    if not feats:
        lines.append(f"- {TODO}: no routes or commands were detected. Add one file per user-facing feature.")
    if skipped:
        lines += ["", "## Not mapped yet", ""]
        lines += [f"- {f['title']} (`{f['id']}`): over --max-features; add a file when it matters." for f in skipped]
    return "\n".join(lines) + "\n"


def skill_md(app: str, inv: dict, C: str, skill_rel: str, launch: str, port_mode: str, health: str, read_path: str,
             cli_prog: str, surfaces: list[str], prove_args: str) -> str:
    build = "; ".join(f"`{b['cmd']}`" for b in inv["build_commands"]) or "none (interpreted)"
    tests = "; ".join(f"`{t['cmd']}`" for t in inv["test_commands"]) or f"{TODO}: the repo's test command"
    surf = " and ".join(surfaces) or "surface"
    desc = (f"Launch {app} from an empty data dir, drive its {surf} the way a user does, and keep evidence under "
            f"artifacts/verify/. Use for /verify-{app}, before claiming a change to {app} works, or to reproduce "
            f"a bug in the running app.")
    lines = ["---", f"name: verify-{app}", f"description: {json.dumps(desc)}", "---", "",
             f"# Verify {app}", "",
             f"Prove behavior on the running app, not a proxy. Every step goes through `{C}`, run from the repo root. "
             "Feature recipes live in [features/README.md](features/README.md).", "", "## Launch", ""]
    if launch:
        ready = f"`GET {health}` returns 2xx" if health else "the port accepts connections"
        port_txt = {"flag": "a free port (or `VERIFY_PORT`)", "env": "a free port exported as `PORT` (or `VERIFY_PORT`)",
                    "fixed": "the app's fixed port (only one instance at a time)"}.get(port_mode, "a port")
        lines += [f"- `{C} launch` starts `{launch}` from the repo root on {port_txt}, with an empty data dir under "
                  f"`${{VERIFY_STATE_DIR:-/tmp/verify-{app}-$UID}}/<run-id>/data`.",
                  f"- Ready = {ready}" + (f", then doctor proves it is usable with `GET {read_path}`." if read_path else "."),
                  "- It prints JSON: run_id, pid, port, base_url, data_dir, evidence_dir. The server log is "
                  "`artifacts/verify/<run-id>/launch.log`.",
                  "- It refuses to start while an earlier run is alive. Teardown is `cleanup`."]
    else:
        lines += [f"- No long-lived server: `{C} launch` only creates the run's empty data dir and evidence dir. "
                  "Each CLI drive runs in its own process."]
    if launch:
        checks = ("the recorded pid is alive and is still the process this run started, the port answers, " +
                  (f"`GET {health}` is 2xx, " if health else "") + (f"`GET {read_path}` is 2xx, " if read_path else ""))
    else:
        checks = f"`{cli_prog} --help` exits 0, " if cli_prog else ""
    lines += [f"- Build first: {build}. Tests (they do not replace driving): {tests}.", "",
              "## Doctor", "",
              f"`{C} doctor` is read-only and exits 1 on any failed check: {checks}"
              "the data dir and evidence dir exist. Run it before the first drive and again after any failed drive.",
              "", "## Drive", ""]
    if launch:
        lines.append(f"- HTTP: `{C} drive --feature <id> http METHOD PATH ['JSON'] [--expect STATUS]`.")
    if cli_prog:
        lines.append(f"- CLI: `{C} drive --feature <id> cli -- {cli_prog} <subcommand> ...`. `{{DATA_DIR}}`, `{{PORT}}`, "
                     "`{BASE_URL}`, `{RUN_ID}` in arguments become this run's values.")
    lines += ["- One recipe per feature in `features/`. Drive the public routes and commands only.", "",
              "## Evidence", "",
              "- Every drive writes `artifacts/verify/<run-id>/NNN-<feature>-<http|cli>.json`: the request or argv, "
              "the status or exit code, the response body or stdout/stderr, and timing.",
              f"- `{C} evidence --copy-data` snapshots the data dir (the side effect) and writes `manifest.json` "
              "with a sha256 per file.",
              "- Proof standard: the real user path (no internal setters or test-only endpoints); the action and the "
              "resulting state, read back through a second view; side effects checked, not inferred; mocks only at "
              "production boundaries. If a dry-run or test mode is used, observe what it really skips.", "",
              "## Cleanup", "",
              f"`{C} cleanup` stops only the process group this run started (pid file plus recorded start time, never "
              "by name), deletes the scratch state and data dir, and keeps `artifacts/verify/<run-id>/`. It prints "
              "the evidence path and fails if the evidence is gone.", "",
              "## Helpers", "",
              f"- `scripts/control.sh`: `launch | doctor | drive | evidence | cleanup | status | prove`. "
              f"`{C} --help` lists the arguments.",
              f"- One-shot proof: `{C} prove --feature <id> {prove_args}` runs launch, doctor, drive, "
              "evidence, and cleanup, then checks the evidence survived.",
              f"- Contract check (poteto-skills, default install path): "
              f"`python3 ~/.claude/skills/create-verification-skill/scripts/check_verify_skill.py {skill_rel}`.",
              f"- Drift check: `python3 ~/.claude/skills/maintain-verification-skill/scripts/drift_check.py {skill_rel} --repo .`.",
              ""]
    return "\n".join(lines)


CONTROL_SH = r'''#!/usr/bin/env bash
# Verification harness for @@APP@@. Generated by create-verification-skill/scripts/scaffold.py.
# Edit the CONFIG block when the app changes; check_verify_skill.py fails while a TODO marker remains.
set -euo pipefail

# ---- CONFIG ------------------------------------------------------------------
APP=@@APP@@
# Run from the repo root with PORT, DATA_DIR, BASE_URL, RUN_ID exported. Empty = no server (CLI-only app).
LAUNCH_CMD=@@LAUNCH_CMD@@
PORT_MODE=@@PORT_MODE@@        # flag|env: a free port per run; fixed: the app always listens on DEFAULT_PORT
DEFAULT_PORT=@@DEFAULT_PORT@@
HEALTH_PATH=@@HEALTH_PATH@@    # GET path that must return 2xx before the app counts as ready ('' = TCP only)
READ_PATH=@@READ_PATH@@        # read-only GET path doctor uses to prove the app is usable ('' = skip)
CLI_CHECK=@@CLI_CHECK@@        # doctor's health command when there is no server ('' = skip)
READY_TIMEOUT="${VERIFY_READY_TIMEOUT:-30}"
# -------------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/@@REL_TO_REPO@@" && pwd)"
STATE_ROOT="${VERIFY_STATE_DIR:-${TMPDIR:-/tmp}/verify-$APP-$(id -u)}"
ARTIFACTS_ROOT="${VERIFY_ARTIFACTS_DIR:-$REPO_ROOT/artifacts/verify}"
CURRENT="$STATE_ROOT/current"

usage() {
  cat <<EOF
usage: control.sh <command> [args]

Drive $APP for verification. Run from anywhere; paths resolve to the repo root.

  launch                         start the app from an empty data dir, wait until ready, print run JSON
  doctor                         read-only health check of the current run (exit 1 if unhealthy)
  drive [--feature ID] http METHOD PATH [JSON] [--expect STATUS]
                                 HTTP request against the run; evidence saved as NNN-ID-http.json
  drive [--feature ID] cli -- CMD [ARGS...]
                                 run a command in the repo root; {DATA_DIR} {PORT} {BASE_URL} {RUN_ID}
                                 in ARGS become this run's values; evidence saved as NNN-ID-cli.json
  evidence [--copy-data]         write manifest.json (sha256 per file); --copy-data snapshots the data dir
  cleanup                        stop only the process group this run started, delete scratch state, keep evidence
  status                         print the current run's state (read-only)
  prove [--feature ID] http|cli ...
                                 launch, doctor, drive once, evidence --copy-data, cleanup, check evidence survived

env: VERIFY_PORT, VERIFY_RUN_ID, VERIFY_STATE_DIR (default $STATE_ROOT),
     VERIFY_ARTIFACTS_DIR (default $ARTIFACTS_ROOT), VERIFY_READY_TIMEOUT (default 30s)
EOF
}

die() { echo "control.sh: $*" >&2; exit 1; }

case "$LAUNCH_CMD$CLI_CHECK" in
  *TODO\(verify\)*) [[ "${1:-}" =~ ^(-h|--help|help|status)$ ]] || die "CONFIG still has unresolved TODO markers; edit $SCRIPT_DIR/control.sh first" ;;
esac

pid_alive() { [[ -n "${1:-}" ]] && kill -0 "$1" 2>/dev/null; }
proc_started() { ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//' || true; }

free_port() {
  python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()'
}

port_open() {
  python3 -c 'import socket,sys; s=socket.socket(); s.settimeout(0.5); sys.exit(0 if s.connect_ex(("127.0.0.1", int(sys.argv[1]))) == 0 else 1)' "$1"
}

http_status() {  # URL -> prints the status code, 000 when unreachable
  python3 - "$1" <<'PY'
import sys, urllib.error, urllib.request
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
try:
    with opener.open(urllib.request.Request(sys.argv[1], method="GET"), timeout=3) as r:
        print(r.status)
except urllib.error.HTTPError as e:
    print(e.code)
except Exception:
    print("000")
PY
}

load_run() {
  [[ -f "$CURRENT" ]] || die "no active run; start one with: control.sh launch"
  RUN_ID="$(cat "$CURRENT")"
  RUN_STATE="$STATE_ROOT/$RUN_ID"
  [[ -f "$RUN_STATE/env" ]] || die "run $RUN_ID has no state in $RUN_STATE; run control.sh cleanup, then launch"
  # shellcheck disable=SC1091
  source "$RUN_STATE/env"
}

next_seq() {
  local n
  n="$(find "$EVIDENCE_DIR" -maxdepth 1 -name '[0-9][0-9][0-9]-*' | wc -l)"
  printf '%03d' "$((n + 1))"
}

ready_check() {
  if [[ -n "$HEALTH_PATH" ]]; then
    [[ "$(http_status "$BASE_URL$HEALTH_PATH")" == 2* ]]
  else
    port_open "$PORT"
  fi
}

run_json() {  # key value ... -> JSON object (ints, true/false, and "" -> null are typed)
  python3 - "$@" <<'PY'
import json, sys

def typed(v):
    if v == "":
        return None
    if v in ("true", "false"):
        return v == "true"
    return int(v) if v.isdigit() else v

print(json.dumps({k: typed(v) for k, v in zip(sys.argv[1::2], sys.argv[2::2])}, indent=2))
PY
}

cmd_launch() {
  mkdir -p "$STATE_ROOT"
  if [[ -f "$CURRENT" ]]; then
    local old pidf
    old="$(cat "$CURRENT")"
    pidf="$STATE_ROOT/$old/pid"
    if [[ -f "$pidf" ]] && pid_alive "$(cat "$pidf")"; then
      die "run $old is still alive (pid $(cat "$pidf")); drive it, or stop it with: control.sh cleanup"
    fi
  fi
  RUN_ID="${VERIFY_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
  RUN_STATE="$STATE_ROOT/$RUN_ID"
  DATA_DIR="$RUN_STATE/data"
  EVIDENCE_DIR="$ARTIFACTS_ROOT/$RUN_ID"
  [[ ! -e "$RUN_STATE" ]] || die "run id $RUN_ID already exists in $STATE_ROOT"
  mkdir -p "$DATA_DIR" "$EVIDENCE_DIR"
  if [[ "$PORT_MODE" == fixed ]]; then PORT="${VERIFY_PORT:-$DEFAULT_PORT}"; else PORT="${VERIFY_PORT:-$(free_port)}"; fi
  BASE_URL="http://127.0.0.1:$PORT"
  {
    printf 'RUN_ID=%q\nPORT=%q\nDATA_DIR=%q\nBASE_URL=%q\nEVIDENCE_DIR=%q\n' \
      "$RUN_ID" "$PORT" "$DATA_DIR" "$BASE_URL" "$EVIDENCE_DIR"
  } > "$RUN_STATE/env"
  echo "$RUN_ID" > "$CURRENT"
  if [[ -z "$LAUNCH_CMD" ]]; then
    run_json run_id "$RUN_ID" pid "" port "" base_url "" data_dir "$DATA_DIR" evidence_dir "$EVIDENCE_DIR"
    return 0
  fi
  if port_open "$PORT"; then
    die "port $PORT is already taken by a process this run did not start; pick another with VERIFY_PORT (never kill it)"
  fi
  # Start the app as the leader of a new process group, so cleanup can stop exactly what this run started.
  local starter=() pid
  if command -v setsid >/dev/null 2>&1; then starter=(setsid); else set -m; fi
  (
    cd "$REPO_ROOT"
    export PORT DATA_DIR BASE_URL RUN_ID
    exec "${starter[@]}" bash -c "$LAUNCH_CMD"
  ) > "$EVIDENCE_DIR/launch.log" 2>&1 < /dev/null &
  pid=$!
  set +m
  echo "$pid" > "$RUN_STATE/pid"
  proc_started "$pid" > "$RUN_STATE/started"
  local deadline=$((SECONDS + READY_TIMEOUT))
  until ready_check; do
    if ! pid_alive "$pid"; then
      tail -n 20 "$EVIDENCE_DIR/launch.log" >&2 || true
      die "the app exited during startup; log: $EVIDENCE_DIR/launch.log. Run control.sh cleanup before retrying."
    fi
    if (( SECONDS >= deadline )); then
      tail -n 20 "$EVIDENCE_DIR/launch.log" >&2 || true
      die "not ready after ${READY_TIMEOUT}s (${HEALTH_PATH:-TCP} on port $PORT); log: $EVIDENCE_DIR/launch.log. Run control.sh cleanup."
    fi
    sleep 0.3
  done
  run_json run_id "$RUN_ID" pid "$pid" port "$PORT" base_url "$BASE_URL" data_dir "$DATA_DIR" evidence_dir "$EVIDENCE_DIR" log "$EVIDENCE_DIR/launch.log"
}

cmd_doctor() {
  load_run
  local checks=() ok=1 pid=""
  [[ -f "$RUN_STATE/pid" ]] && pid="$(cat "$RUN_STATE/pid")"
  if [[ -n "$LAUNCH_CMD" ]]; then
    if pid_alive "$pid" && [[ "$(proc_started "$pid")" == "$(cat "$RUN_STATE/started" 2>/dev/null)" ]]; then
      checks+=("process|1|pid $pid alive, started by this run")
    else
      checks+=("process|0|pid ${pid:-none} is not running (or is no longer this run's process)"); ok=0
    fi
    if port_open "$PORT"; then checks+=("port|1|$PORT accepts connections"); else checks+=("port|0|$PORT refuses connections"); ok=0; fi
    local p code
    for p in "$HEALTH_PATH" "$READ_PATH"; do
      [[ -z "$p" ]] && continue
      code="$(http_status "$BASE_URL$p")"
      if [[ "$code" == 2* ]]; then checks+=("GET $p|1|$code"); else checks+=("GET $p|0|$code"); ok=0; fi
    done
  elif [[ -n "$CLI_CHECK" ]]; then
    if (cd "$REPO_ROOT" && bash -c "$CLI_CHECK") >/dev/null 2>&1; then checks+=("cli|1|$CLI_CHECK exits 0"); else checks+=("cli|0|$CLI_CHECK failed"); ok=0; fi
  fi
  if [[ -d "$DATA_DIR" ]]; then checks+=("data dir|1|$DATA_DIR"); else checks+=("data dir|0|$DATA_DIR missing"); ok=0; fi
  if [[ -d "$EVIDENCE_DIR" ]]; then checks+=("evidence dir|1|$EVIDENCE_DIR"); else checks+=("evidence dir|0|$EVIDENCE_DIR missing"); ok=0; fi
  python3 - "$ok" "$RUN_ID" "${checks[@]}" <<'PY'
import json, sys
ok, run_id, rows = sys.argv[1] == "1", sys.argv[2], sys.argv[3:]
checks = [dict(zip(("name", "ok", "detail"), r.split("|", 2))) for r in rows]
for c in checks:
    c["ok"] = c["ok"] == "1"
print(json.dumps({"ok": ok, "run_id": run_id, "checks": checks}, indent=2))
PY
  [[ "$ok" == 1 ]]
}

cmd_drive() {
  load_run
  local feature="adhoc"
  if [[ "${1:-}" == "--feature" ]]; then feature="${2:?--feature needs an id}"; shift 2; fi
  local kind="${1:-}"; shift || true
  local seq; seq="$(next_seq)"
  local out="$EVIDENCE_DIR/$seq-$feature-$kind.json"
  case "$kind" in
    http)
      local method="${1:?usage: drive http METHOD PATH [JSON] [--expect STATUS]}" path="${2:?missing PATH}"
      shift 2
      local body="" expect=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --expect) expect="${2:?--expect needs a status}"; shift 2 ;;
          *) body="$1"; shift ;;
        esac
      done
      path="${path//\{RUN_ID\}/$RUN_ID}"
      [[ -n "$BASE_URL" ]] || die "this run has no server; use: drive cli -- ..."
      python3 - "$method" "$BASE_URL$path" "$body" "$out" "$feature" "$expect" <<'PY'
import json, sys, time, urllib.error, urllib.request
method, url, body, out, feature, expect = sys.argv[1:7]
data = body.encode() if body else None
headers = {"Content-Type": "application/json", "Accept": "application/json"} if body else {"Accept": "application/json"}
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
started = time.time()
try:
    with opener.open(urllib.request.Request(url, data=data, method=method.upper(), headers=headers), timeout=30) as r:
        status, raw, rh = r.status, r.read(), dict(r.headers)
except urllib.error.HTTPError as e:
    status, raw, rh = e.code, e.read(), dict(e.headers)
except Exception as e:  # connection refused, timeout
    status, raw, rh = 0, str(e).encode(), {}
text = raw.decode("utf-8", "replace")
try:
    parsed = json.loads(text) if text else None
except ValueError:
    parsed = None
try:
    req_body = json.loads(body) if body else None
except ValueError:
    req_body = body
rec = {"feature": feature, "kind": "http", "method": method.upper(), "url": url, "request_body": req_body,
       "status": status, "response_headers": rh, "response_body": parsed if parsed is not None else text,
       "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(started)),
       "elapsed_ms": round((time.time() - started) * 1000, 1), "expect": expect or None}
with open(out, "w") as f:
    json.dump(rec, f, indent=2)
print(f"{method.upper()} {url} -> {status}")
if text:
    print(text)
print(f"evidence: {out}", file=sys.stderr)
if expect:
    sys.exit(0 if str(status) == expect else 1)
sys.exit(0 if 200 <= status < 400 else 1)
PY
      ;;
    cli)
      [[ "${1:-}" == "--" ]] && shift
      [[ $# -gt 0 ]] || die "usage: drive [--feature ID] cli -- CMD [ARGS...]"
      local argv=() a
      for a in "$@"; do
        a="${a//\{DATA_DIR\}/$DATA_DIR}"; a="${a//\{PORT\}/$PORT}"
        a="${a//\{BASE_URL\}/$BASE_URL}"; a="${a//\{RUN_ID\}/$RUN_ID}"
        argv+=("$a")
      done
      local so se rc
      so="$(mktemp)"; se="$(mktemp)"
      set +e
      (cd "$REPO_ROOT" && PORT="$PORT" DATA_DIR="$DATA_DIR" BASE_URL="$BASE_URL" RUN_ID="$RUN_ID" "${argv[@]}") >"$so" 2>"$se" </dev/null
      rc=$?
      set -e
      python3 - "$out" "$feature" "$rc" "$so" "$se" "${argv[@]}" <<'PY'
import json, sys, time
out, feature, rc, so, se, *argv = sys.argv[1:]
rec = {"feature": feature, "kind": "cli", "argv": argv, "exit_code": int(rc),
       "stdout": open(so, encoding="utf-8", errors="replace").read(),
       "stderr": open(se, encoding="utf-8", errors="replace").read(),
       "finished": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
with open(out, "w") as f:
    json.dump(rec, f, indent=2)
PY
      cat "$so"; cat "$se" >&2
      rm -f "$so" "$se"
      echo "exit: $rc  evidence: $out" >&2
      return "$rc"
      ;;
    *) die "usage: drive [--feature ID] http METHOD PATH [JSON] | drive [--feature ID] cli -- CMD..." ;;
  esac
}

cmd_evidence() {
  load_run
  local copy=0
  [[ "${1:-}" == "--copy-data" ]] && copy=1
  if [[ "$copy" == 1 && -d "$DATA_DIR" ]]; then
    local snap; snap="$EVIDENCE_DIR/$(next_seq)-data-snapshot"
    mkdir -p "$snap"
    cp -R "$DATA_DIR/." "$snap/"
  fi
  python3 - "$EVIDENCE_DIR" "$RUN_ID" "$APP" <<'PY'
import hashlib, json, os, sys, time
root, run_id, app = sys.argv[1:4]
files = []
for dirpath, _, names in os.walk(root):
    for n in sorted(names):
        p = os.path.join(dirpath, n)
        rel = os.path.relpath(p, root)
        if rel == "manifest.json":
            continue
        with open(p, "rb") as f:
            digest = hashlib.sha256(f.read()).hexdigest()
        files.append({"path": rel, "bytes": os.path.getsize(p), "sha256": digest})
files.sort(key=lambda x: x["path"])
manifest = {"app": app, "run_id": run_id, "written": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "files": files}
with open(os.path.join(root, "manifest.json"), "w") as f:
    json.dump(manifest, f, indent=2)
print(json.dumps({"evidence_dir": root, "files": len(files), "manifest": os.path.join(root, "manifest.json")}, indent=2))
PY
}

cmd_cleanup() {
  if [[ ! -f "$CURRENT" ]]; then
    echo '{"cleaned": false, "reason": "no active run"}'
    return 0
  fi
  load_run
  local killed=false pid=""
  [[ -f "$RUN_STATE/pid" ]] && pid="$(cat "$RUN_STATE/pid")"
  if pid_alive "$pid"; then
    if [[ "$(proc_started "$pid")" == "$(cat "$RUN_STATE/started" 2>/dev/null)" ]]; then
      local target="$pid" pgid
      pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
      [[ "$pgid" == "$pid" ]] && target="-$pid"   # we made it a group leader: stop the whole group we started
      kill -TERM -- "$target" 2>/dev/null || true
      local i
      for i in $(seq 1 50); do pid_alive "$pid" || break; sleep 0.1; done
      if pid_alive "$pid"; then kill -KILL -- "$target" 2>/dev/null || true; fi
      killed=true
    else
      echo "control.sh: pid $pid is alive but was not started by run $RUN_ID (start time differs); leaving it alone" >&2
    fi
  fi
  rm -rf "$RUN_STATE"
  rm -f "$CURRENT"
  [[ -d "$EVIDENCE_DIR" ]] || die "evidence dir $EVIDENCE_DIR is missing after cleanup"
  local n; n="$(find "$EVIDENCE_DIR" -type f | wc -l | tr -d ' ')"
  run_json run_id "$RUN_ID" killed "$killed" evidence_dir "$EVIDENCE_DIR" evidence_files "$n"
}

cmd_status() {
  if [[ ! -f "$CURRENT" ]]; then echo '{"active": false}'; return 0; fi
  load_run
  local pid="" alive=false
  [[ -f "$RUN_STATE/pid" ]] && pid="$(cat "$RUN_STATE/pid")"
  pid_alive "$pid" && alive=true
  run_json active true run_id "$RUN_ID" pid "$pid" alive "$alive" port "$PORT" base_url "$BASE_URL" data_dir "$DATA_DIR" evidence_dir "$EVIDENCE_DIR"
}

cmd_prove() {
  [[ $# -gt 0 ]] || die "usage: prove [--feature ID] http METHOD PATH [JSON] | prove [--feature ID] cli -- CMD..."
  local self="$SCRIPT_DIR/control.sh" rc=0
  "$self" launch || { "$self" cleanup >/dev/null 2>&1 || true; die "prove: launch failed"; }
  trap '"$self" cleanup >/dev/null 2>&1 || true' EXIT
  "$self" doctor || { echo "control.sh: prove: doctor failed" >&2; rc=1; }
  if [[ "$rc" == 0 ]]; then "$self" drive "$@" || rc=$?; fi
  load_run
  local ev="$EVIDENCE_DIR"
  "$self" evidence --copy-data >/dev/null
  trap - EXIT
  "$self" cleanup
  local drives; drives="$(find "$ev" -maxdepth 1 -name '[0-9][0-9][0-9]-*-*.json' | wc -l | tr -d ' ')"
  [[ -f "$ev/manifest.json" && "$drives" -ge 1 ]] || die "prove: evidence did not survive cleanup in $ev"
  echo "prove: drive exit $rc; evidence kept in $ev ($drives drive record(s))" >&2
  return "$rc"
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  launch) cmd_launch "$@" ;;
  doctor) cmd_doctor "$@" ;;
  drive) cmd_drive "$@" ;;
  evidence) cmd_evidence "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  status) cmd_status "$@" ;;
  prove) cmd_prove "$@" ;;
  -h|--help|help) usage ;;
  "") usage; exit 2 ;;
  *) usage >&2; die "unknown command: $cmd" ;;
esac
'''


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="scaffold.py",
        description="Write a project-local verify-NAME skill (SKILL.md, feature map, scripts/control.sh) from a repo "
                    "scan. Unknown values become TODO(verify) markers; check_verify_skill.py fails until they are gone.",
        epilog="examples:\n"
               "  scaffold.py . --app todo\n"
               "  scaffold.py ../app --app shop --skills-dir .cursor/skills --max-features 5\n"
               "next: replace every TODO(verify), run `control.sh prove ...`, then check_verify_skill.py",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("repo", type=Path, help="repository root")
    ap.add_argument("--app", required=True, help="short app name; the skill becomes verify-NAME")
    ap.add_argument("--skills-dir", default=".claude/skills", help="skills dir, relative to REPO (default .claude/skills)")
    ap.add_argument("--max-features", type=int, default=0, help="write at most N feature files (default: all detected)")
    ap.add_argument("--force", action="store_true", help="overwrite an existing verify-NAME dir")
    ap.add_argument("--json", action="store_true", help="machine-readable summary")
    args = ap.parse_args(argv)

    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", args.app):
        print("scaffold: --app must be lowercase letters, digits, and dashes", file=sys.stderr)
        return 2
    repo = args.repo.resolve()
    if not repo.is_dir():
        print(f"scaffold: {repo} is not a directory", file=sys.stderr)
        return 2
    skills_root = Path(args.skills_dir)
    skills_root = skills_root if skills_root.is_absolute() else repo / skills_root
    skill = skills_root / f"verify-{args.app}"
    if skill.exists() and not args.force:
        print(f"scaffold: {skill} exists; maintain it with /maintain-verification-skill, or pass --force to overwrite",
              file=sys.stderr)
        return 1

    inv = scan_repo.scan(repo)
    try:
        skill_rel = skill.relative_to(repo).as_posix()
    except ValueError:
        skill_rel = str(skill)
    C = f"{skill_rel}/scripts/control.sh"
    server = pick_server(inv)
    cli = pick_cli(inv)
    launch, port_mode, default_port, launch_todos = launch_command(server, inv)
    health = next((r["path"] for r in inv["health_routes"] if r["method"] in ("GET", "ANY")), "")
    feats_all = inv["features"]
    feats = feats_all[: args.max_features] if args.max_features > 0 else feats_all
    skipped = feats_all[len(feats):]
    list_routes = {f["resource"]: r for f in feats_all if f["action"] == "list" for r in f["routes"] if r["method"] in ("GET", "ANY")}
    list_cmds = {f["resource"]: c for f in feats_all if f["action"] == "list" for c in f["commands"]}
    read_path = next(iter(list_routes.values()), {}).get("path", "") if server else ""
    cli_prefix, cli_suffix = cli_base(cli, inv)
    cli_prog = cli["cmd"] if cli else ""
    surfaces = (["HTTP API"] if inv["http_routes"] else []) + (["CLI"] if inv["cli_commands"] else [])
    if launch:
        prove_args = f"http GET {read_path or health or '/'}"
    elif cli_prog:
        first_list = next(iter(list_cmds.values()), None)
        sub = first_list["name"] if first_list else "--help"
        prove_args = f"cli -- {cli_prefix} {sub}{cli_suffix if first_list else ''}".replace("  ", " ")
    else:
        prove_args = f"cli -- {TODO}: a read-only command"

    (skill / "features").mkdir(parents=True, exist_ok=True)
    (skill / "scripts").mkdir(parents=True, exist_ok=True)
    written = []
    (skill / "SKILL.md").write_text(skill_md(args.app, inv, C, skill_rel, launch, port_mode, health, read_path,
                                             cli_prog, surfaces, prove_args), encoding="utf-8")
    written.append("SKILL.md")
    (skill / "features" / "README.md").write_text(readme_md(args.app, feats, C, skipped), encoding="utf-8")
    written.append("features/README.md")
    for f in feats:
        text = feature_md(f, inv, C, cli_prefix, cli_suffix, list_routes.get(f["resource"]),
                          list_cmds.get(f["resource"]))
        (skill / "features" / f"{f['id']}.md").write_text(text, encoding="utf-8")
        written.append(f"features/{f['id']}.md")
    cli_check = ""
    if not launch and cli_prog:
        cli_check = f"{cli_prog} --help"
    if not launch and not cli_prog:
        cli_check = f"{TODO}: command that proves the app is usable"
    rel_to_repo = os.path.relpath(repo, skill / "scripts")
    control = CONTROL_SH
    for key, val in {"APP": sh(args.app), "LAUNCH_CMD": sh(launch), "PORT_MODE": port_mode if launch else "none",
                     "DEFAULT_PORT": str(default_port or 0), "HEALTH_PATH": sh(health),
                     "READ_PATH": sh(read_path), "CLI_CHECK": sh(cli_check), "REL_TO_REPO": rel_to_repo}.items():
        control = control.replace(f"@@{key}@@", val)
    ctl = skill / "scripts" / "control.sh"
    ctl.write_text(control, encoding="utf-8")
    ctl.chmod(0o755)
    written.append("scripts/control.sh")

    todos = []
    for p in sorted(skill.rglob("*")):
        if p.is_file():
            for n, line in enumerate(p.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
                if TODO in line:
                    todos.append(f"{p.relative_to(skill).as_posix()}:{n}")
    summary = {"skill_dir": str(skill), "files": written, "features": [f["id"] for f in feats],
               "not_mapped": [f["id"] for f in skipped], "launch": launch or None, "health": health or None,
               "read_path": read_path or None, "cli": cli_prog or None, "todo_markers": len(todos),
               "todo_locations": todos,
               "next": [f"replace every {TODO} (grep -rn 'TODO(verify)' {skill_rel})",
                        f"{C} prove --feature <id> {prove_args}",
                        f"python3 {Path(__file__).resolve().parent / 'check_verify_skill.py'} {skill_rel}"]}
    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        print(f"scaffold: wrote {skill} ({len(written)} files, {len(feats)} features)")
        print(f"  launch: {launch or '(none: CLI-only)'}")
        print(f"  health: {health or '(none: TCP check)'}  read: {read_path or '-'}  cli: {cli_prog or '-'}")
        print(f"  {len(todos)} TODO(verify) markers to replace, e.g. {', '.join(todos[:4])}")
        for n in summary["next"]:
            print(f"  next: {n}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Check a verify-<app> skill against its contract. Exit 1 on any failure.

Fails when:
  * SKILL.md is missing, has no YAML frontmatter, or its name/description is empty,
    or name != the directory name
  * a required section is missing: Launch, Doctor, Drive, Evidence, Cleanup, Helpers (H2s)
  * features/README.md is missing, or a feature file does not have exactly these H2s in order:
    Sub-features / How to get to it (user POV) / Driving it with <harness> / Gotchas
  * a drive command in a feature's `Driving it with` section still has a `<placeholder>`
  * an index link is dead, or a feature file is not linked from features/README.md
  * a TODO(verify) marker remains anywhere in the skill
  * a file in scripts/ is not executable, has no shebang, fails `bash -n` / py_compile,
    or is never mentioned in SKILL.md (a helper nobody can find is not a helper)

drift_check.py (maintain-verification-skill) imports this module: keep the helpers stable.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

REQUIRED_SECTIONS = ["Launch", "Doctor", "Drive", "Evidence", "Cleanup", "Helpers"]
FEATURE_H2 = ["Sub-features", "How to get to it (user POV)", "Driving it with <harness>", "Gotchas"]
TODO = "TODO(verify)"
LINK_RE = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)")


def frontmatter(text: str) -> dict | None:
    m = re.match(r"^---[ \t]*\n(.*?)\n---[ \t]*(\n|$)", text, re.S)
    if not m:
        return None
    out = {}
    for line in m.group(1).splitlines():
        kv = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if kv:
            val = kv.group(2).strip()
            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                val = val[1:-1]
            out[kv.group(1)] = val
    return out


def headings(text: str, level: int) -> list[tuple[int, str]]:
    """(line, title) for headings of exactly `level`, ignoring fenced code."""
    out, fence = [], False
    for n, line in enumerate(text.splitlines(), 1):
        if re.match(r"^\s*(```|~~~)", line):
            fence = not fence
            continue
        if fence:
            continue
        m = re.match(r"^(#{1,6})\s+(.*?)\s*#*\s*$", line)
        if m and len(m.group(1)) == level:
            out.append((n, m.group(2)))
    return out


def h2_contract_errors(text: str) -> list[str]:
    """Errors for a feature file's H1 + four ordered H2s."""
    errs = []
    if not headings(text, 1):
        errs.append("missing H1 title")
    got = [t for _, t in headings(text, 2)]
    ok = (len(got) == 4 and got[0] == FEATURE_H2[0] and got[1] == FEATURE_H2[1]
          and re.fullmatch(r"Driving it with \S.*", got[2] or "") is not None and got[3] == FEATURE_H2[3])
    if not ok:
        errs.append(f"H2s must be exactly {FEATURE_H2} in order, got {got}")
    return errs


def recipe_placeholders(text: str) -> list[str]:
    """`<id>`-style placeholders left in commands of the `Driving it with ...` section."""
    m = re.search(r"^##\s+Driving it with[^\n]*\n(.*?)(?=^##\s|\Z)", text, re.M | re.S)
    if not m:
        return []
    found = []
    for span in re.findall(r"`([^`\n]+)`", m.group(1)):
        if re.search(r"\b(drive|curl|control\.sh|python3?|npm|go|make)\b", span):
            found += [p for p in re.findall(r"<[A-Za-z_*][\w*-]*>", span) if p not in found]
    return found


def feature_files(skill: Path) -> list[Path]:
    fdir = skill / "features"
    return sorted(p for p in fdir.glob("*.md") if p.name.lower() != "readme.md") if fdir.is_dir() else []


def local_links(text: str) -> list[str]:
    out = []
    for target in LINK_RE.findall(text):
        if re.match(r"^[a-z][a-z0-9+.-]*:", target) or target.startswith("#"):
            continue
        out.append(target.split("#", 1)[0])
    return [t for t in out if t]


def index_report(skill: Path) -> dict:
    """missing (feature file not indexed), dead (link to nothing), duplicate, extra (link to a non-feature file)."""
    readme = skill / "features" / "README.md"
    rep = {"missing": [], "dead": [], "duplicate": [], "extra": []}
    if not readme.is_file():
        return rep
    feats = {p.resolve() for p in feature_files(skill)}
    seen = set()
    for target in local_links(readme.read_text(encoding="utf-8", errors="replace")):
        p = (readme.parent / target).resolve()
        if not p.exists():
            rep["dead"].append(target)
        elif p in seen and p in feats:
            rep["duplicate"].append(target)
        elif p not in feats and p.suffix == ".md" and p.parent == readme.parent.resolve():
            rep["extra"].append(target)
        seen.add(p)
    rep["missing"] = sorted(p.name for p in feats if p not in seen)
    return rep


def check(skill: Path) -> list[dict]:
    """Return a list of {check, ok, detail}."""
    results: list[dict] = []

    def add(name: str, ok: bool, detail: str = "") -> None:
        results.append({"check": name, "ok": ok, "detail": detail})

    sk = skill / "SKILL.md"
    if not sk.is_file():
        add("SKILL.md exists", False, f"{sk} not found")
        return results
    text = sk.read_text(encoding="utf-8", errors="replace")
    fm = frontmatter(text)
    if fm is None:
        add("frontmatter", False, "SKILL.md must start with --- YAML frontmatter --- (without it the skill never registers)")
    else:
        missing = [k for k in ("name", "description") if not fm.get(k)]
        add("frontmatter", not missing, "missing " + ", ".join(missing) if missing else f"name={fm['name']}")
        if fm.get("name"):
            add("name matches dir", fm["name"] == skill.name, f"name={fm['name']} dir={skill.name}")
    h2 = [t for _, t in headings(text, 2)]
    for sec in REQUIRED_SECTIONS:
        present = any(t == sec or t.startswith(sec + " ") or t.startswith(sec + ":") for t in h2)
        add(f"section {sec}", present, "" if present else f"add a `## {sec}` section")
    for target in local_links(text):
        p = (skill / target)
        add(f"SKILL.md link {target}", p.exists(), "" if p.exists() else "dead link")

    readme = skill / "features" / "README.md"
    add("features/README.md exists", readme.is_file(), "" if readme.is_file() else "create the feature map index")
    feats = feature_files(skill)
    add("feature files", bool(feats), f"{len(feats)} file(s)" if feats else "add one file per user-facing feature")
    for f in feats:
        ftext = f.read_text(encoding="utf-8", errors="replace")
        errs = h2_contract_errors(ftext)
        add(f"contract {f.name}", not errs, "; ".join(errs))
        holes = recipe_placeholders(ftext)
        add(f"literal recipes {f.name}", not holes,
            f"placeholder(s) {', '.join(holes)} in a drive command; write the real value" if holes else "")
    idx = index_report(skill)
    for kind in ("dead", "missing", "duplicate", "extra"):
        vals = idx[kind]
        add(f"index {kind}", not vals, ", ".join(vals) if vals else "")

    todos = []
    for p in sorted(skill.rglob("*")):
        if p.is_file() and p.stat().st_size < 2_000_000:
            for n, line in enumerate(p.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
                if TODO in line:
                    todos.append(f"{p.relative_to(skill).as_posix()}:{n}")
    add("no TODO(verify) left", not todos, (f"{len(todos)}: " + ", ".join(todos[:12]) + (" …" if len(todos) > 12 else ""))
        if todos else "")

    scripts = sorted(p for p in (skill / "scripts").rglob("*") if p.is_file()) if (skill / "scripts").is_dir() else []
    for s in scripts:
        rel = s.relative_to(skill).as_posix()
        execable = os.access(s, os.X_OK)
        add(f"executable {rel}", execable, "" if execable else f"chmod +x {rel}")
        head = s.read_bytes()[:2]
        add(f"shebang {rel}", head == b"#!", "" if head == b"#!" else "first line must be #!/usr/bin/env ...")
        if s.suffix in (".sh", ".bash"):
            r = subprocess.run(["bash", "-n", str(s)], capture_output=True, text=True)
            add(f"bash -n {rel}", r.returncode == 0, r.stderr.strip()[:200])
        if s.suffix == ".py":
            try:
                compile(s.read_bytes(), str(s), "exec")
                add(f"compile {rel}", True)
            except (SyntaxError, ValueError) as e:
                add(f"compile {rel}", False, str(e)[:200])
        mentioned = rel in text or s.name in text
        add(f"documented {rel}", mentioned, "" if mentioned else "show its invocation in SKILL.md (Helpers)")
    return results


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="check_verify_skill.py",
        description="Check a verify-<app> skill: frontmatter, Launch/Doctor/Drive/Evidence/Cleanup/Helpers sections, "
                    "feature files with the four ordered H2s, live index links, no TODO(verify) left, and executable, "
                    "documented scripts. Exit 1 on any failure.",
        epilog="example:\n  check_verify_skill.py .claude/skills/verify-todo",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("skill_dir", type=Path, help="the verify-<app> skill directory")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args(argv)
    if not args.skill_dir.is_dir():
        print(f"check_verify_skill: {args.skill_dir} is not a directory", file=sys.stderr)
        return 2
    results = check(args.skill_dir)
    failed = [r for r in results if not r["ok"]]
    if args.json:
        print(json.dumps({"skill_dir": str(args.skill_dir), "ok": not failed, "failed": len(failed),
                          "results": results}, indent=2))
    else:
        for r in results:
            if not r["ok"]:
                print(f"FAIL  {r['check']}: {r['detail']}")
        print(f"check_verify_skill: {'PASS' if not failed else 'FAIL'} ({len(results) - len(failed)}/{len(results)} checks)"
              f" {args.skill_dir}")
    return 0 if not failed else 1


if __name__ == "__main__":
    sys.exit(main())

