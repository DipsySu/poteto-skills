#!/usr/bin/env bash
# The curator's cron entry: upstream diff -> proposals -> (weekly) apply on a local branch.
# Never pushes. Commits only after scripts/verify.sh passes.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: curate.sh [--propose | --apply] [--offline] [--no-fetch] [--date YYYY-MM-DD] [--repo DIR]

  --propose   (default) run upstream_diff.sh, then write proposals/DATE.md:
              online: headless `claude -p --model opus --effort max` with references/curator-prompt.md
              (web research; every proposal needs a fetched source URL, a pyramid level, a change)
              --offline: proposals derived from the upstream diff only, no LLM
              The file must pass check_proposals.py (online runs also re-fetch every URL).
  --apply     weekly: make the change on local branch curator/DATE in a separate git worktree
              (your checkout is untouched), append a CHANGELOG entry, run scripts/verify.sh, and
              commit only if it passes. Never pushes.
              online: claude implements the best proposals; --offline: sync changed upstream files
              into research/upstream/ (a deterministic, sourced change)
  --offline   skip every LLM step (tests use this)
  --no-fetch  don't fetch upstream; diff against the cached clone
  --date D    run date (default: today)
  --repo DIR  poteto-skills checkout (default: derived from this script)

logs: logs/curator/DATE.log plus DATE.upstream.json, DATE.claude-*.json, DATE.verify.log
env:  POTETO_CACHE (clone and worktrees, default ~/.cache/poteto-skills), POTETO_UPSTREAM_URL,
      CURATOR_MODEL (opus), CURATOR_EFFORT (max), CURATOR_TIMEOUT (3600 s),
      CURATOR_VERIFY_CMD (bash scripts/verify.sh --run-examples)
cron: 17 6 * * *  /path/to/poteto-skills/skills/curator/scripts/curate.sh --propose
      47 6 * * 1  /path/to/poteto-skills/skills/curator/scripts/curate.sh --apply
EOF
}

mode=propose offline=0 nofetch=0 date_="$(date +%F)" repo="${POTETO_SKILLS_REPO:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --propose) mode=propose; shift ;;
    --apply) mode=apply; shift ;;
    --offline) offline=1; shift ;;
    --no-fetch) nofetch=1; shift ;;
    --date) date_="${2:?--date needs YYYY-MM-DD}"; shift 2 ;;
    --repo) repo="${2:?--repo needs a directory}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
[[ "$date_" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "curate: --date must be YYYY-MM-DD" >&2; exit 2; }

script_real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
script_dir="$(dirname "$script_real")"
skill_dir="$(dirname "$script_dir")"
[[ -n "$repo" ]] || repo="$(cd "$skill_dir/../.." && pwd)"
[[ -d "$repo/research/upstream" && -d "$repo/skills" ]] || { echo "curate: $repo is not a poteto-skills checkout; pass --repo" >&2; exit 2; }
repo="$(cd "$repo" && pwd)"
cache="${POTETO_CACHE:-$HOME/.cache/poteto-skills}"
log_dir="$repo/logs/curator"
mkdir -p "$log_dir"
exec > >(tee -a "$log_dir/$date_.log") 2>&1

say() { echo "[curate $(date +%H:%M:%S)] $*"; }
die() { say "ERROR: $*"; exit 1; }

say "mode=$mode offline=$offline no_fetch=$nofetch repo=$repo cache=$cache"
up_json="$log_dir/$date_.upstream.json"
proposals="$repo/proposals/$date_.md"
timeout_cmd=()
command -v timeout >/dev/null 2>&1 && timeout_cmd=(timeout "${CURATOR_TIMEOUT:-3600}")

# 1. upstream diff ----------------------------------------------------------------
diff_args=(--repo "$repo" --json)
[[ "$nofetch" == 1 ]] && diff_args+=(--offline)
if "$script_dir/upstream_diff.sh" "${diff_args[@]}" > "$up_json"; then
  say "upstream: $(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["changes"], "change(s),", len(d["changed"]), "changed file(s), head", d["upstream"]["head"][:12])' "$up_json")"
else
  say "upstream_diff failed (exit $?); continuing without upstream changes"
  echo '{}' > "$up_json"
fi

offline_proposals() {
  python3 - "$up_json" "$date_" <<'PY'
import json, sys
up, date = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(up))
except (OSError, ValueError):
    d = {}
ours = {"create-verification-skill": "create-verification-skill", "maintain-verification-skill": "maintain-verification-skill",
        "correct": "correct", "architect": "architect", "sharpen": "sharpen", "in-your-own-words": "sharpen",
        "create-formal-verification-skill": "formal-verification"}
items = []
for c in d.get("changed", []):
    skill = ours.get(c["file"].split("/")[0], "collection")
    items.append((f"Upstream changed: {c['file']}", c["url"], skill,
                  f"Diff research/upstream/{c['file']} against upstream, port any new rule into {'skills/' + skill if skill != 'collection' else 'the matching skill'} "
                  "as a script, lint, or test where it can be checked, and refresh the snapshot file.",
                  "pstack changed this file after the snapshot pinned in research/NOTES.md."))
for n in d.get("new_skills", []):
    items.append((f"New upstream skill: {n['name']}", n["url"], "collection",
                  f"Read pstack skill {n['name']}; if it pushes output up the pyramid, propose a poteto-skills skill with a "
                  "deterministic helper script, otherwise record it in MAPPING.md as not adopted.",
                  "A new pstack skill appeared since the last curator run."))
for m in d.get("missing_upstream", []):
    items.append((f"Upstream moved or removed: {m['file']}", "https://github.com/cursor/plugins/tree/main/pstack", "collection",
                  f"Find where {m['file']} went upstream (renamed or deleted), update research/upstream and MAPPING.md, "
                  "and drop guidance that upstream retracted.", "The snapshot file no longer exists at its upstream path."))
head = (d.get("upstream") or {}).get("head", "")[:12] or "unknown"
print(f"# Curator proposals: {date}\n")
print(f"Generated offline by curate.sh from the upstream diff (no web research). Upstream cursor/plugins @ {head}.\n")
if not items:
    print("No proposals: upstream pstack matches the snapshot.")
for i, (title, url, skill, change, why) in enumerate(items, 1):
    print(f"## {i}. {title}\n\n- Source: {url}\n- Level: prose\n- Skill: {skill}\n- Change: {change}\n- Why: {why}\n")
PY
}

propose() {
  mkdir -p "$repo/proposals"
  if [[ "$offline" == 1 ]]; then
    offline_proposals > "$proposals"
    say "wrote $proposals (offline, from the upstream diff)"
  else
    command -v claude >/dev/null 2>&1 || die "claude CLI not found; install Claude Code or use --offline"
    local prompt
    prompt="$(cat "$skill_dir/references/curator-prompt.md")

Run context (filled in by curate.sh):
- Today is $date_. The collection is $repo. Write exactly one file: proposals/$date_.md. Change nothing else.
- Upstream pstack diff from upstream_diff.sh (JSON): logs/curator/$date_.upstream.json
- Skills in this collection: $(ls "$repo/skills" | tr '\n' ' ')
- Sources already used: research/NOTES.md. Skill-to-source map: MAPPING.md."
    say "propose: claude -p --model ${CURATOR_MODEL:-opus} --effort ${CURATOR_EFFORT:-max}"
    (cd "$repo" && "${timeout_cmd[@]}" claude -p "$prompt" --model "${CURATOR_MODEL:-opus}" --effort "${CURATOR_EFFORT:-max}" \
        --permission-mode acceptEdits --allowedTools "WebSearch WebFetch Read Grep Glob Write" --output-format json) \
      > "$log_dir/$date_.claude-propose.json" || die "claude propose step failed; see $log_dir/$date_.claude-propose.json"
    [[ -f "$proposals" ]] || die "claude did not write $proposals"
  fi
  local check_args=("$proposals" --skills-dir "$repo/skills")
  [[ "$offline" == 0 ]] && check_args+=(--fetch)
  python3 "$script_dir/check_proposals.py" "${check_args[@]}" || die "$proposals fails the acceptance bar; fix or delete it"
}

append_changelog() {  # file date summary sources
  python3 - "$@" <<'PY'
import re, sys
path, date, summary, sources = sys.argv[1:5]
text = open(path, encoding="utf-8").read()
entry = f"- curator {date}: {summary.rstrip('.')}." + (f" Sources: {sources.rstrip('.')}." if sources else "")
m = re.search(r"^## \[Unreleased\][^\n]*\n", text, re.M)
if not m:
    first = re.search(r"^## \[", text, re.M)
    block = "## [Unreleased]\n\n### Changed\n\n" + entry + "\n\n"
    text = text[:first.start()] + block + text[first.start():] if first else text.rstrip() + "\n\n" + block
else:
    nxt = re.search(r"^## \[", text[m.end():], re.M)
    end = m.end() + nxt.start() if nxt else len(text)
    section = text[m.end():end]
    ch = re.search(r"^### Changed[^\n]*\n", section, re.M)
    if ch:
        after = re.search(r"^### ", section[ch.end():], re.M)
        pos = ch.end() + (after.start() if after else len(section[ch.end():]))
        body = section[:pos].rstrip("\n") + "\n" + entry + "\n\n" + section[pos:].lstrip("\n")
    else:
        body = "\n### Changed\n\n" + entry + "\n\n" + section.lstrip("\n")
    text = text[:m.end()] + body + text[end:]
open(path, "w", encoding="utf-8").write(text)
PY
}

apply_change() {
  [[ -f "$proposals" ]] || propose
  python3 "$script_dir/check_proposals.py" "$proposals" --skills-dir "$repo/skills" >/dev/null \
    || die "$proposals fails the acceptance bar; not applying"
  local branch="curator/$date_" wt="$cache/worktrees/curator-$date_-$$"
  if git -C "$repo" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
    die "branch $branch already exists; review it or delete it (git branch -D $branch)"
  fi
  mkdir -p "$cache/worktrees"
  git -C "$repo" worktree add --quiet -b "$branch" "$wt" HEAD || die "git worktree add failed"
  drop() {
    git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
    git -C "$repo" worktree prune
    git -C "$repo" branch -D "$branch" >/dev/null 2>&1 || true
  }
  mkdir -p "$wt/proposals"
  cp "$proposals" "$wt/proposals/$date_.md"
  local summary="" sources=""
  if [[ "$offline" == 1 ]]; then
    local out
    out="$(python3 - "$up_json" "$wt" <<'PY'
import json, shutil, sys
from pathlib import Path
up, wt = sys.argv[1], Path(sys.argv[2])
try:
    d = json.load(open(up))
except (OSError, ValueError):
    d = {}
clone = Path((d.get("upstream") or {}).get("clone", ""))
done, urls = [], []
for c in d.get("changed", []):
    src = clone / c["upstream_path"]
    if src.is_file():
        dst = wt / "research" / "upstream" / c["file"]
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dst)
        done.append(c["file"])
        urls.append(c["url"])
if done:
    print(f"sync research/upstream with pstack ({len(done)} file(s): {', '.join(done)})\t{', '.join(urls)}")
PY
)"
    summary="${out%%$'\t'*}"
    [[ "$out" == *$'\t'* ]] && sources="${out#*$'\t'}"
  else
    command -v claude >/dev/null 2>&1 || { drop; die "claude CLI not found; install Claude Code or use --offline"; }
    local prompt="You are the poteto-skills curator, apply step. The current directory is a fresh git worktree of the collection on branch $branch.
Read proposals/$date_.md and the acceptance bar in skills/curator/references/curator-prompt.md.
Implement at most three proposals that pass the bar, most deterministic first (architecture > types > lint > test > prose).
Rules: edit files only inside this worktree. Do not run git commit or git push; curate.sh commits only after scripts/verify.sh passes.
Keep every SKILL.md frontmatter valid. Scripts stay stdlib Python or bash, executable, with --help. Cite each source URL in the
skill's Sources footer and in MAPPING.md. When done, write one line describing the change to .curator-summary, or exactly
'nothing to apply' if no proposal passes the bar."
    say "apply: claude -p --model ${CURATOR_MODEL:-opus} --effort ${CURATOR_EFFORT:-max} in $wt"
    (cd "$wt" && "${timeout_cmd[@]}" claude -p "$prompt" --model "${CURATOR_MODEL:-opus}" --effort "${CURATOR_EFFORT:-max}" \
        --permission-mode acceptEdits --allowedTools "Read Grep Glob Edit Write WebFetch Bash(python3 *) Bash(bash *) Bash(chmod *)" \
        --output-format json) > "$log_dir/$date_.claude-apply.json" || { drop; die "claude apply step failed; see $log_dir/$date_.claude-apply.json"; }
    summary="$(head -n 1 "$wt/.curator-summary" 2>/dev/null || true)"
    rm -f "$wt/.curator-summary"
    sources="see proposals/$date_.md"
    [[ "$summary" == "nothing to apply" ]] && summary=""
  fi
  if [[ -z "$summary" || -z "$(git -C "$wt" status --porcelain -- . ':!proposals')" ]]; then
    say "nothing to apply; removing $branch"
    drop
    return 0
  fi
  append_changelog "$wt/CHANGELOG.md" "$date_" "$summary" "$sources"
  local verify_cmd="${CURATOR_VERIFY_CMD:-bash scripts/verify.sh --run-examples}"
  say "verify: $verify_cmd"
  if ! (cd "$wt" && bash -c "$verify_cmd") > "$log_dir/$date_.verify.log" 2>&1; then
    git -C "$wt" add -A >/dev/null 2>&1 || true
    git -C "$wt" diff --cached > "$log_dir/$date_.failed.patch" 2>/dev/null || true
    drop
    die "verify failed (log: $log_dir/$date_.verify.log); nothing committed; patch kept at $log_dir/$date_.failed.patch"
  fi
  git -C "$wt" add -A
  git -C "$wt" -c user.name="${CURATOR_GIT_NAME:-poteto-curator}" -c user.email="${CURATOR_GIT_EMAIL:-curator@localhost}" \
    commit --quiet -m "curator: $date_ $summary" -m "Proposals: proposals/$date_.md
Verified by: $verify_cmd"
  local sha
  sha="$(git -C "$wt" rev-parse --short HEAD)"
  git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
  git -C "$repo" worktree prune
  say "committed $sha on $branch (local only, never pushed). Review: git -C $repo log -p $branch"
}

case "$mode" in
  propose) propose ;;
  apply) apply_change ;;
esac
say "done"
#!/usr/bin/env python3
"""Check a curator proposals file against the acceptance bar.

  check_proposals.py proposals/YYYY-MM-DD.md [--fetch] [--skills-dir DIR] [--json]

Each proposal is an H2 section (`## 1. Title`) with these bullet fields:
  - Source: <http(s) URL the curator actually fetched>   (one or more URLs)
  - Level: architecture | types | lint | test | verification | ci | prose | review
  - Skill: <existing skill name> | new:<name> | collection
  - Change: <the concrete change, preferably a script, lint, test, or type>
  - Why: <one sentence>                                   (optional)
A file with no H2 sections is valid: nothing to propose.

--fetch re-requests every source URL with curl (the curator is the one skill allowed to use
the network). 2xx/3xx pass; 401/403/429 count as reachable-but-blocked (a warning); anything
else fails. Exit 0 valid, 1 invalid, 2 usage error.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

LEVELS = ["architecture", "types", "lint", "test", "verification", "ci", "prose", "review"]
ALIASES = {"static-analysis": "lint", "static analysis": "lint", "docs": "prose", "doc": "prose",
           "codebase": "architecture", "type": "types", "tests": "test", "formal": "verification"}
DETERMINISTIC = {"architecture", "types", "lint", "test", "verification", "ci"}
URL_RE = re.compile(r"https?://[^\s<>)\]`'\"]+")


def parse(text: str) -> list[dict]:
    items = []
    parts = re.split(r"^##\s+", text, flags=re.M)
    for chunk in parts[1:]:
        title, _, body = chunk.partition("\n")
        fields: dict[str, str] = {}
        for m in re.finditer(r"^\s*[-*]\s*\**([A-Za-z][\w ]*?)\**\s*:\s*(.*)$", body, re.M):
            fields.setdefault(m.group(1).strip().lower(), m.group(2).strip())
        items.append({"title": title.strip(), "fields": fields, "urls": URL_RE.findall(fields.get("source", ""))})
    return items


def fetch_status(url: str) -> int:
    try:
        r = subprocess.run(["curl", "-sS", "-L", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "20",
                            "-r", "0-2047", "-A", "poteto-skills-curator/0.1", url],
                           capture_output=True, text=True, timeout=30)
        return int(r.stdout.strip() or 0)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 0


def check(path: Path, skills_dir: Path | None, do_fetch: bool) -> dict:
    items = parse(path.read_text(encoding="utf-8", errors="replace"))
    skills = {p.name for p in skills_dir.iterdir() if (p / "SKILL.md").is_file()} if skills_dir and skills_dir.is_dir() else None
    problems, warnings = [], []
    for n, it in enumerate(items, 1):
        f, where = it["fields"], f"#{n} \"{it['title'][:60]}\""
        if not it["urls"]:
            problems.append(f"{where}: no Source URL (every proposal needs a real, fetched URL)")
        level = ALIASES.get(f.get("level", "").lower(), f.get("level", "").lower())
        if level not in LEVELS:
            problems.append(f"{where}: Level must be one of {', '.join(LEVELS)}, got {f.get('level')!r}")
        it["level"] = level
        if len(f.get("change", "").split()) < 4:
            problems.append(f"{where}: Change must say concretely what to change")
        skill = f.get("skill", "")
        if not skill:
            problems.append(f"{where}: Skill missing (an existing skill, new:<name>, or collection)")
        elif skills is not None and skill not in skills and skill != "collection" and not skill.startswith("new:"):
            problems.append(f"{where}: Skill {skill!r} is not a skill in {skills_dir}")
        if do_fetch:
            it["fetch"] = {}
            for u in it["urls"]:
                code = fetch_status(u)
                it["fetch"][u] = code
                if code in (401, 403, 429):
                    warnings.append(f"{where}: {u} answered {code} (exists, blocks bots)")
                elif not 200 <= code < 400:
                    problems.append(f"{where}: {u} is unreachable (HTTP {code or 'error'})")
    det = sum(1 for it in items if it.get("level") in DETERMINISTIC)
    return {"file": str(path), "items": len(items), "deterministic": det, "prose_or_review": len(items) - det,
            "problems": problems, "warnings": warnings, "ok": not problems,
            "proposals": [{"title": it["title"], "level": it.get("level"), "skill": it["fields"].get("skill"),
                           "urls": it["urls"], "fetch": it.get("fetch")} for it in items]}


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="check_proposals.py",
        description="Validate a curator proposals file: every proposal has a source URL, a pyramid level, a target "
                    "skill, and a concrete change. --fetch re-checks that each URL is reachable.",
        epilog="examples:\n  check_proposals.py proposals/2026-10-19.md\n"
               "  check_proposals.py proposals/2026-10-19.md --fetch --skills-dir skills",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("proposals", type=Path, help="proposals/YYYY-MM-DD.md")
    ap.add_argument("--fetch", action="store_true", help="re-request each source URL with curl")
    ap.add_argument("--skills-dir", type=Path, help="validate Skill: names against this skills/ dir")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args(argv)
    if not args.proposals.is_file():
        print(f"check_proposals: {args.proposals} not found", file=sys.stderr)
        return 2
    res = check(args.proposals, args.skills_dir, args.fetch)
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        for p in res["problems"]:
            print(f"FAIL  {p}")
        for w in res["warnings"]:
            print(f"warn  {w}")
        print(f"check_proposals: {'PASS' if res['ok'] else 'FAIL'}: {res['items']} proposal(s), "
              f"{res['deterministic']} above prose, {res['prose_or_review']} prose/review ({args.proposals})")
    return 0 if res["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env bash
# Install the poteto-skills collection for Claude Code and/or Cursor.
# Only ever creates, updates, or removes <root>/<skill> entries for this collection's own skills.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: install.sh [--copy] [--target claude|cursor|both] [--project DIR] [--uninstall] [--force] [--dry-run]

Installs every skills/<name> of this checkout into:
  ~/.claude/skills/<name> and ~/.cursor/skills/<name>        (default)
  DIR/.claude/skills/<name> and DIR/.cursor/skills/<name>    (--project DIR)

  --copy        copy the files instead of symlinking (default: symlink, so `git pull` updates them)
  --target T    claude, cursor, or both (default: both)
  --project DIR install into a project instead of $HOME
  --uninstall   remove only entries this script installed (our symlinks, or copies with its marker file)
  --force       replace an existing entry with the same name that this script did not install
  --dry-run     print what would happen; change nothing

Other entries in the skills dirs (for example ~/.claude/skills/synced) are never touched.
Skills that share helpers (feedback-to-architecture uses correct; maintain-verification-skill uses
create-verification-skill) are always installed together.
exit: 0 done, 1 an entry was skipped because of a conflict, 2 usage error
EOF
}

mode=link target=both project="" uninstall=0 force=0 dry=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --copy) mode=copy; shift ;;
    --target) target="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
    --project) project="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
    --uninstall) uninstall=1; shift ;;
    --force) force=1; shift ;;
    --dry-run) dry=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "install.sh: unknown option $1" >&2; usage >&2; exit 2 ;;
  esac
done
case "$target" in claude|cursor|both) ;; *) echo "install.sh: --target must be claude, cursor, or both" >&2; exit 2 ;; esac

src_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/skills"
[[ -d "$src_root" ]] || { echo "install.sh: $src_root not found" >&2; exit 2; }
if [[ -n "$project" ]]; then
  [[ -d "$project" ]] || { echo "install.sh: --project $project is not a directory" >&2; exit 2; }
  base="$(cd "$project" && pwd -P)"
else
  base="${HOME:?HOME is not set}"
fi
roots=()
[[ "$target" == claude || "$target" == both ]] && roots+=("$base/.claude/skills")
[[ "$target" == cursor || "$target" == both ]] && roots+=("$base/.cursor/skills")

marker=".poteto-skills-install"
skills=()
for d in "$src_root"/*/; do
  if [[ -f "$d/SKILL.md" ]]; then skills+=("$(basename "$d")"); fi
done
[[ ${#skills[@]} -gt 0 ]] || { echo "install.sh: no skills found in $src_root" >&2; exit 2; }

run() {
  if [[ "$dry" == 1 ]]; then echo "[dry-run] $*"; else "$@"; fi
}

is_ours() {  # an entry we installed: a symlink into src_root, or a copy carrying our marker
  local dest="$1"
  if [[ -L "$dest" ]]; then
    local t
    t="$(readlink "$dest")"
    [[ "$t" == "$src_root/"* ]]
  else
    [[ -f "$dest/$marker" ]]
  fi
}

conflicts=0 changed=0 made_root=""
for root in "${roots[@]}"; do
  for name in "${skills[@]}"; do
    src="$src_root/$name"
    dest="$root/$name"
    if [[ "$uninstall" == 1 ]]; then
      if [[ -e "$dest" || -L "$dest" ]]; then
        if is_ours "$dest"; then
          run rm -rf "$dest"; echo "removed $dest"; changed=$((changed + 1))
        else
          echo "skip $dest: not installed by poteto-skills (left alone)"
        fi
      fi
      continue
    fi
    if [[ -L "$dest" && "$mode" == link && "$(readlink "$dest")" == "$src" ]]; then
      echo "ok   $dest -> $src"
      continue
    fi
    if [[ -e "$dest" || -L "$dest" ]]; then
      if is_ours "$dest" || [[ "$force" == 1 ]]; then
        run rm -rf "$dest"
      else
        echo "skip $dest: exists and was not installed by poteto-skills (use --force to replace it)"
        conflicts=$((conflicts + 1))
        continue
      fi
    fi
    if [[ ! -d "$root" && "$made_root" != "$root" ]]; then run mkdir -p "$root"; made_root="$root"; fi
    if [[ "$mode" == link ]]; then
      run ln -s "$src" "$dest"
      echo "link $dest -> $src"
    else
      run cp -R "$src" "$dest"
      if [[ "$dry" == 1 ]]; then
        echo "[dry-run] write $dest/$marker"
      else
        printf 'installed-by: poteto-skills install.sh\nsource: %s\ndate: %s\n' "$src" "$(date -u +%FT%TZ)" > "$dest/$marker"
        find "$dest" -name '__pycache__' -type d -prune -exec rm -rf {} +
      fi
      echo "copy $dest <- $src"
    fi
    changed=$((changed + 1))
  done
done

action=$([[ "$uninstall" == 1 ]] && echo "uninstall" || echo "install")
echo "install.sh: $action done: ${#skills[@]} skill(s), ${#roots[@]} target dir(s), $changed change(s), $conflicts conflict(s)$([[ "$dry" == 1 ]] && echo ' (dry run, nothing changed)')"
[[ "$conflicts" == 0 ]]
__pycache__/
*.pyc
artifacts/
logs/curator/
# Changelog

All notable changes to this project are documented in this file. The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/), and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).

## [Unreleased]

## [0.1.0] - 2026-10-19

### Added

- `create-verification-skill`: `scan_repo.py` (Python AST, Node, Go, and Make heuristics for routes, CLI subcommands, ports, build/test commands), `scaffold.py` (writes `verify-<app>` with SKILL.md, a feature map using the four H2s, and a `control.sh` harness: launch, doctor, drive, evidence, cleanup, status, prove), and `check_verify_skill.py` (contract gate).
- `maintain-verification-skill`: `drift_check.py`, covering index hygiene, the H2 contract, and routes and commands missing from or dead in the map.
- `correct`: `mine_mistakes.py` (mistake classes from reverts, fix commits and their diffs, review comments, chat notes, and workaround comments), `patlint.py` (rule-file lint with a ratchet baseline, expiring inline exceptions, and `--rev` to replay history), and `rule_table.py` (flags rules enforced only by prose).
- `feedback-to-architecture`: `collect_feedback.py` (normalized `feedback.json`) and `plan.py` (`REFACTOR_PLAN.md`, `lint-rules.json`, and `plan.json`, with each rule replayed against git history).
- `architect`: `sketch_check.py`, plus a sketch template and a design red-flags list.
- `sharpen`: `brief.py` (writes and checks the brief; covers in-your-own-words).
- `formal-verification`: `bounded_check.py` (stdlib explicit-state model checker with counterexample traces, deadlock detection, `--mutants`, and `--expect-violation`), `tla_available.sh`, and an example lost-update model.
- `curator`: `upstream_diff.sh`, `curate.sh` (daily propose, weekly apply on a local `curator/<date>` worktree branch, committed only after `scripts/verify.sh` passes, never pushed), `check_proposals.py`, and `references/curator-prompt.md`.
- `install.sh` with symlink and `--copy` modes, `--target claude|cursor|both`, `--project`, `--uninstall`, `--force`, and `--dry-run`.
- README.md, MAPPING.md, and this changelog.

